using Nix

clause
  shape: Flake
  description: "Clause development environment"
  inputs
    nixpkgs
      from: "github:NixOS/nixpkgs/nixos-unstable"
    rust-overlay
      from: "github:oxalica/rust-overlay"
      follows: nixpkgs
  development shell
    clause-shell
      system: x86_64-linux
      imports: nixpkgs
      overlays
        rust-overlay
      includes
        rust
          from: "./rust-toolchain.toml"
