#lang beagle/js

(ns jump-arena-shell.shell)

(defrecord ArenaVec3
  [x Float
   y Float
   z Float])

(defrecord ArenaPlayerFrame
  [position ArenaVec3
   velocity ArenaVec3
   yaw Float
   grounded Bool])

(defrecord ArenaPlatformFrame
  [position ArenaVec3
   size ArenaVec3])

(defrecord ArenaCollectibleFrame
  [position ArenaVec3
   state String])

(defrecord ArenaWorldFrame
  [platforms (Vec ArenaPlatformFrame)
   collectibles (Vec ArenaCollectibleFrame)])

(defrecord ArenaFrame
  [player ArenaPlayerFrame
   world ArenaWorldFrame])

(defrecord ArenaPointerEvent
  [clientX Float
   clientY Float
   pointerId Int
   button Int
   buttons Int])

(defn numeric-value [value Any] Float
  (.parseFloat Number (str value)))

(defn require-frozen-frame [frame ArenaFrame] ArenaFrame
  (if (and (.isFrozen Object frame)
           (.isFrozen Object (.-player frame))
           (.isFrozen Object (.-position (.-player frame)))
           (.isFrozen Object (.-velocity (.-player frame)))
           (.isFrozen Object (.-world frame))
           (.isFrozen Object (.-platforms (.-world frame)))
           (.isFrozen Object (.-collectibles (.-world frame)))
           (.every (.-platforms (.-world frame))
                   (fn [platform Any] Bool
                     (and (.isFrozen Object platform)
                          (.isFrozen Object (.-position platform))
                          (.isFrozen Object (.-size platform)))))
           (.every (.-collectibles (.-world frame))
                   (fn [collectible Any] Bool
                     (and (.isFrozen Object collectible)
                          (.isFrozen Object (.-position collectible))
                          (= (js/typeof (.-state collectible)) "string")))))
    frame
    (throw (new Error "renderFrame requires a deeply frozen arena frame"))))

(defn projected-symbol-color [value String] Int
  (loop [index Int 0
         hash Int 216613]
    (if (= index (.-length value))
      (+ 2105376 (rem hash 13619151))
      (let [code Int (.charCodeAt value index)]
        (recur (inc index)
               (rem (+ (* hash 33) code) 13619151))))))

(defn keyboard-input
  [phase String
   event Any] Any
  (.freeze Object
           {:kind "keyboard"
            :phase phase
            :code (.-code event)
            :repeat (.-repeat event)}))

(defn pointer-input
  [phase String
   event ArenaPointerEvent
   canvas JsCanvas] Any
  (let [rect JsDomRect (.getBoundingClientRect canvas)
        width Float (.max Math 1.0 (.-width rect))
        height Float (.max Math 1.0 (.-height rect))
        x Float (- (/ (* (- (.-clientX event) (.-left rect)) 2.0) width) 1.0)
        y Float (- 1.0 (/ (* (- (.-clientY event) (.-top rect)) 2.0) height))]
    (.freeze Object
             {:kind "pointer"
              :phase phase
              :pointerId (.-pointerId event)
              :button (.-button event)
              :buttons (.-buttons event)
              :x x
              :y y})))

(js/export
  (defn create-jump-arena-shell!
    [mount Any
     browser Any
     three Any
     emit-input (Fn [Any] Any)] Any
    (let [scene-ctor Any (.-Scene three)
          color-ctor Any (.-Color three)
          camera-ctor Any (.-PerspectiveCamera three)
          renderer-ctor Any (.-WebGLRenderer three)
          hemisphere-light-ctor Any (.-HemisphereLight three)
          directional-light-ctor Any (.-DirectionalLight three)
          box-geometry-ctor Any (.-BoxGeometry three)
          material-ctor Any (.-MeshStandardMaterial three)
          mesh-ctor Any (.-Mesh three)
          group-ctor Any (.-Group three)
          scene Any (new scene-ctor)
          camera Any (new camera-ctor 52.0 1.0 0.1 160.0)
          renderer Any (new renderer-ctor {:antialias true})
          canvas Any (.-domElement renderer)
          player-geometry Any (new box-geometry-ctor 0.8 1.8 0.8)
          player-material Any (new material-ctor {:color 4697343 :roughness 0.42})
          platform-geometry Any (new box-geometry-ctor 1.0 1.0 1.0)
          platform-material Any (new material-ctor {:color 2967637 :roughness 0.78})
          collectible-geometry Any (new box-geometry-ctor 0.45 0.45 0.45)
          player-mesh Any (new mesh-ctor player-geometry player-material)
          platform-group Any (new group-ctor)
          collectible-group Any (new group-ctor)
          disposed Any (atom false)
          canvas-focused Any (atom false)
          has-frame Any (atom false)
          platform-meshes Any (atom [])
          collectible-meshes Any (atom [])
          active-pointers Any (new Set)]
      (set! (.-background scene) (new color-ctor 1116716))
      (.add scene (new hemisphere-light-ctor 10144255 1250849 2.4))
      (let [sun Any (new directional-light-ctor 16777215 3.2)]
        (.set (.-position sun) 6.0 12.0 8.0)
        (.add scene sun))
      (.add scene platform-group)
      (.add scene collectible-group)
      (.add scene player-mesh)
      (.setAttribute canvas "tabindex" "0")
      (.appendChild mount canvas)

      (let [resize (fn [] Any
                     (when (not @disposed)
                       (let [width Float (.max Math 1.0 (numeric-value (.-clientWidth mount)))
                             height Float (.max Math 1.0 (numeric-value (.-clientHeight mount)))
                             ratio Float (.min Math 2.0 (numeric-value (.-devicePixelRatio browser)))]
                         (.setPixelRatio renderer ratio)
                         (.setSize renderer width height false)
                         (set! (.-aspect camera) (/ width height))
                         (.updateProjectionMatrix camera)
                         (when @has-frame
                           (.render renderer scene camera)))))
            focus-canvas (fn [] Any
                           (when (not @disposed)
                             (reset! canvas-focused true)))
            blur-canvas (fn [] Any
                          (when (not @disposed)
                            (reset! canvas-focused false)))
            key-down (fn [event Any] Any
                       (when (and (not @disposed) @canvas-focused)
                         (emit-input (keyboard-input "down" event))))
            key-up (fn [event Any] Any
                     (when (and (not @disposed) @canvas-focused)
                       (emit-input (keyboard-input "up" event))))
            pointer-event (fn
                            [phase String
                             event Any] Any
                            (emit-input (pointer-input phase event canvas)))
            pointer-down (fn [event ArenaPointerEvent] Any
                           (when (not @disposed)
                             (.focus canvas {:preventScroll true})
                             (.add active-pointers (.-pointerId event))
                             (.setPointerCapture canvas (.-pointerId event))
                             (pointer-event "down" event)))
            pointer-move (fn [event ArenaPointerEvent] Any
                           (when (not @disposed)
                             (pointer-event "move" event)))
            pointer-up (fn [event ArenaPointerEvent] Any
                         (when (not @disposed)
                           (when (.hasPointerCapture canvas (.-pointerId event))
                             (.releasePointerCapture canvas (.-pointerId event)))
                           (.delete active-pointers (.-pointerId event))
                           (pointer-event "up" event)))
            pointer-cancel (fn [event ArenaPointerEvent] Any
                             (when (not @disposed)
                               (when (.hasPointerCapture canvas (.-pointerId event))
                                 (.releasePointerCapture canvas (.-pointerId event)))
                               (.delete active-pointers (.-pointerId event))
                               (pointer-event "cancel" event)))
            clear-collectibles (fn [] Any
                                 (doseq [mesh Any @collectible-meshes]
                                   (.remove collectible-group mesh)
                                   (.dispose (.-material mesh)))
                                 (reset! collectible-meshes []))
            render-frame (fn [incoming ArenaFrame] ArenaFrame
                           (if @disposed
                             (throw (new Error "jump arena shell is disposed"))
                             (let [frame ArenaFrame (require-frozen-frame incoming)
                                   player ArenaPlayerFrame (.-player frame)
                                   position ArenaVec3 (.-position player)
                                   yaw Float (.-yaw player)]
                               (.set (.-position player-mesh)
                                     (.-x position) (.-y position) (.-z position))
                               (set! (.-y (.-rotation player-mesh)) yaw)
                               (doseq [mesh Any @platform-meshes]
                                 (.remove platform-group mesh))
                               (reset! platform-meshes [])
                               (doseq [platform ArenaPlatformFrame (.-platforms (.-world frame))]
                                 (let [mesh Any (new mesh-ctor platform-geometry platform-material)
                                       platform-position ArenaVec3 (.-position platform)
                                       size ArenaVec3 (.-size platform)]
                                   (.set (.-position mesh)
                                         (.-x platform-position)
                                         (.-y platform-position)
                                         (.-z platform-position))
                                   (.set (.-scale mesh)
                                         (.-x size) (.-y size) (.-z size))
                                   (.add platform-group mesh)
                                   (.push @platform-meshes mesh)))
                               (clear-collectibles)
                               (doseq [collectible ArenaCollectibleFrame
                                        (.-collectibles (.-world frame))]
                                 (let [material Any (new material-ctor
                                            {:color (projected-symbol-color
                                                     (.-state collectible))
                                             :roughness 0.3})
                                       mesh Any (new mesh-ctor collectible-geometry material)
                                       collectible-position ArenaVec3 (.-position collectible)]
                                   (.set (.-position mesh)
                                         (.-x collectible-position)
                                         (.-y collectible-position)
                                         (.-z collectible-position))
                                   (.add collectible-group mesh)
                                   (.push @collectible-meshes mesh)))
                               (.set (.-position camera)
                                     (+ (.-x position) (* (.sin Math yaw) 7.5))
                                     (+ (.-y position) 4.8)
                                     (+ (.-z position) (* (.cos Math yaw) 7.5)))
                               (.lookAt camera
                                        (.-x position)
                                        (+ (.-y position) 1.0)
                                        (.-z position))
                               (.render renderer scene camera)
                               (reset! has-frame true)
                               frame)))
            dispose (fn [] Any
                      (when (not @disposed)
                        (reset! disposed true)
                        (reset! canvas-focused false)
                        (reset! has-frame false)
                        (.removeEventListener browser "resize" resize)
                        (.removeEventListener canvas "focus" focus-canvas)
                        (.removeEventListener canvas "blur" blur-canvas)
                        (.removeEventListener canvas "keydown" key-down)
                        (.removeEventListener canvas "keyup" key-up)
                        (.removeEventListener canvas "pointerdown" pointer-down)
                        (.removeEventListener canvas "pointermove" pointer-move)
                        (.removeEventListener canvas "pointerup" pointer-up)
                        (.removeEventListener canvas "pointercancel" pointer-cancel)
                        (.forEach active-pointers
                                  (fn [pointer-id Any] Any
                                    (when (.hasPointerCapture canvas pointer-id)
                                      (.releasePointerCapture canvas pointer-id))))
                        (.clear active-pointers)
                        (reset! platform-meshes [])
                        (.clear platform-group)
                        (clear-collectibles)
                        (.clear collectible-group)
                        (.dispose player-geometry)
                        (.dispose player-material)
                        (.dispose platform-geometry)
                        (.dispose platform-material)
                        (.dispose collectible-geometry)
                        (.clear scene)
                        (.dispose renderer)
                        (.forceContextLoss renderer)
                        (.remove canvas)))]
        (.addEventListener browser "resize" resize)
        (.addEventListener canvas "focus" focus-canvas)
        (.addEventListener canvas "blur" blur-canvas)
        (.addEventListener canvas "keydown" key-down)
        (.addEventListener canvas "keyup" key-up)
        (.addEventListener canvas "pointerdown" pointer-down)
        (.addEventListener canvas "pointermove" pointer-move)
        (.addEventListener canvas "pointerup" pointer-up)
        (.addEventListener canvas "pointercancel" pointer-cancel)
        (resize)
        (.freeze Object
                 {:canvas canvas
                  :renderFrame render-frame
                  :dispose dispose})))))
