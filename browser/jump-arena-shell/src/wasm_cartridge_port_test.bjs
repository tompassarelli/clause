#lang beagle/js

(ns jump-arena-shell.wasm-cartridge-port-test
  (:require [jump-arena-shell.wasm-cartridge-port :as wasm]
            [jump-arena-shell.workbench :as workbench]))

(require '["bun:test" :as test])
(require
 '["#clause-runtime-wasm"
   :refer [clause_session_v1_command
           clause_session_v1_event_byte
           clause_session_v1_event_len
           clause_session_v1_io_reset
           clause_session_v1_open
           clause_session_v1_request_push
           initSync
           InitOutput
           SyncInitInput]])

(declare-extern [Bun require] Any)

(defn policy [] workbench/WorkbenchPolicy
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (workbench/->WorkbenchPolicy
     8 8 32 128 512
     (workbench/->WorkbenchSequenceLimits
     maximum maximum maximum maximum maximum))))

(defn arena-policy [] workbench/WorkbenchPolicy
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (workbench/->WorkbenchPolicy
     8 8 32 wasm/cse1-projected-term-max-properties
     wasm/cse1-projected-term-json-max-source-units
     (workbench/->WorkbenchSequenceLimits
      maximum maximum maximum maximum maximum))))

(defn identity [tag Int] Any
  (let [bytes Any (new Array 32)]
    (.fill bytes 0)
    (.splice bytes 0 1 tag)
    (.splice bytes 31 1 tag)
    bytes))

(defn cwo1 [values Any] Any
  (let [bytes Any [67 87 79 49]]
    (.push bytes (identity 11))
    (.push bytes (identity 22))
    (let [flat Any (.flat bytes)
          count Int (.-length values)]
      (.push flat (rem count 256))
      (.push flat (quot count 256))
      (doseq [value Any values]
        (if (= (.-kind value) "boolean")
          (do
            (.push flat 1)
            (.push flat (if (.-value value) 1 0)))
          (let [packed Any (new ArrayBuffer 8)
                view Any (new DataView packed)
                octets Any (new Uint8Array packed)]
            (.setFloat64 view 0 (.-value value) true)
            (.push flat 0)
            (doseq [octet Int octets]
              (.push flat octet)))))
      flat)))

(defn module-for!
  [events Any
   requests Any] Any
  (let [request Any (atom [])
        current Any (atom [])
        next-event! Any (fn [] Any
                          (do
                            (.push requests (.slice @request))
                            (reset! current (.shift events))
                            0))]
    {:clause_session_v1_io_reset (fn [] Any (reset! request []))
     :clause_session_v1_request_push (fn [byte Int] Int
                                       (do (.push @request byte) 0))
     :clause_session_v1_open next-event!
     :clause_session_v1_command next-event!
     :clause_session_v1_event_len (fn [] Int (.-length @current))
     :clause_session_v1_event_byte (fn [index Int] Int (nth @current index))}))

(defn append-u32!
  [bytes Any
   value Int] Any
  (doseq [divisor Int [1 256 65536 16777216]]
    (.push bytes (rem (quot value divisor) 256))))

(defn append-u64!
  [bytes Any
   value Int] Any
  (do (append-u32! bytes value) (append-u32! bytes 0)))

(defn append-blob!
  [bytes Any
   value Any] Any
  (do
    (append-u32! bytes (.-length value))
    (doseq [byte Int value] (.push bytes byte))))

(defn allocation-epoch! [] Any
  (let [bytes Any (new Array 304)]
    (.fill bytes 0)
    (.splice bytes 0 4 82 65 69 49)
    bytes))

(defn minimal-cwr1! [] Any
  (let [bytes Any [67 87 82 49]]
    (append-blob! bytes [1])
    (append-u32! bytes 1)
    (append-blob! bytes [8])
    (append-blob! bytes (allocation-epoch!))
    (doseq [tag Int [1 2 3 4 5 6 7 8 9]]
      (doseq [byte Int (identity tag)] (.push bytes byte)))
    (append-blob! bytes [9])
    (doseq [byte Int (identity 10)] (.push bytes byte))
    (append-blob! bytes [10])
    (doseq [byte Int (identity 11)] (.push bytes byte))
    (append-blob! bytes [11])
    (append-u64! bytes 100)
    (.push bytes 2 0)
    (append-blob! bytes [1])
    (append-blob! bytes [2])
    (.push bytes 0 0)
    bytes))

(defn cse-header!
  [sequence Int
   tag Int] Any
  (let [bytes Any [67 83 69 49]]
    (append-u32! bytes 0)
    (append-u32! bytes 1)
    (append-u64! bytes sequence)
    (.push bytes tag)
    bytes))

(defn put-identities!
  [bytes Any
   tags Any] Any
  (doseq [tag Int tags]
    (doseq [byte Int (identity tag)] (.push bytes byte))))

(defn opened-event! [] Any
  (let [bytes Any (cse-header! 0 1)]
    (put-identities! bytes [21 3 22 23 24])
    (append-u32! bytes 1)
    (append-blob! bytes (allocation-epoch!))
    bytes))

(defn input-event! [] Any
  (let [bytes Any (cse-header! 1 2)]
    (put-identities! bytes [31 23 24 32 33])
    (append-u32! bytes 1)
    bytes))

(defn candidate-event! [] Any
  (let [bytes Any (cse-header! 2 3)]
    (put-identities! bytes [34 35 22 23 24])
    (append-u32! bytes 1)
    bytes))

(defn issuance-event! [] Any
  (let [bytes Any (cse-header! 3 4)]
    (put-identities! bytes [40 21 3 22 35])
    (append-u32! bytes 1)
    bytes))

(defn admission-event! [] Any
  (let [bytes Any (cse-header! 4 5)]
    (put-identities! bytes [22 36 37 38 3])
    (append-u32! bytes 2)
    (.push bytes 1)
    (put-identities! bytes [39])
    (append-blob! bytes [40 41 42])
    bytes))

(defn disposed-event! [] Any (cse-header! 5 6))

(defn throws?! [action (Fn [] Any)] Bool
  (try
    (do (action) false)
    (catch Error _error true)))

(defn json-string [value Any] String
  (let [encoded Any (.stringify JSON value)]
    (if (= (js/typeof encoded) "string")
      encoded
      (throw (new Error "test value is not JSON-encodable")))))

(defn initialize-real-session-module [module ArrayBuffer] Any
  (let [input SyncInitInput module
        _initialized InitOutput (initSync input)]
    (.freeze
     Object
     {:clause_session_v1_io_reset
      (fn [] Nil (clause_session_v1_io_reset))
      :clause_session_v1_request_push
      (fn [byte Int] Float (clause_session_v1_request_push byte))
      :clause_session_v1_open
      (fn [] Float (clause_session_v1_open))
      :clause_session_v1_command
      (fn [] Float (clause_session_v1_command))
      :clause_session_v1_event_len
      (fn [] Float (clause_session_v1_event_len))
      :clause_session_v1_event_byte
      (fn [index Int] Float (clause_session_v1_event_byte index))})))

(defn key-configuration
  [input-sequence Int
   revision Int
   code String] workbench/InputConfiguration
  (workbench/->InputConfiguration
   revision
   [(workbench/->InputObservation
     input-sequence
     (workbench/create-workbench-envelope
      (policy)
      (json-string [(json-string {:kind "keyboard"
                                  :code code
                                  :phase "down"
                                  :repeat false})])))]))

(defn process-configuration
  [input-sequence Int
   revision Int
   ordinal Int] workbench/InputConfiguration
  (workbench/->InputConfiguration
   revision
   [(workbench/->InputObservation
     input-sequence
     (workbench/create-workbench-envelope
      (policy)
      (json-string [(json-string {:kind "process-occurrence"
                                  :ordinal ordinal})])))]))

(defn admit-real-collect!
  [port workbench/CartridgePort
   request-bytes Any
   expected-score Float] Float
  (let [request wasm/ExactProcessRequest
        (wasm/->ExactProcessRequest (wasm/decode-cwr1-hex request-bytes))
        accepted Any (atom nil)
        started Any (atom nil)
        candidate Any (atom nil)
        admitted Any (atom nil)]
    ((.-acceptPackage port) request
     (fn [result Any] Any (reset! accepted result)))
    ((.-startSession port) (.-acceptedPackage @accepted) 1
     (fn [result Any] Any (reset! started result)))
    ((.-runCandidate port)
     (.-session @started)
     (workbench/->FixedTick 16)
     (process-configuration 1 1 0)
     (fn [result Any] Any (reset! candidate result)))
    (.toBe (test/expect (json-string (.-frame @started))) "[]")
    (.toBe (test/expect (json-string (.-base (.-candidate @candidate))))
           (json-string (.-revision @started)))
    ((.-requestAdmission port)
     (.-session @started)
     (.-candidate @candidate)
     (fn [result Any] Any (reset! admitted result)))
    (.toBe
     (test/expect
      (if (not= (json-string (.-revision @admitted))
                (json-string (.-revision @started)))
        "true"
        "false"))
     "true")
    (let [frame Any (wasm/decode-projected-term-frame (.-frame @admitted))
          score Float (.-score (.-player frame))]
      (.toBe (test/expect (str score)) (str expected-score))
      ((.-disposeSession port) (.-session @started))
      score)))

(test/test
 "one persistent session sequences physical input candidate issuance Admission and disposal"
 (fn [] Nil
   (let [requests Any []
         port workbench/CartridgePort (wasm/create-wasm-cartridge-port
                                       (module-for! [(opened-event!)
                                                     (input-event!)
                                                     (candidate-event!)
                                                     (issuance-event!)
                                                     (admission-event!)
                                                     (disposed-event!)]
                                                   requests)
                                       (policy))
         request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
                                           (minimal-cwr1!))
         accepted Any (atom nil)
         started Any (atom nil)
         candidate Any (atom nil)
         admitted Any (atom nil)]
     ((.-acceptPackage port) request (fn [result Any] Any (reset! accepted result)))
     ((.-startSession port) (.-acceptedPackage @accepted) 1
      (fn [result Any] Any (reset! started result)))
     ((.-runCandidate port)
      (.-session @started)
      (workbench/->FixedTick 16)
      (workbench/->InputConfiguration
       1
       [(workbench/->InputObservation
         1
         (workbench/create-workbench-envelope
          (policy)
          (json-string [(json-string {:kind "keyboard"
                                      :code "KeyD"
                                      :phase "down"
                                      :repeat false})])))])
      (fn [result Any] Any (reset! candidate result)))
     (.toBe (test/expect (str (.-length requests))) "3")
     (let [open-request Any (nth requests 0)
           open-length Int (.-length open-request)
           allocation-tag Int (- open-length 17)]
       (.toBe (test/expect (json-string (.slice open-request 0 4)))
              "[67,87,83,49]")
       (.toBe (test/expect (json-string (.slice open-request 13 18)))
              "[1,0,0,0,8]")
       (.toBe (test/expect (str (nth open-request allocation-tag))) "0")
       (.toBe (test/expect
               (json-string (.slice open-request
                                    (inc allocation-tag)
                                    (+ allocation-tag 9))))
              "[0,16,0,0,0,0,0,0]"))
     (.toBe (test/expect (json-string [(nth (nth requests 1) 20)
                                       (nth (nth requests 2) 20)]))
            "[3,4]")
     (.toBe (test/expect (json-string (.-frame @started))) "[]")
     ((.-requestAdmission port)
      (.-session @started)
      (.-candidate @candidate)
      (fn [result Any] Any (reset! admitted result)))
     (.toBe (test/expect (str (.-length requests))) "5")
     (.toBe (test/expect (json-string [(nth (nth requests 3) 20)
                                       (nth (nth requests 4) 20)]))
            "[5,6]")
     (.toBe (test/expect (json-string (.-revision @admitted)))
            (json-string (identity 36)))
     (.toBe (test/expect (json-string (.-frame @admitted))) "[40,41,42]")
     ((.-disposeSession port) (.-session @started))
     (.toBe (test/expect (str (nth (nth requests 5) 20))) "7")
     (let [after-dispose Any (atom nil)]
       ((.-runCandidate port)
        (.-session @started)
        (workbench/->FixedTick 16)
        (workbench/->InputConfiguration 0 [])
        (fn [result Any] Any (reset! after-dispose result)))
       (.toBe (test/expect (str (.-reason @after-dispose)))
              "Wasm session is disposed"))
     nil)))

(test/test
 "strict CWO1 decoding rejects malformed and trailing bytes"
 (fn [] Nil
   (let [valid Any (cwo1 [{:kind "boolean" :value false}])]
     (.toBe
      (test/expect
       (if (throws?!
            (fn [] Any
              (wasm/decode-cwo1-observation (.concat valid [0]))))
         "true"
         "false"))
      "true")
     (let [bad Any (.slice valid)]
       (.splice bad 0 1 88)
       (.toBe
        (test/expect
         (if (throws?!
              (fn [] Any (wasm/decode-cwo1-observation bad)))
           "true"
           "false"))
        "true"))
     nil)))

(test/test
 "CWR1 hex transport is exact and bounded"
 (fn [] Nil
   (.toBe (test/expect (json-string
                        (wasm/decode-cwr1-hex "43 57\n52\t31")))
          "[67,87,82,49]")
   (doseq [source Any [""
                       "0"
                       "0g"
                       "0A"]]
     (.toBe
      (test/expect
       (if (throws?!
            (fn [] Any (wasm/decode-cwr1-hex source)))
         "true"
         "false"))
     "true"))
   nil))

(let [collect-test-runtime Any (require "bun:test")
      register-collect-test Any (.-test collect-test-runtime)]
  (register-collect-test
   "real Wasm lowers physical input and exposes only the admitted arena frame"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun "./fixtures/wasm-jump-v1/jump-v1.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort
            (wasm/create-wasm-cartridge-port
             (initialize-real-session-module (nth assets 0))
             (arena-policy))
              request wasm/ExactProcessRequest
              (wasm/->ExactProcessRequest (wasm/decode-cwr1-hex (nth assets 1)))
              accepted Any (atom nil)
              started Any (atom nil)
              candidate Any (atom nil)
              admitted Any (atom nil)
              airborne-candidate Any (atom nil)
              airborne-admitted Any (atom nil)
              momentum-candidate Any (atom nil)
              momentum-admitted Any (atom nil)]
          ((.-acceptPackage port) request
           (fn [result Any] Any (reset! accepted result)))
          ((.-startSession port) (.-acceptedPackage @accepted) 1
           (fn [result Any] Any (reset! started result)))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (key-configuration 1 1 "KeyD")
           (fn [result Any] Any (reset! candidate result)))
          (.toBe (test/expect (json-string (.-frame @started))) "[]")
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @candidate)
           (fn [result Any] Any (reset! admitted result)))
          (let [frame Any (wasm/decode-projected-term-frame (.-frame @admitted))]
            (.toBe
             (test/expect
              (if (> (.-x (.-position (.-player frame))) 0.0) "true" "false"))
             "true"))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (key-configuration 2 2 "Space")
           (fn [result Any] Any (reset! airborne-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @airborne-candidate)
           (fn [result Any] Any (reset! airborne-admitted result)))
          (let [jump-frame Any (wasm/decode-projected-term-frame
                                (.-frame @airborne-admitted))]
            (.toBe
             (test/expect
              (if (and (> (.-x (.-position (.-player jump-frame))) 0.0)
                       (> (.-y (.-position (.-player jump-frame))) 0.0)
                       (= false (.-grounded (.-player jump-frame))))
                "true"
                "false"))
             "true"))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (workbench/->InputConfiguration 3 [])
           (fn [result Any] Any (reset! momentum-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @momentum-candidate)
           (fn [result Any] Any (reset! momentum-admitted result)))
          (let [airborne-frame Any (wasm/decode-projected-term-frame
                                    (.-frame @airborne-admitted))
                momentum-frame Any (wasm/decode-projected-term-frame
                                    (.-frame @momentum-admitted))]
            (.toBe
             (test/expect
              (if (> (.-x (.-position (.-player momentum-frame)))
                     (.-x (.-position (.-player airborne-frame))))
                "true"
                "false"))
             "true"))
          ((.-disposeSession port) (.-session @started))
          nil))))))

(let [test-runtime Any (require "bun:test")
      register-async-test Any (.-test test-runtime)]
  (register-async-test
   "real Wasm keeps collect hidden until Admission and projects Clause-owned score"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun "./fixtures/wasm-collect-v1/collect-plus-1.cwr1.hex"))
                     (.text (.file Bun "./fixtures/wasm-collect-v1/collect-plus-4.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort
              (wasm/create-wasm-cartridge-port
               (initialize-real-session-module (nth assets 0))
               (arena-policy))
              base-score Float (admit-real-collect! port (nth assets 1) 1.0)
              changed-score Float (admit-real-collect! port (nth assets 2) 4.0)]
          (.toBe (test/expect (str base-score)) "1")
          (.toBe (test/expect (str changed-score)) "4")
          nil))))))
