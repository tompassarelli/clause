#lang beagle/js

(ns jump-arena-shell.wasm-cartridge-port-test
  (:require [jump-arena-shell.wasm-cartridge-port :as wasm]
            [jump-arena-shell.workbench :as workbench]))

(require '["bun:test" :as test])

(defn policy [] workbench/WorkbenchPolicy
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (workbench/->WorkbenchPolicy
     8 8 32 128 512
     (workbench/->WorkbenchSequenceLimits
      maximum maximum maximum maximum maximum))))

(defn identity [tag Int] Any
  (let [bytes Any (new Array 32)]
    (.fill bytes 0)
    (.splice bytes 0 1 tag)
    (.splice bytes 31 1 tag)
    bytes))

(defn cwo1 [values Any] Any
  (let [bytes Any [67 87 79 49]]
    (.push bytes (identity 11))
    (.push bytes (identity 22))
    (let [flat Any (.flat bytes)
          count Int (.-length values)]
      (.push flat (rem count 256))
      (.push flat (quot count 256))
      (doseq [value Any values]
        (if (= (.-kind value) "boolean")
          (do
            (.push flat 1)
            (.push flat (if (.-value value) 1 0)))
          (let [packed Any (new ArrayBuffer 8)
                view Any (new DataView packed)
                octets Any (new Uint8Array packed)]
            (.setFloat64 view 0 (.-value value) true)
            (.push flat 0)
            (doseq [octet Int octets]
              (.push flat octet)))))
      flat)))

(defn module-for!
  [events Any
   requests Any] Any
  (let [request Any (atom [])
        current Any (atom [])
        next-event! Any (fn [] Any
                          (do
                            (.push requests (.slice @request))
                            (reset! current (.shift events))
                            0))]
    {:clause_session_v1_io_reset (fn [] Any (reset! request []))
     :clause_session_v1_request_push (fn [byte Int] Int
                                       (do (.push @request byte) 0))
     :clause_session_v1_open next-event!
     :clause_session_v1_command next-event!
     :clause_session_v1_event_len (fn [] Int (.-length @current))
     :clause_session_v1_event_byte (fn [index Int] Int (nth @current index))}))

(defn append-u32!
  [bytes Any
   value Int] Any
  (doseq [divisor Int [1 256 65536 16777216]]
    (.push bytes (rem (quot value divisor) 256))))

(defn append-u64!
  [bytes Any
   value Int] Any
  (do (append-u32! bytes value) (append-u32! bytes 0)))

(defn append-blob!
  [bytes Any
   value Any] Any
  (do
    (append-u32! bytes (.-length value))
    (doseq [byte Int value] (.push bytes byte))))

(defn minimal-cwr1! [] Any
  (let [bytes Any [67 87 82 49]]
    (append-blob! bytes [1])
    (append-u32! bytes 1)
    (doseq [tag Int [1 2 3 4 5 6 7 8 9]]
      (doseq [byte Int (identity tag)] (.push bytes byte)))
    (append-blob! bytes [9])
    (doseq [byte Int (identity 10)] (.push bytes byte))
    (append-blob! bytes [10])
    (doseq [byte Int (identity 11)] (.push bytes byte))
    (append-blob! bytes [11])
    (append-u64! bytes 100)
    (.push bytes 2 0)
    (append-blob! bytes [1])
    (append-blob! bytes [2])
    (.push bytes 0 0)
    bytes))

(defn cse-header!
  [sequence Int
   tag Int] Any
  (let [bytes Any [67 83 69 49]]
    (append-u32! bytes 0)
    (append-u32! bytes 1)
    (append-u64! bytes sequence)
    (.push bytes tag)
    bytes))

(defn put-identities!
  [bytes Any
   tags Any] Any
  (doseq [tag Int tags]
    (doseq [byte Int (identity tag)] (.push bytes byte))))

(defn opened-event! [] Any
  (let [bytes Any (cse-header! 0 1)]
    (put-identities! bytes [21 3 22 23 24])
    (append-u32! bytes 1)
    bytes))

(defn input-event! [] Any
  (let [bytes Any (cse-header! 1 2)]
    (put-identities! bytes [31 23 24 32 33])
    (append-u32! bytes 1)
    bytes))

(defn candidate-event! [] Any
  (let [bytes Any (cse-header! 2 3)]
    (put-identities! bytes [34 35 22 23 24])
    (append-u32! bytes 1)
    bytes))

(defn admission-event! [] Any
  (let [bytes Any (cse-header! 3 4)]
    (put-identities! bytes [22 36 37 38 3])
    (append-u32! bytes 2)
    (.push bytes 1)
    (put-identities! bytes [39])
    (append-blob! bytes [40 41 42])
    bytes))

(defn disposed-event! [] Any (cse-header! 4 5))

(defn throws?! [action (Fn [] Any)] Bool
  (try
    (do (action) false)
    (catch Error _error true)))

(defn json-string [value Any] String
  (let [encoded Any (.stringify JSON value)]
    (if (= (js/typeof encoded) "string")
      encoded
      (throw (new Error "test value is not JSON-encodable")))))

(test/test
 "one persistent session sequences input candidate Admission and disposal"
 (fn [] Nil
   (let [requests Any []
         port workbench/CartridgePort (wasm/create-wasm-cartridge-port
                                       (module-for! [(opened-event!)
                                                     (input-event!)
                                                     (candidate-event!)
                                                     (admission-event!)
                                                     (disposed-event!)]
                                                   requests)
                                       (policy))
         request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
                                           (minimal-cwr1!))
         accepted Any (atom nil)
         started Any (atom nil)
         candidate Any (atom nil)
         admitted Any (atom nil)]
     ((.-acceptPackage port) request (fn [result Any] Any (reset! accepted result)))
     ((.-startSession port) (.-acceptedPackage @accepted) 1
      (fn [result Any] Any (reset! started result)))
     ((.-runCandidate port)
      (.-session @started)
      (workbench/->FixedTick 16)
      (workbench/->InputConfiguration 0 [])
      (fn [result Any] Any (reset! candidate result)))
     (.toBe (test/expect (str (.-length requests))) "3")
     (.toBe (test/expect (json-string (.slice (nth requests 0) 0 4)))
            "[67,87,83,49]")
     (.toBe (test/expect (json-string [(nth (nth requests 1) 20)
                                       (nth (nth requests 2) 20)]))
            "[1,2]")
     (.toBe (test/expect (json-string (.-frame @started))) "[]")
     ((.-requestAdmission port)
      (.-session @started)
      (.-candidate @candidate)
      (fn [result Any] Any (reset! admitted result)))
     (.toBe (test/expect (str (.-length requests))) "4")
     (.toBe (test/expect (str (nth (nth requests 3) 20))) "3")
     (.toBe (test/expect (json-string (.-revision @admitted)))
            (json-string (identity 36)))
     (.toBe (test/expect (json-string (.-frame @admitted))) "[40,41,42]")
     ((.-disposeSession port) (.-session @started))
     (.toBe (test/expect (str (nth (nth requests 4) 20))) "4")
     (let [after-dispose Any (atom nil)]
       ((.-runCandidate port)
        (.-session @started)
        (workbench/->FixedTick 16)
        (workbench/->InputConfiguration 0 [])
        (fn [result Any] Any (reset! after-dispose result)))
       (.toBe (test/expect (str (.-reason @after-dispose)))
              "Wasm session is disposed"))
     nil)))

(test/test
 "strict CWO1 decoding rejects malformed and trailing bytes"
 (fn [] Nil
   (let [valid Any (cwo1 [{:kind "boolean" :value false}])]
     (.toBe
      (test/expect
       (if (throws?!
            (fn [] Any
              (wasm/decode-cwo1-observation (.concat valid [0]))))
         "true"
         "false"))
      "true")
     (let [bad Any (.slice valid)]
       (.splice bad 0 1 88)
       (.toBe
        (test/expect
         (if (throws?!
              (fn [] Any (wasm/decode-cwo1-observation bad)))
           "true"
           "false"))
        "true"))
     nil)))

(test/test
 "CWR1 hex transport is exact and bounded"
 (fn [] Nil
   (.toBe (test/expect (json-string
                        (wasm/decode-cwr1-hex "43 57\n52\t31")))
          "[67,87,82,49]")
   (doseq [source Any [""
                       "0"
                       "0g"
                       "0A"]]
     (.toBe
      (test/expect
       (if (throws?!
            (fn [] Any (wasm/decode-cwr1-hex source)))
         "true"
         "false"))
      "true"))
   nil))
