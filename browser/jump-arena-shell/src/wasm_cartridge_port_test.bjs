#lang beagle/js

(ns jump-arena-shell.wasm-cartridge-port-test
  (:require [jump-arena-shell.wasm-cartridge-port :as wasm]
            [jump-arena-shell.workbench :as workbench]))

(require '["bun:test" :as test])
(require
 '["#clause-runtime-wasm"
   :refer [clause_session_v1_command
           clause_session_v1_event_byte
           clause_session_v1_event_len
           clause_session_v1_io_reset
           clause_session_v1_open
           clause_session_v1_request_push
           initSync
           InitOutput
           SyncInitInput]])

(declare-extern [Bun require] Any)

(defn policy [] workbench/WorkbenchPolicy
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (workbench/->WorkbenchPolicy
     8 8 32 128 512
     (workbench/->WorkbenchSequenceLimits
     maximum maximum maximum maximum maximum))))

(defn arena-policy [] workbench/WorkbenchPolicy
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (workbench/->WorkbenchPolicy
     8 8 32 wasm/cse1-projected-term-max-properties
     wasm/cse1-projected-term-json-max-source-units
     (workbench/->WorkbenchSequenceLimits
      maximum maximum maximum maximum maximum))))

(defn identity [tag Int] Any
  (let [bytes Any (new Array 32)]
    (.fill bytes 0)
    (.splice bytes 0 1 tag)
    (.splice bytes 31 1 tag)
    bytes))

(defn cwo1 [values Any] Any
  (let [bytes Any [67 87 79 49]]
    (.push bytes (identity 11))
    (.push bytes (identity 22))
    (let [flat Any (.flat bytes)
          count Int (.-length values)]
      (.push flat (rem count 256))
      (.push flat (quot count 256))
      (doseq [value Any values]
        (if (= (.-kind value) "boolean")
          (do
            (.push flat 1)
            (.push flat (if (.-value value) 1 0)))
          (let [packed Any (new ArrayBuffer 8)
                view Any (new DataView packed)
                octets Any (new Uint8Array packed)]
            (.setFloat64 view 0 (.-value value) true)
            (.push flat 0)
            (doseq [octet Int octets]
              (.push flat octet)))))
      flat)))

(defn module-for!
  [events Any
   requests Any] Any
  (let [request Any (atom [])
        current Any (atom [])
        next-event! Any (fn [] Any
                          (do
                            (.push requests (.slice @request))
                            (reset! current (.shift events))
                            0))]
    {:clause_session_v1_io_reset (fn [] Any (reset! request []))
     :clause_session_v1_request_push (fn [byte Int] Int
                                       (do (.push @request byte) 0))
     :clause_session_v1_open next-event!
     :clause_session_v1_command next-event!
     :clause_session_v1_event_len (fn [] Int (.-length @current))
     :clause_session_v1_event_byte (fn [index Int] Int (nth @current index))}))

(defn append-u32!
  [bytes Any
   value Int] Any
  (doseq [divisor Int [1 256 65536 16777216]]
    (.push bytes (rem (quot value divisor) 256))))

(defn append-u64!
  [bytes Any
   value Int] Any
  (do (append-u32! bytes value) (append-u32! bytes 0)))

(defn append-blob!
  [bytes Any
   value Any] Any
  (do
    (append-u32! bytes (.-length value))
    (doseq [byte Int value] (.push bytes byte))))

(defn allocation-epoch! [] Any
  (let [bytes Any (new Array 304)]
    (.fill bytes 0)
    (.splice bytes 0 4 82 65 69 49)
    bytes))

(defn minimal-cwr1! [] Any
  (let [bytes Any [67 87 82 49]]
    (append-blob! bytes [1])
    (append-u32! bytes 1)
    (append-blob! bytes [8])
    (append-blob! bytes (allocation-epoch!))
    (doseq [tag Int [1 2 3 4 5 6 7 8 9]]
      (doseq [byte Int (identity tag)] (.push bytes byte)))
    (append-blob! bytes [9])
    (doseq [byte Int (identity 10)] (.push bytes byte))
    (append-blob! bytes [10])
    (doseq [byte Int (identity 11)] (.push bytes byte))
    (append-blob! bytes [11])
    (append-u64! bytes 100)
    (.push bytes 2 0)
    (append-blob! bytes [1])
    (append-blob! bytes [2])
    (.push bytes 0 0)
    bytes))

(defn cse-header!
  [sequence Int
   tag Int] Any
  (let [bytes Any [67 83 69 49]]
    (append-u32! bytes 0)
    (append-u32! bytes 1)
    (append-u64! bytes sequence)
    (.push bytes tag)
    bytes))

(defn put-identities!
  [bytes Any
   tags Any] Any
  (doseq [tag Int tags]
    (doseq [byte Int (identity tag)] (.push bytes byte))))

(defn opened-event! [] Any
  (let [bytes Any (cse-header! 0 1)]
    (put-identities! bytes [21 3 22 23 24])
    (append-u32! bytes 1)
    (append-blob! bytes (allocation-epoch!))
    bytes))

(defn input-event! [] Any
  (let [bytes Any (cse-header! 1 2)]
    (put-identities! bytes [31 23 24 32 33])
    (append-u32! bytes 1)
    bytes))

(defn candidate-event! [] Any
  (let [bytes Any (cse-header! 2 3)]
    (put-identities! bytes [34 35 22 23 24])
    (append-u32! bytes 1)
    bytes))

(defn issuance-event! [] Any
  (let [bytes Any (cse-header! 3 4)]
    (put-identities! bytes [40 21 3 22 35])
    (append-u32! bytes 1)
    bytes))

(defn admission-event! [] Any
  (let [bytes Any (cse-header! 4 5)]
    (put-identities! bytes [22 36 37 38 3])
    (append-u32! bytes 2)
    (.push bytes 1)
    (put-identities! bytes [39])
    (append-blob! bytes [40 41 42])
    bytes))

(defn disposed-event! [] Any (cse-header! 5 6))

(defn throws?! [action (Fn [] Any)] Bool
  (try
    (do (action) false)
    (catch Error _error true)))

(defn json-string [value Any] String
  (let [encoded Any (.stringify JSON value)]
    (if (= (js/typeof encoded) "string")
      encoded
      (throw (new Error "test value is not JSON-encodable")))))

(defn initialize-real-session-module [module ArrayBuffer] Any
  (let [input SyncInitInput module
        _initialized InitOutput (initSync input)]
    (.freeze
     Object
     {:clause_session_v1_io_reset
      (fn [] Nil (clause_session_v1_io_reset))
      :clause_session_v1_request_push
      (fn [byte Int] Float (clause_session_v1_request_push byte))
      :clause_session_v1_open
      (fn [] Float (clause_session_v1_open))
      :clause_session_v1_command
      (fn [] Float (clause_session_v1_command))
      :clause_session_v1_event_len
      (fn [] Float (clause_session_v1_event_len))
      :clause_session_v1_event_byte
      (fn [index Int] Float (clause_session_v1_event_byte index))})))

(defn key-configuration
  [input-sequence Int
   revision Int
   code String] workbench/InputConfiguration
  (workbench/->InputConfiguration
   revision
   [(workbench/->InputObservation
     input-sequence
     (workbench/create-workbench-envelope
      (policy)
      (json-string [(json-string {:kind "keyboard"
                                  :code code
                                  :phase "down"
                                  :repeat false})])))]))

(defn two-key-configuration
  [first-input-sequence Int
   revision Int
   first-code String
   second-code String] workbench/InputConfiguration
  (workbench/->InputConfiguration
   revision
   [(workbench/->InputObservation
     first-input-sequence
     (workbench/create-workbench-envelope
      (policy)
      (json-string [(json-string {:kind "keyboard"
                                  :code first-code
                                  :phase "down"
                                  :repeat false})])))
    (workbench/->InputObservation
     (inc first-input-sequence)
     (workbench/create-workbench-envelope
      (policy)
      (json-string [(json-string {:kind "keyboard"
                                  :code second-code
                                  :phase "down"
                                  :repeat false})])))]))

(defn process-configuration
  [input-sequence Int
   revision Int
   ordinal Int] workbench/InputConfiguration
  (workbench/->InputConfiguration
   revision
   [(workbench/->InputObservation
     input-sequence
     (workbench/create-workbench-envelope
      (policy)
      (json-string [(json-string {:kind "process-occurrence"
                                  :ordinal ordinal})])))]))

(defn key-envelope
  [code String
   phase String] Any
  (workbench/create-workbench-envelope
   (arena-policy)
   (json-string [(json-string {:kind "keyboard"
                               :code code
                               :phase phase
                               :repeat false})])))

(defn admit-real-process!
  [port workbench/CartridgePort
   request-bytes Any] Any
  (let [request wasm/ExactProcessRequest (wasm/->ExactProcessRequest (wasm/decode-cwr1-hex request-bytes))
        accepted Any (atom nil)
        started Any (atom nil)
        candidate Any (atom nil)
        admitted Any (atom nil)]
    ((.-acceptPackage port) request
     (fn [result Any] Any (reset! accepted result)))
    ((.-startSession port) (.-acceptedPackage @accepted) 1
     (fn [result Any] Any (reset! started result)))
    ((.-runCandidate port)
     (.-session @started)
     (workbench/->FixedTick 16)
     (process-configuration 1 1 0)
     (fn [result Any] Any (reset! candidate result)))
    (.toBe (test/expect (json-string (.-frame @started))) "[]")
    (.toBe (test/expect (json-string (.-base (.-candidate @candidate))))
           (json-string (.-revision @started)))
    ((.-requestAdmission port)
     (.-session @started)
     (.-candidate @candidate)
     (fn [result Any] Any (reset! admitted result)))
    (.toBe
     (test/expect
      (if (not= (json-string (.-revision @admitted))
                (json-string (.-revision @started)))
        "true"
        "false"))
     "true")
    (let [frame Any (wasm/decode-projected-term-frame (.-frame @admitted))]
      ((.-disposeSession port) (.-session @started))
      frame)))

(test/test
 "one persistent session sequences physical input candidate issuance Admission and disposal"
 (fn [] Nil
   (let [requests Any []
         port workbench/CartridgePort (wasm/create-wasm-cartridge-port
                                       (module-for! [(opened-event!)
                                                     (input-event!)
                                                     (candidate-event!)
                                                     (issuance-event!)
                                                     (admission-event!)
                                                     (disposed-event!)]
                                                   requests)
                                       (policy))
         request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
                                           (minimal-cwr1!))
         accepted Any (atom nil)
         started Any (atom nil)
         candidate Any (atom nil)
         admitted Any (atom nil)]
     ((.-acceptPackage port) request (fn [result Any] Any (reset! accepted result)))
     ((.-startSession port) (.-acceptedPackage @accepted) 1
      (fn [result Any] Any (reset! started result)))
     ((.-runCandidate port)
      (.-session @started)
      (workbench/->FixedTick 16)
      (workbench/->InputConfiguration
       1
       [(workbench/->InputObservation
         1
         (workbench/create-workbench-envelope
          (policy)
          (json-string [(json-string {:kind "keyboard"
                                      :code "KeyD"
                                      :phase "down"
                                      :repeat false})])))])
      (fn [result Any] Any (reset! candidate result)))
     (.toBe (test/expect (str (.-length requests))) "3")
     (let [open-request Any (nth requests 0)
           open-length Int (.-length open-request)
           allocation-tag Int (- open-length 17)]
       (.toBe (test/expect (json-string (.slice open-request 0 4)))
              "[67,87,83,49]")
       (.toBe (test/expect (json-string (.slice open-request 13 18)))
              "[1,0,0,0,8]")
       (.toBe (test/expect (str (nth open-request allocation-tag))) "0")
       (.toBe (test/expect
               (json-string (.slice open-request
                                    (inc allocation-tag)
                                    (+ allocation-tag 9))))
              "[0,16,0,0,0,0,0,0]"))
     (.toBe (test/expect (json-string [(nth (nth requests 1) 20)
                                       (nth (nth requests 2) 20)]))
            "[3,4]")
     (.toBe (test/expect (json-string (.-frame @started))) "[]")
     ((.-requestAdmission port)
      (.-session @started)
      (.-candidate @candidate)
      (fn [result Any] Any (reset! admitted result)))
     (.toBe (test/expect (str (.-length requests))) "5")
     (.toBe (test/expect (json-string [(nth (nth requests 3) 20)
                                       (nth (nth requests 4) 20)]))
            "[5,6]")
     (.toBe (test/expect (json-string (.-revision @admitted)))
            (json-string (identity 36)))
     (.toBe (test/expect (json-string (.-frame @admitted))) "[40,41,42]")
     ((.-disposeSession port) (.-session @started))
     (.toBe (test/expect (str (nth (nth requests 5) 20))) "7")
     (let [after-dispose Any (atom nil)]
       ((.-runCandidate port)
        (.-session @started)
        (workbench/->FixedTick 16)
        (workbench/->InputConfiguration 0 [])
        (fn [result Any] Any (reset! after-dispose result)))
       (.toBe (test/expect (str (.-reason @after-dispose)))
              "Wasm session is disposed"))
     nil)))

(test/test
 "strict CWO1 decoding rejects malformed and trailing bytes"
 (fn [] Nil
   (let [valid Any (cwo1 [{:kind "boolean" :value false}])]
     (.toBe
      (test/expect
       (if (throws?!
            (fn [] Any
              (wasm/decode-cwo1-observation (.concat valid [0]))))
         "true"
         "false"))
      "true")
     (let [bad Any (.slice valid)]
       (.splice bad 0 1 88)
       (.toBe
        (test/expect
         (if (throws?!
              (fn [] Any (wasm/decode-cwo1-observation bad)))
           "true"
           "false"))
        "true"))
     nil)))

(test/test
 "CWR1 hex transport is exact and bounded"
 (fn [] Nil
   (.toBe (test/expect (json-string
                        (wasm/decode-cwr1-hex "43 57\n52\t31")))
          "[67,87,82,49]")
   (doseq [source Any [""
                       "0"
                       "0g"
                       "0A"]]
     (.toBe
      (test/expect
       (if (throws?!
            (fn [] Any (wasm/decode-cwr1-hex source)))
         "true"
         "false"))
     "true"))
   nil))

(let [collect-test-runtime Any (require "bun:test")
      register-collect-test Any (.-test collect-test-runtime)]
  (register-collect-test
   "real Wasm lowers physical input and exposes only the admitted arena frame"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun "./fixtures/wasm-jump-v1/jump-v1.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort (wasm/create-wasm-cartridge-port
             (initialize-real-session-module (nth assets 0))
             (arena-policy))
              request wasm/ExactProcessRequest (wasm/->ExactProcessRequest (wasm/decode-cwr1-hex (nth assets 1)))
              accepted Any (atom nil)
              started Any (atom nil)
              candidate Any (atom nil)
              admitted Any (atom nil)
              airborne-candidate Any (atom nil)
              airborne-admitted Any (atom nil)
              momentum-candidate Any (atom nil)
              momentum-admitted Any (atom nil)]
          ((.-acceptPackage port) request
           (fn [result Any] Any (reset! accepted result)))
          ((.-startSession port) (.-acceptedPackage @accepted) 1
           (fn [result Any] Any (reset! started result)))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (key-configuration 1 1 "KeyD")
           (fn [result Any] Any (reset! candidate result)))
          (.toBe (test/expect (json-string (.-frame @started))) "[]")
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @candidate)
           (fn [result Any] Any (reset! admitted result)))
          (let [frame Any (wasm/decode-projected-term-frame (.-frame @admitted))]
            (.toBe
             (test/expect
              (if (> (.-x (.-position (.-player frame))) 0.0) "true" "false"))
             "true"))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (key-configuration 2 2 "Space")
           (fn [result Any] Any (reset! airborne-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @airborne-candidate)
           (fn [result Any] Any (reset! airborne-admitted result)))
          (let [jump-frame Any (wasm/decode-projected-term-frame
                                (.-frame @airborne-admitted))]
            (.toBe
             (test/expect
              (if (and (> (.-x (.-position (.-player jump-frame))) 0.0)
                       (> (.-y (.-position (.-player jump-frame))) 0.0)
                       (= false (.-grounded (.-player jump-frame))))
                "true"
                "false"))
             "true"))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (workbench/->InputConfiguration 3 [])
           (fn [result Any] Any (reset! momentum-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @momentum-candidate)
           (fn [result Any] Any (reset! momentum-admitted result)))
          (let [airborne-frame Any (wasm/decode-projected-term-frame
                                    (.-frame @airborne-admitted))
                momentum-frame Any (wasm/decode-projected-term-frame
                                    (.-frame @momentum-admitted))]
            (.toBe
             (test/expect
              (if (> (.-x (.-position (.-player momentum-frame)))
                     (.-x (.-position (.-player airborne-frame))))
                "true"
                "false"))
             "true"))
          ((.-disposeSession port) (.-session @started))
          nil))))))

(let [test-runtime Any (require "bun:test")
      register-async-test Any (.-test test-runtime)]
  (register-async-test
   "real Wasm keeps collect hidden until Admission and projects Clause-owned score"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun "./fixtures/wasm-collect-v1/collect-plus-1.cwr1.hex"))
                     (.text (.file Bun "./fixtures/wasm-collect-v1/collect-plus-4.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort (wasm/create-wasm-cartridge-port
               (initialize-real-session-module (nth assets 0))
               (arena-policy))
              base-frame Any (admit-real-process! port (nth assets 1))
              changed-frame Any (admit-real-process! port (nth assets 2))
              base-score Float (.-score (.-player base-frame))
              changed-score Float (.-score (.-player changed-frame))]
          (.toBe (test/expect (str base-score)) "1")
          (.toBe (test/expect (str changed-score)) "4")
          nil))))))

(let [symbol-test-runtime Any (require "bun:test")
      register-symbol-test Any (.-test symbol-test-runtime)]
  (register-symbol-test
   "real Wasm admits Clause-owned active to collected symbolic state"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun "./fixtures/wasm-collect-state-v1/collected.cwr1.hex"))
                     (.text (.file Bun "./fixtures/wasm-collect-state-v1/spent.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort (wasm/create-wasm-cartridge-port
               (initialize-real-session-module (nth assets 0))
               (arena-policy))
              collected-frame Any (admit-real-process! port (nth assets 1))
              spent-frame Any (admit-real-process! port (nth assets 2))
              collected-state String (.-state (.-collectible collected-frame))
              spent-state String (.-state (.-collectible spent-frame))]
          (.toBe (test/expect collected-state) "collected")
          (.toBe (test/expect spent-state) "spent")
          nil))))))

(let [gameplay-test-runtime Any (require "bun:test")
      register-gameplay-test Any (.-test gameplay-test-runtime)]
  (register-gameplay-test
   "one real Wasm gameplay session collects then automatically launches from Clause contact"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun
                                   "./fixtures/wasm-gameplay-v1/gameplay-v1.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort (wasm/create-wasm-cartridge-port
               (initialize-real-session-module (nth assets 0))
               (arena-policy))
              request wasm/ExactProcessRequest (wasm/->ExactProcessRequest (wasm/decode-cwr1-hex (nth assets 1)))
              accepted Any (atom nil)
              started Any (atom nil)
              collect-candidate Any (atom nil)
              collect-admitted Any (atom nil)
              launch-candidate Any (atom nil)
              launch-admitted Any (atom nil)
              airborne-candidate Any (atom nil)
              airborne-admitted Any (atom nil)]
          ((.-acceptPackage port) request
           (fn [result Any] Any (reset! accepted result)))
          ((.-startSession port) (.-acceptedPackage @accepted) 1
           (fn [result Any] Any (reset! started result)))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (key-configuration 1 1 "KeyD")
           (fn [result Any] Any (reset! collect-candidate result)))
          (.toBe (test/expect (json-string (.-frame @started))) "[]")
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @collect-candidate)
           (fn [result Any] Any (reset! collect-admitted result)))
          (let [collected-frame Any (wasm/decode-projected-term-frame (.-frame @collect-admitted))
                player-x Float (.-x (.-position (.-player collected-frame)))
                collected-collectible Any (nth (.-collectibles (.-world collected-frame)) 0)
                collected-collectible-state String (.-state collected-collectible)
                collectible-x Float (.-x (.-position collected-collectible))]
            (.toBe (test/expect collected-collectible-state) "collected")
            (.toBe (test/expect (str player-x)) (str collectible-x)))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (workbench/->InputConfiguration 2 [])
           (fn [result Any] Any (reset! launch-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @launch-candidate)
           (fn [result Any] Any (reset! launch-admitted result)))
          (let [launch-frame Any (wasm/decode-projected-term-frame
                                  (.-frame @launch-admitted))
                launch-player Any (.-player launch-frame)]
            (.toBe (test/expect (str (.-y (.-velocity launch-player)))) "12")
            (.toBe (test/expect (str (.-grounded launch-player))) "false"))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (workbench/->InputConfiguration 3 [])
           (fn [result Any] Any (reset! airborne-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @airborne-candidate)
           (fn [result Any] Any (reset! airborne-admitted result)))
          (let [airborne-frame Any (wasm/decode-projected-term-frame
                                    (.-frame @airborne-admitted))]
            (.toBe
             (test/expect
              (if (> (.-y (.-position (.-player airborne-frame))) 0.0)
                "true"
                "false"))
             "true"))
          ((.-disposeSession port) (.-session @started))
          nil))))))

(let [generic-source-test-runtime Any (require "bun:test")
      register-generic-source-test Any (.-test generic-source-test-runtime)]
  (register-generic-source-test
   "real Wasm executes a generically allocated Clause source plan"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun
                                   "./fixtures/wasm-generic-source-v1/generic-source-v1.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort (wasm/create-wasm-cartridge-port
               (initialize-real-session-module (nth assets 0))
               (arena-policy))
              request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
               (wasm/decode-cwr1-hex (nth assets 1)))
              accepted Any (atom nil)
              started Any (atom nil)
              candidate Any (atom nil)
              admitted Any (atom nil)]
          ((.-acceptPackage port) request
           (fn [result Any] Any (reset! accepted result)))
          ((.-startSession port) (.-acceptedPackage @accepted) 1
           (fn [result Any] Any (reset! started result)))
          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (key-configuration 1 1 "KeyD")
           (fn [result Any] Any (reset! candidate result)))
          (.toBe (test/expect (json-string (.-frame @started))) "[]")
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @candidate)
           (fn [result Any] Any (reset! admitted result)))
          (let [frame Any (wasm/decode-projected-term-frame (.-frame @admitted))
                player Any (.-player frame)]
            (.toBe
             (test/expect (if (> (.-x (.-position player)) 0.0) "true" "false"))
             "true"))
          ((.-disposeSession port) (.-session @started))
          nil))))))

(let [coherent-test-runtime Any (require "bun:test")
      register-coherent-test Any (.-test coherent-test-runtime)]
  (register-coherent-test
   "one real Wasm session fails resets completes and launches from Clause source"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun
                                   "./fixtures/wasm-coherent-game-v1/coherent-game-v1.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort (wasm/create-wasm-cartridge-port
               (initialize-real-session-module (nth assets 0))
               (arena-policy))
              request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
               (wasm/decode-cwr1-hex (nth assets 1)))
              accepted Any (atom nil)
              started Any (atom nil)
              failure-candidate Any (atom nil)
              failure-admitted Any (atom nil)
              reset-candidate Any (atom nil)
              reset-admitted Any (atom nil)
              completion-candidate Any (atom nil)
              completion-admitted Any (atom nil)
              launch-candidate Any (atom nil)
              launch-admitted Any (atom nil)]
          ((.-acceptPackage port) request
           (fn [result Any] Any (reset! accepted result)))
          ((.-startSession port) (.-acceptedPackage @accepted) 1
           (fn [result Any] Any (reset! started result)))

          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (key-configuration 1 1 "KeyS")
           (fn [result Any] Any (reset! failure-candidate result)))
          (.toBe (test/expect (json-string (.-frame @started))) "[]")
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @failure-candidate)
           (fn [result Any] Any (reset! failure-admitted result)))
          (let [failure-frame Any (wasm/decode-projected-term-frame
                                   (.-frame @failure-admitted))]
            (.toBe
             (test/expect (str (.-state (.-objective (.-world failure-frame)))))
             "failed"))

          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (two-key-configuration 2 2 "KeyW" "KeyR")
           (fn [result Any] Any (reset! reset-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @reset-candidate)
           (fn [result Any] Any (reset! reset-admitted result)))
          (let [reset-frame Any (wasm/decode-projected-term-frame
                                 (.-frame @reset-admitted))]
            (.toBe
             (test/expect (str (.-state (.-objective (.-world reset-frame)))))
             "playing")
            (.toBe (test/expect (str (.-z (.-position (.-player reset-frame))))) "0"))

          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (key-configuration 4 3 "KeyD")
           (fn [result Any] Any (reset! completion-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @completion-candidate)
           (fn [result Any] Any (reset! completion-admitted result)))
          (let [completion-frame Any (wasm/decode-projected-term-frame
                                      (.-frame @completion-admitted))
                completed-world Any (.-world completion-frame)
                completed-collectible Any (nth (.-collectibles completed-world) 0)]
            (.toBe
             (test/expect (str (.-state (.-objective completed-world))))
             "completed")
            (.toBe (test/expect (str (.-state completed-collectible))) "collected"))

          ((.-runCandidate port)
           (.-session @started)
           (workbench/->FixedTick 16)
           (workbench/->InputConfiguration 4 [])
           (fn [result Any] Any (reset! launch-candidate result)))
          ((.-requestAdmission port)
           (.-session @started)
           (.-candidate @launch-candidate)
           (fn [result Any] Any (reset! launch-admitted result)))
          (let [launch-frame Any (wasm/decode-projected-term-frame
                                  (.-frame @launch-admitted))
                launch-player Any (.-player launch-frame)]
            (.toBe (test/expect (str (.-y (.-velocity launch-player)))) "12")
            (.toBe (test/expect (str (.-grounded launch-player))) "false")
            (.toBe
             (test/expect (str (.-state (.-objective (.-world launch-frame)))))
             "completed"))
          ((.-disposeSession port) (.-session @started))
          nil))))))

(let [reload-test-runtime Any (require "bun:test")
      register-reload-test Any (.-test reload-test-runtime)]
  (register-reload-test
   "real Wasm workbench hot-reloads Clause-only collect behavior with fenced prior generation"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun
                                   "./fixtures/wasm-gameplay-v1/gameplay-v1.cwr1.hex"))
                     (.text (.file Bun
                                   "./fixtures/wasm-gameplay-v1/gameplay-spent-v1.cwr1.hex"))])
      (fn [assets Any] Any
        (let [raw-port workbench/CartridgePort (wasm/create-wasm-cartridge-port
               (initialize-real-session-module (nth assets 0))
               (arena-policy))
              sessions Any (atom [])
              disposals Any (atom [])
              rendered Any (atom [])
              receipts Any (atom [])
              scheduled-tick Any (atom (fn [] Any nil))
              delay-next-candidate (Atom Bool) (atom false)
              delayed-candidate Any (atom nil)
              changed-start-revision Any (atom nil)
              tracked-port workbench/CartridgePort (workbench/->CartridgePort
               (.-acceptPackage raw-port)
               (fn
                 [accepted-package Any
                  generation Int
                  complete Any] Any
                 ((.-startSession raw-port)
                  accepted-package
                  generation
                  (fn [result Any] Any
                    (do
                      (.push @sessions (.-session result))
                      (complete result)))))
               (fn
                 [session Any
                  fixed-tick workbench/FixedTick
                  configuration workbench/InputConfiguration
                  complete Any] Any
                 ((.-runCandidate raw-port)
                  session
                  fixed-tick
                  configuration
                  (fn [result Any] Any
                    (if @delay-next-candidate
                      (do
                        (reset! delay-next-candidate false)
                        (reset! delayed-candidate
                                (fn [] Any (complete result))))
                      (complete result)))))
               (.-requestAdmission raw-port)
               (fn [session Any] Any
                 (do
                   (.push @disposals session)
                   ((.-disposeSession raw-port) session))))
              base-request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
               (wasm/decode-cwr1-hex (nth assets 1)))
              changed-request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
               (wasm/decode-cwr1-hex (nth assets 2)))
              controller Any (workbench/create-cartridge-workbench!
               tracked-port
               (workbench/->FixedTick 16)
               (arena-policy)
               (fn
                 [_milliseconds Int
                  callback Any] Any
                 (do
                   (reset! scheduled-tick callback)
                   (fn [] Any nil)))
               (fn [frame Any] Any (.push @rendered frame))
               (fn [receipt Any] Any (.push @receipts receipt))
               base-request)
              base-start Any ((.-snapshot controller))]
          (.toBe (test/expect (str (.-generation base-start))) "1")
          (.toBe (test/expect (str (.-phase base-start))) "ready")
          (.toBe (test/expect (json-string (.-frame base-start))) "[]")

          ((.-observeInput controller) (key-envelope "KeyD" "down"))
          (@scheduled-tick)
          (let [contact Any (wasm/decode-projected-term-frame
                             (.-frame ((.-snapshot controller))))
                player-x Float (.-x (.-position (.-player contact)))
                contact-collectible Any (nth (.-collectibles (.-world contact)) 0)]
            (.toBe (test/expect (str (.-state contact-collectible))) "collected")
            (.toBe (test/expect (str player-x))
                   (str (.-x (.-position contact-collectible)))))
          ((.-observeInput controller) (key-envelope "KeyD" "up"))
          (.toBe (test/expect (str (.-generation ((.-snapshot controller))))) "1")

          (let [old-session Any (nth @sessions 0)]
            (reset! delay-next-candidate true)
            (@scheduled-tick)
            (.toBe (test/expect (str (.-phase ((.-snapshot controller))))) "candidate")
            (.toBe (test/expect (str ((.-reloadPackage controller) changed-request))) "true")
            (let [changed-start Any ((.-snapshot controller))
                  changed-revision Any (.-revision changed-start)]
              (reset! changed-start-revision changed-revision)
              (.toBe (test/expect (str (.-phase changed-start))) "ready")
              (.toBe (test/expect (str (.-generation changed-start))) "2")
              (.toBe (test/expect (json-string (.-frame changed-start))) "[]")
              (.toBe (test/expect (str (.-length @sessions))) "2")
              (.toBe (test/expect (str (.-length @disposals))) "1")
              (.toBe (test/expect (str (.is Object (nth @disposals 0) old-session))) "true")

              (@delayed-candidate)
              (let [after-stale Any ((.-snapshot controller))
                    stale-events Any (.filter @receipts
                                              (fn [receipt Any] Bool
                                                (= (.-event receipt)
                                                   "completion-stale")))]
                (.toBe (test/expect (str (.-generation after-stale))) "2")
                (.toBe (test/expect (str (.is Object
                                               (.-revision after-stale)
                                               changed-revision)))
                       "true")
                (.toBe (test/expect (json-string (.-frame after-stale))) "[]")
                (.toBe (test/expect (str (.-length stale-events))) "1"))

              (let [retired-result Any (atom nil)]
                ((.-runCandidate raw-port)
                 old-session
                 (workbench/->FixedTick 16)
                 (workbench/->InputConfiguration 0 [])
                 (fn [result Any] Any (reset! retired-result result)))
                (.toBe (test/expect (str (.-reason @retired-result)))
                       "Wasm session is disposed")
                (.toBe (test/expect (str (.is Object
                                               (.-revision ((.-snapshot controller)))
                                               changed-revision)))
                       "true")))

          ((.-observeInput controller) (key-envelope "KeyD" "down"))
          (@scheduled-tick)
          (let [changed-admitted Any ((.-snapshot controller))
                changed-frame Any (wasm/decode-projected-term-frame (.-frame changed-admitted))
                changed-collectible Any (nth (.-collectibles (.-world changed-frame)) 0)
                rendered-length Int (.-length @rendered)
                visible-frame Any (wasm/decode-projected-term-frame
                                   (nth @rendered (dec rendered-length)))
                visible-collectible Any (nth (.-collectibles (.-world visible-frame)) 0)]
            (.toBe (test/expect (str (.-state changed-collectible))) "spent")
            (.toBe (test/expect (str (.-state visible-collectible))) "spent")
            (.toBe (test/expect (str (.-generation changed-admitted))) "2")
            (.toBe (test/expect
                     (str (not= (json-string (.-revision changed-admitted))
                                (json-string @changed-start-revision))))
                   "true"))
          (.toBe (test/expect (str ((.-dispose controller)))) "true")
          (.toBe (test/expect (str (.-length @disposals))) "2")
          nil)))))))

(let [dash-test-runtime Any (require "bun:test")
      register-dash-test Any (.-test dash-test-runtime)]
  (register-dash-test
   "real Wasm hot-reloads Clause dash jump through Admission and passive rendering"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun
                                   "./fixtures/wasm-gameplay-v1/gameplay-v1.cwr1.hex"))
                     (.text (.file Bun
                                   "./fixtures/wasm-gameplay-v1/gameplay-dash-jump-v1.cwr1.hex"))])
      (fn [assets Any] Any
        (let [port workbench/CartridgePort (wasm/create-wasm-cartridge-port
               (initialize-real-session-module (nth assets 0))
               (arena-policy))
              rendered Any (atom [])
              scheduled-tick Any (atom (fn [] Any nil))
              base-request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
               (wasm/decode-cwr1-hex (nth assets 1)))
              dash-request wasm/ExactProcessRequest (wasm/->ExactProcessRequest
               (wasm/decode-cwr1-hex (nth assets 2)))
              controller Any (workbench/create-cartridge-workbench!
               port
               (workbench/->FixedTick 16)
               (arena-policy)
               (fn
                 [_milliseconds Int
                  callback Any] Any
                 (do
                   (reset! scheduled-tick callback)
                   (fn [] Any nil)))
               (fn [frame Any] Any (.push @rendered frame))
               (fn [_receipt Any] Any nil)
               base-request)]
          (.toBe (test/expect (str (.-generation ((.-snapshot controller))))) "1")
          (.toBe (test/expect (str ((.-reloadPackage controller) dash-request))) "true")
          (let [dash-start Any ((.-snapshot controller))
                dash-revision Any (.-revision dash-start)]
            (.toBe (test/expect (str (.-generation dash-start))) "2")
            ((.-observeInput controller) (key-envelope "Space" "down"))
            (@scheduled-tick)
            (let [admitted Any ((.-snapshot controller))
                  admitted-frame Any (wasm/decode-projected-term-frame (.-frame admitted))
                  admitted-position Any (.-position (.-player admitted-frame))
                  rendered-length Int (.-length @rendered)
                  visible-frame Any (wasm/decode-projected-term-frame
                                     (nth @rendered (dec rendered-length)))
                  visible-position Any (.-position (.-player visible-frame))]
              (.toBe (test/expect (str (.-phase admitted))) "ready")
              (.toBe (test/expect (str (.-generation admitted))) "2")
              (.toBe (test/expect
                       (str (not= (json-string (.-revision admitted))
                                  (json-string dash-revision))))
                     "true")
              (.toBe (test/expect (if (> (.-x admitted-position) 0.0) "true" "false"))
                     "true")
              (.toBe (test/expect (if (> (.-y admitted-position) 0.0) "true" "false"))
                     "true")
              (.toBe (test/expect (str (.-x visible-position)))
                     (str (.-x admitted-position)))
              (.toBe (test/expect (str (.-y visible-position)))
                     (str (.-y admitted-position))))
          (.toBe (test/expect (str ((.-dispose controller)))) "true")
          nil)))))))
