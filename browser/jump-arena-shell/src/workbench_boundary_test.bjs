#lang beagle/js

(ns jump-arena-shell.workbench-boundary-test
  (:require [jump-arena-shell.workbench :as workbench]))

(require '["bun:test" :as test])

(defn expectation-failed! [] Nil
  (throw (new Error "typed expectation failed")))

(defn expect-true! [condition Bool] Nil
  (if condition nil (expectation-failed!)))

(defn expect-throws? [action (Fn [] Any)] Bool
  (try
    (do (action) false)
    (catch Error _error true)))

(defn frozen [value Any] Any
  (.freeze Object value))

(defn sequence-limits
  [max-receipt Int
   max-input Int
   max-generation Int
   max-operation Int
   max-configuration Int] workbench/WorkbenchSequenceLimits
  (workbench/->WorkbenchSequenceLimits
   max-receipt
   max-input
   max-generation
   max-operation
   max-configuration))

(defn default-sequence-limits [] workbench/WorkbenchSequenceLimits
  (let [maximum Int (.-MAX_SAFE_INTEGER Number)]
    (sequence-limits maximum maximum maximum maximum maximum)))

(defn workbench-policy
  [max-pending Int
   max-sessions Int] workbench/WorkbenchPolicy
  (workbench/->WorkbenchPolicy
   max-pending
   max-sessions
   32
   128
   512
   (default-sequence-limits)))

(defn workbench-policy-with-sequences
  [limits workbench/WorkbenchSequenceLimits] workbench/WorkbenchPolicy
  (workbench/->WorkbenchPolicy 8 8 32 128 512 limits))

(defn envelope [value Any] Any
  (workbench/create-workbench-envelope
   (workbench-policy 8 8)
   (.stringify JSON [value])))

(defn envelope-tree [source Any] Any
  (workbench/create-workbench-envelope
   (workbench-policy 8 8)
   (.stringify JSON source)))

(defn request-at
  [requests Any
   index Int] Any
  (nth @requests index))

(defn complete-request!
  [requests Any
   index Int
   completion Any] Any
  ((.-complete (request-at requests index)) completion))

(defn fake-fixture-with-policy!
  [initial-package Any
   policy workbench/WorkbenchPolicy] Any
  (let [calls Any (atom [])
        package-requests Any (atom [])
        session-requests Any (atom [])
        candidate-requests Any (atom [])
        admission-requests Any (atom [])
        disposals Any (atom [])
        rendered Any (atom [])
        receipts Any (atom [])
        package-hook Any (atom (fn [_request Any] Any nil))
        render-hook Any (atom (fn [_frame Any] Any nil))
        receipt-hook Any (atom (fn [_receipt Any] Any nil))
        session-hook Any (atom (fn [_request Any] Any nil))
        candidate-hook Any (atom (fn [_request Any] Any nil))
        admission-hook Any (atom (fn [_request Any] Any nil))
        disposal-hook Any (atom (fn [_session Any] Any nil))
        cancellation-hook Any (atom (fn [] Any nil))
        scheduled-delay Any (atom -1)
        scheduled-tick Any (atom (fn [] Any nil))
        cancellations Any (atom 0)
        port workbench/CartridgePort (workbench/->CartridgePort
         (fn
           [package-candidate Any
            complete Any] Any
           (let [request Any {:package package-candidate
                              :complete complete}]
             (.push @calls {:kind "acceptPackage"})
             (.push @package-requests request)
             (@package-hook request)))
         (fn
           [accepted-package Any
            generation Int
            complete Any] Any
           (let [request Any {:package accepted-package
                              :generation generation
                              :complete complete}]
             (.push @calls {:kind "startSession"})
             (.push @session-requests request)
             (@session-hook request)))
         (fn
           [session Any
            fixed-tick workbench/FixedTick
            configuration workbench/InputConfiguration
            complete Any] Any
           (let [request Any {:session session
                              :fixedTick fixed-tick
                              :configuration configuration
                              :complete complete}]
             (.push @calls {:kind "runCandidate"})
             (.push @candidate-requests request)
             (@candidate-hook request)))
         (fn
           [session Any
            candidate Any
            complete Any] Any
           (let [request Any {:session session
                              :candidate candidate
                              :complete complete}]
             (.push @calls {:kind "requestAdmission"})
             (.push @admission-requests request)
             (@admission-hook request)))
         (fn [session Any] Any
           (do
             (.push @calls {:kind "disposeSession"})
             (.push @disposals session)
             (@disposal-hook session))))
        schedule (Fn [Int (Fn [] Any)] (Fn [] Any)) (fn
                                                      [delay Int
                                                       tick (Fn [] Any)] (Fn [] Any)
                                                      (do
            (reset! scheduled-delay delay)
            (reset! scheduled-tick tick)
            (fn [] Any
              (do
                (swap! cancellations inc)
                (@cancellation-hook)))))
        renderer (Fn [Any] Any) (fn [frame Any] Any
                                  (do
                                    (.push @rendered frame)
                                    (@render-hook frame)))
        receipt-sink (Fn [workbench/LifecycleReceipt] Any) (fn [receipt workbench/LifecycleReceipt] Any
          (do
            (.push @receipts receipt)
            (@receipt-hook receipt)))
        controller Any (workbench/create-cartridge-workbench!
         port
         (workbench/->FixedTick 16)
         policy
         schedule
         renderer
         receipt-sink
         initial-package)]
    {:controller controller
     :calls calls
     :packageRequests package-requests
     :sessionRequests session-requests
     :candidateRequests candidate-requests
     :admissionRequests admission-requests
     :disposals disposals
     :rendered rendered
     :receipts receipts
     :packageHook package-hook
     :renderHook render-hook
     :receiptHook receipt-hook
     :sessionHook session-hook
     :candidateHook candidate-hook
     :admissionHook admission-hook
     :disposalHook disposal-hook
     :cancellationHook cancellation-hook
     :scheduledDelay scheduled-delay
     :scheduledTick scheduled-tick
     :cancellations cancellations}))

(defn fake-fixture! [initial-package Any] Any
  (fake-fixture-with-policy!
   initial-package
   (workbench-policy 8 8)))

(defn bootstrap!
  [fixture Any
   accepted-package Any
   session Any
   revision Any
   frame Any] Any
  (do
    (complete-request!
     (.-packageRequests fixture)
     0
     (workbench/->PackageAccepted accepted-package))
    (complete-request!
     (.-sessionRequests fixture)
     0
     (workbench/->SessionStarted session revision frame))))

(defn tick! [fixture Any] Any
  (@(.-scheduledTick fixture)))

(defn snapshot [fixture Any] Any
  ((.-snapshot (.-controller fixture))))

(defn receipt-events [fixture Any] Any
  (mapv (fn [receipt Any] Any (.-event receipt))
        @(.-receipts fixture)))

(defn event-receipts
  [fixture Any
   event String] Any
  (.filter @(.-receipts fixture)
           (fn [receipt Any] Bool (= event (.-event receipt)))))

(test/test
 "input changes only local configuration; candidate and rejection preserve authority"
 (fn [] Nil
   (let [package-candidate Any (frozen {:opaque "candidate-package"})
         accepted-package Any (frozen {:opaque "accepted-package"})
         session Any (frozen {:opaque "session-0"})
         revision Any (frozen {:opaque "revision-0"})
         initial-frame Any (envelope "frame-0")
         fixture Any (fake-fixture! package-candidate)
         controller Any (.-controller fixture)]
     (bootstrap!
      fixture
      accepted-package
      session
      revision
      initial-frame)
     (expect-true! (= true (.is Object @(.-scheduledDelay fixture) 16)))
     (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "ready")))
     (expect-true! (= true (.is Object (.-length @(.-rendered fixture)) 1)))

     ((.-observeInput controller) (envelope "input-1"))
     (let [configured Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-configurationRevision configured) 2)))
       (expect-true! (= true (.is Object (.-pendingObservations configured) 1)))
       (expect-true! (= true (.is Object (.-revision configured) revision)))
       (expect-true! (= true (.is Object (.-length @(.-admissionRequests fixture)) 0)))
       (expect-true! (= true (.is Object (.-length @(.-rendered fixture)) 1))))

     (tick! fixture)
     (let [candidate-request Any (request-at (.-candidateRequests fixture) 0)
           sent-configuration Any (.-configuration candidate-request)]
       (expect-true! (= true (.is Object (.-session candidate-request) session)))
       (expect-true! (= true (.is Object (.-milliseconds (.-fixedTick candidate-request)) 16)))
       (expect-true! (= true (.is Object (.-revision sent-configuration) 2)))
       (expect-true! (= true (.is Object (count (.-observations sent-configuration)) 1))))

     (let [candidate Any (frozen {:opaque "unadmitted-candidate"
                    :frame (frozen {:opaque "candidate-frame-must-not-render"})})]
       (complete-request!
        (.-candidateRequests fixture)
        0
        (workbench/->CandidateProduced candidate))
       (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "admission")))
       (expect-true! (= true (.is Object (.-candidate
                            (request-at (.-admissionRequests fixture) 0)) candidate)))
       (expect-true! (= true (.is Object (.-revision (snapshot fixture)) revision)))
       (expect-true! (= true (.is Object (.-frame (snapshot fixture)) initial-frame)))
       (expect-true! (= true (.is Object (.-length @(.-rendered fixture)) 1))))

     (complete-request!
      (.-admissionRequests fixture)
      0
      (workbench/->AdmissionRejected "not-admitted"))
     (let [rejected Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-phase rejected) "ready")))
       (expect-true! (= true (.is Object (.-revision rejected) revision)))
       (expect-true! (= true (.is Object (.-frame rejected) initial-frame)))
       (expect-true! (= true (.is Object (.-length @(.-rendered fixture)) 1)))
       (expect-true! (= true (.includes (receipt-events fixture) "admission-rejected")))))))

(test/test
 "fixed ticks consume input into a fresh bounded configuration identity"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package"}))
         controller Any (.-controller fixture)]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     ((.-observeInput controller) (envelope "input"))
     (expect-true! (= true (.is Object (.-configurationRevision (snapshot fixture)) 2)))
     (expect-true! (= true (.is Object (.-pendingObservations (snapshot fixture)) 1)))
     (tick! fixture)
     (let [consumed workbench/InputConfiguration (.-configuration
                                                   (request-at
                                                    (.-candidateRequests fixture)
                                                    0))
           current Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-revision consumed) 2)))
       (expect-true! (= true (.is Object (count (.-observations consumed)) 1)))
       (expect-true! (= true (.is Object (.-configurationRevision current) 3)))
       (expect-true! (= true (.is Object (.-pendingObservations current) 0)))))))

(test/test
 "fixed tick configuration consumption fails before its declared ceiling"
 (fn [] Nil
   (let [maximum Int (.-MAX_SAFE_INTEGER Number)
         fixture Any (fake-fixture-with-policy!
                      (frozen {:opaque "package"})
                      (workbench-policy-with-sequences
                       (sequence-limits maximum maximum maximum maximum 2)))
         controller Any (.-controller fixture)]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     ((.-observeInput controller) (envelope "input"))
     (tick! fixture)
     (let [terminal Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-phase terminal) "disposed")))
       (expect-true! (= true (.is Object (.-configurationRevision terminal) 2)))
       (expect-true! (= true (.is Object (.-pendingObservations terminal) 1)))
       (expect-true! (= true (.is Object (.-length @(.-candidateRequests fixture)) 0)))
       (expect-true! (= true (.is Object (.-detail (nth (event-receipts fixture "counter-exhausted") 0)) "configuration-revision")))))))

(test/test
 "each candidate and admission cycle has one exact operation identity"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         revision-0 Any (frozen {:opaque "revision-0"})
         frame-0 Any (envelope "frame-0")
         successor Any (frozen {:opaque "successor-1"})
         revision-1 Any (frozen {:opaque "revision-1"})
         frame-1 Any (envelope "frame-1")
         candidate-frame Any (frozen {:opaque "not-authoritative"})
         candidate Any (frozen {:frame candidate-frame})]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      revision-0
      frame-0)
     (tick! fixture)
     (let [operation-1 Int (.-operationId (snapshot fixture))]
       (expect-true! (> operation-1 0))
       ((.-reloadPackage controller) (frozen {:opaque "interrupting-package"}))
       (complete-request!
        (.-packageRequests fixture)
        1
        (workbench/->PackageRejected "interrupt-only"))
       (tick! fixture)
       (let [operation-2 Int (.-operationId (snapshot fixture))]
         (expect-true! (> operation-2 operation-1))
         (expect-true! (= true (.is Object (.-session (request-at (.-candidateRequests fixture) 1)) session-0)))
         (complete-request!
          (.-candidateRequests fixture)
          0
          (workbench/->CandidateProduced
           (frozen {:opaque "stale-candidate"})))
         (expect-true! (= true (.is Object (.-operationId (snapshot fixture)) operation-2)))
         (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "candidate")))
         (expect-true! (= true (.is Object (.-length @(.-admissionRequests fixture)) 0)))
         (let [stale Any (event-receipts fixture "completion-stale")]
           (expect-true! (= true (.is Object (count stale) 1)))
           (expect-true! (= true (.is Object (.-operationId (nth stale 0)) operation-1))))

         (complete-request!
          (.-candidateRequests fixture)
          1
          (workbench/->CandidateProduced candidate))
         (complete-request!
          (.-candidateRequests fixture)
          1
          (workbench/->CandidateProduced
           (frozen {:opaque "duplicate-candidate"})))
         (expect-true! (= true (.is Object (.-length @(.-admissionRequests fixture)) 1)))
         (complete-request!
          (.-admissionRequests fixture)
          0
          (workbench/->AdmissionAccepted successor revision-1 frame-1))
         (complete-request!
          (.-admissionRequests fixture)
          0
          (workbench/->AdmissionAccepted
           (frozen {:opaque "duplicate-successor"})
           (frozen {:opaque "duplicate-revision"})
           (envelope "duplicate-frame")))
         (let [advanced Any (snapshot fixture)]
           (expect-true! (= true (.is Object (.-operationId advanced) 0)))
           (expect-true! (= true (.is Object (.-revision advanced) revision-1)))
           (expect-true! (= true (.is Object (.-frame advanced) frame-1)))
           (expect-true! (= @(.-rendered fixture) [frame-0 frame-1]))
           (expect-true! (= true (.is Object (.includes @(.-rendered fixture) candidate-frame) false))))
         (expect-true! (= @(.-disposals fixture) []))
         (let [requested Any (event-receipts fixture "candidate-requested")]
           (expect-true! (= (mapv (fn [receipt Any] Any (.-operationId receipt)) requested) [operation-1 operation-2])))
         (let [rendered-receipts Any (event-receipts fixture "frame-rendered")]
           (expect-true! (= true (.is Object (.-operationId (nth rendered-receipts 1)) operation-2))))))
     (doseq [receipt Any @(.-receipts fixture)]
       (expect-true! (= true (.is Object (.-schema receipt) "clause-cartridge-workbench/v1")))))))

(test/test
 "failed reload keeps the old session; accepted reload is fresh and generation-fenced"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         revision-0 Any (frozen {:opaque "revision-0"})
         frame-0 Any (envelope "frame-0")]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      revision-0
      frame-0)

     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageRejected "package-denied"))
     (expect-true! (= true (.is Object (.-revision (snapshot fixture)) revision-0)))
     (expect-true! (= true (.is Object (.-frame (snapshot fixture)) frame-0)))
     (expect-true! (= true (.is Object (.-length @(.-disposals fixture)) 0)))

     ((.-reloadPackage controller) (frozen {:opaque "package-c"}))
     (let [accepted-c Any (frozen {:opaque "accepted-c"})]
       (complete-request!
        (.-packageRequests fixture)
        2
        (workbench/->PackageAccepted accepted-c))
       (expect-true! (= true (.is Object (.-package
                            (request-at (.-sessionRequests fixture) 1)) accepted-c))))
     (complete-request!
      (.-sessionRequests fixture)
      1
      (workbench/->SessionFailed "runtime-start-failed"))
     (expect-true! (= true (.is Object (.-revision (snapshot fixture)) revision-0)))
     (expect-true! (= true (.is Object (.-frame (snapshot fixture)) frame-0)))
     (expect-true! (= true (.is Object (.-length @(.-disposals fixture)) 0)))

     (tick! fixture)
     (complete-request!
      (.-candidateRequests fixture)
      0
      (workbench/->CandidateProduced (frozen {:opaque "old-candidate"})))
     (expect-true! (= true (.is Object (.-length @(.-admissionRequests fixture)) 1)))

     ((.-observeInput controller) (envelope "not-migrated"))
     ((.-reloadPackage controller) (frozen {:opaque "package-d"}))
     (let [accepted-d Any (frozen {:opaque "accepted-d"})
           session-1 Any (frozen {:opaque "session-1"})
           revision-1 Any (frozen {:opaque "revision-1"})
           frame-1 Any (envelope "frame-1")]
       (complete-request!
        (.-packageRequests fixture)
        3
        (workbench/->PackageAccepted accepted-d))
       (let [fresh-request Any (request-at (.-sessionRequests fixture) 2)]
         (expect-true! (= true (.is Object (.-package fresh-request) accepted-d)))
         (expect-true! (= true (.is Object (.-generation fresh-request) 4))))
       (complete-request!
        (.-sessionRequests fixture)
        2
        (workbench/->SessionStarted session-1 revision-1 frame-1))
       (let [reloaded Any (snapshot fixture)]
         (expect-true! (= true (.is Object (.-generation reloaded) 4)))
         (expect-true! (= true (.is Object (.-revision reloaded) revision-1)))
         (expect-true! (= true (.is Object (.-frame reloaded) frame-1)))
         (expect-true! (= true (.is Object (.-pendingObservations reloaded) 0)))
         (expect-true! (= @(.-rendered fixture) [frame-0 frame-1]))
         (expect-true! (= @(.-disposals fixture) [session-0])))

       (complete-request!
        (.-admissionRequests fixture)
        0
        (workbench/->AdmissionAccepted
         (frozen {:opaque "stale-successor"})
         (frozen {:opaque "stale-revision"})
         (frozen {:opaque "stale-frame"})))
       (expect-true! (= true (.is Object (.-revision (snapshot fixture)) revision-1)))
       (expect-true! (= @(.-rendered fixture) [frame-0 frame-1]))
       (expect-true! (= true (.includes (receipt-events fixture) "completion-stale")))))))

(test/test
 "reload rejects the currently live RuntimeSession without disposing it"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         controller Any (.-controller fixture)
         session Any (frozen {:opaque "session-0"})
         revision Any (frozen {:opaque "revision-0"})
         frame Any (envelope "frame-0")]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session
      revision
      frame)
     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "accepted-b"})))
     (complete-request!
      (.-sessionRequests fixture)
      1
      (workbench/->SessionStarted
       session
       (frozen {:opaque "revision-reused"})
       (frozen {:opaque "frame-reused"})))
     (let [rejected Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-phase rejected) "ready")))
       (expect-true! (= true (.is Object (.-generation rejected) 1)))
       (expect-true! (= true (.is Object (.-revision rejected) revision)))
       (expect-true! (= true (.is Object (.-frame rejected) frame)))
       (expect-true! (= @(.-rendered fixture) [frame]))
       (expect-true! (= @(.-disposals fixture) []))
       (expect-true! (= true (.includes (receipt-events fixture) "session-reused")))))))

(test/test
 "reload rejects every retired RuntimeSession identity"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         session-1 Any (frozen {:opaque "session-1"})
         revision-1 Any (frozen {:opaque "revision-1"})
         frame-0 Any (envelope "frame-0")
         frame-1 Any (envelope "frame-1")]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      frame-0)
     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "accepted-b"})))
     (complete-request!
      (.-sessionRequests fixture)
      1
      (workbench/->SessionStarted session-1 revision-1 frame-1))
     (expect-true! (= @(.-disposals fixture) [session-0]))

     ((.-reloadPackage controller) (frozen {:opaque "package-c"}))
     (complete-request!
      (.-packageRequests fixture)
      2
      (workbench/->PackageAccepted (frozen {:opaque "accepted-c"})))
     (complete-request!
      (.-sessionRequests fixture)
      2
      (workbench/->SessionStarted
       session-0
       (frozen {:opaque "retired-revision"})
       (frozen {:opaque "retired-frame"})))
     (let [rejected Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-phase rejected) "ready")))
       (expect-true! (= true (.is Object (.-generation rejected) 2)))
       (expect-true! (= true (.is Object (.-revision rejected) revision-1)))
       (expect-true! (= true (.is Object (.-frame rejected) frame-1)))
       (expect-true! (= @(.-rendered fixture) [frame-0 frame-1]))
       (expect-true! (= @(.-disposals fixture) [session-0]))
       (expect-true! (= true (.includes (receipt-events fixture) "session-retired")))))))

(test/test
 "a pending RuntimeSession start rejects an overlapping reload"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         session-1 Any (frozen {:opaque "session-1"})
         revision-1 Any (frozen {:opaque "revision-1"})
         frame-0 Any (envelope "frame-0")
         frame-1 Any (envelope "frame-1")]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      frame-0)
     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "accepted-b"})))

     (expect-true! (= true (.is Object ((.-reloadPackage controller) (frozen {:opaque "package-c"})) false)))
     (expect-true! (= true (.is Object (.-length @(.-packageRequests fixture)) 2)))
     (expect-true! (= true (.is Object (.-length @(.-sessionRequests fixture)) 2)))
     (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "session-start")))
     (expect-true! (= true (.is Object (count (event-receipts fixture "reload-rejected")) 1)))

     (complete-request!
      (.-sessionRequests fixture)
      1
      (workbench/->SessionStarted session-1 revision-1 frame-1))
     (expect-true! (= @(.-disposals fixture) [session-0]))
     (let [live Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-phase live) "ready")))
       (expect-true! (= true (.is Object (.-revision live) revision-1)))
       (expect-true! (= true (.is Object (.-frame live) frame-1)))
       (expect-true! (= @(.-rendered fixture) [frame-0 frame-1]))
       (expect-true! (= @(.-disposals fixture) [session-0]))))))

(test/test
 "session settlement receipts can serialize the next reload"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         session-1 Any (frozen {:opaque "session-1"})
         revision-1 Any (frozen {:opaque "revision-1"})
         frame-0 Any (envelope "frame-0")
         frame-1 Any (envelope "frame-1")
         package-c Any (frozen {:opaque "package-c"})
         package-d Any (frozen {:opaque "package-d"})
         started-reload (Atom Bool) (atom false)
         failed-reload (Atom Bool) (atom false)]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      frame-0)
     (reset! (.-receiptHook fixture)
             (fn [receipt Any] Any
               (when (= (.-event receipt) "session-started")
                 (reset! started-reload
                         ((.-reloadPackage controller) package-c)))))
     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "accepted-b"})))
     (complete-request!
      (.-sessionRequests fixture)
      1
      (workbench/->SessionStarted session-1 revision-1 frame-1))
     (expect-true! (= true (.is Object @started-reload true)))
     (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "package-check")))
     (expect-true! (= true (.is Object (.-length @(.-packageRequests fixture)) 3)))
     (expect-true! (= true (.is Object (.-package (request-at (.-packageRequests fixture) 2)) package-c)))
     (expect-true! (= true (.is Object (.-revision (snapshot fixture)) revision-1)))
     (expect-true! (= @(.-disposals fixture) [session-0]))

     (reset! (.-receiptHook fixture)
             (fn [receipt Any] Any
               (when (= (.-event receipt) "session-failed")
                 (reset! failed-reload
                         ((.-reloadPackage controller) package-d)))))
     (complete-request!
      (.-packageRequests fixture)
      2
      (workbench/->PackageAccepted (frozen {:opaque "accepted-c"})))
     (complete-request!
      (.-sessionRequests fixture)
      2
      (workbench/->SessionFailed "start-c-failed"))
     (expect-true! (= true (.is Object @failed-reload true)))
     (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "package-check")))
     (expect-true! (= true (.is Object (.-length @(.-packageRequests fixture)) 4)))
     (expect-true! (= true (.is Object (.-package (request-at (.-packageRequests fixture) 3)) package-d)))
     (complete-request!
      (.-packageRequests fixture)
      3
      (workbench/->PackageRejected "stop"))
     (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "ready")))
     (expect-true! (= true (.is Object (.-revision (snapshot fixture)) revision-1))))))

(test/test
