     (expect-true! (= @(.-disposals fixture) [session-0])))))

(test/test
 "pending input is rejected visibly at its declared finite bound"
 (fn [] Nil
   (let [fixture Any (fake-fixture-with-policy!
                      (frozen {:opaque "package"})
                      (workbench-policy 2 8))
         controller Any (.-controller fixture)
         input-1 Any (envelope "input-1")
         input-2 Any (envelope "input-2")
         input-3 Any (envelope "input-3")]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     (tick! fixture)
     ((.-observeInput controller) input-1)
     ((.-observeInput controller) input-2)
     ((.-observeInput controller) input-3)
     (let [bounded Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-pendingObservations bounded) 2)))
       (expect-true! (= true (.is Object (count (event-receipts fixture "configuration-observed")) 2)))
       (expect-true! (= true (.is Object (count (event-receipts fixture
                                      "configuration-input-rejected")) 1))))
     (complete-request!
      (.-candidateRequests fixture)
      0
      (workbench/->CandidateFailed "cycle-held"))
     (tick! fixture)
     (let [configuration Any (.-configuration
                              (request-at (.-candidateRequests fixture) 1))
           observations Any (.-observations configuration)]
       (expect-true! (= true (.is Object (count observations) 2)))
       (expect-true! (= true (.is Object (.-value (nth observations 0)) input-1)))
       (expect-true! (= true (.is Object (.-value (nth observations 1)) input-2)))))))

(test/test
 "reentrant input reserves capacity before serialized transition admission"
 (fn [] Nil
   (let [fixture Any (fake-fixture-with-policy!
                      (frozen {:opaque "package"})
                      (workbench-policy 2 8))
         controller Any (.-controller fixture)
         reentered (Atom Bool) (atom false)]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     (tick! fixture)
     (reset! (.-receiptHook fixture)
             (fn [receipt Any] Any
               (when (and (= (.-event receipt) "configuration-observed")
                          (not @reentered))
                 (reset! reentered true)
                 (expect-true! (= true (.is Object ((.-observeInput controller) (envelope "input-2")) true)))
                 (doseq [index Int (range 8)]
                   (expect-true! (= true (.is Object ((.-observeInput controller) (envelope index)) false)))))))
     (expect-true! (= true (.is Object ((.-observeInput controller) (envelope "input-1")) true)))
     (let [bounded Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-pendingObservations bounded) 2)))
       (expect-true! (= true (.is Object (count (event-receipts fixture "configuration-observed")) 2)))
       (expect-true! (= true (.is Object (count (event-receipts fixture "configuration-input-rejected")) 1))))
     (complete-request!
      (.-candidateRequests fixture)
      0
      (workbench/->CandidateFailed "cycle-held"))
     (tick! fixture)
     (let [configuration Any (.-configuration
                              (request-at (.-candidateRequests fixture) 1))]
       (expect-true! (= true (.is Object (count (.-observations configuration)) 2)))))))

(test/test
 "receipt-triggered disposal remains terminal after in-progress installation"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package"}))
         controller Any (.-controller fixture)
         session Any (frozen {:opaque "session"})
         frame Any (envelope "frame")
         disposal-results Any (atom [])]
     (reset! (.-receiptHook fixture)
             (fn [receipt Any] Any
               (when (= (.-event receipt) "session-started")
                 (doseq [_index Int (range 32)]
                   (.push @disposal-results
                          ((.-dispose controller))))
                 (throw (new Error "receipt-sink-failed")))))
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      session
      (frozen {:opaque "revision"})
      frame)
     (let [terminal Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-phase terminal) "disposed")))
       (expect-true! (= true (.is Object (.-disposed terminal) true)))
       (expect-true! (= @(.-rendered fixture) [frame]))
       (expect-true! (= @(.-disposals fixture) [session]))
       (expect-true! (= true (.is Object (count (.filter @disposal-results
                         (fn [accepted Any] Bool (= accepted true)))) 1)))
       (expect-true! (= true (.is Object @(.-cancellations fixture) 1)))
       (expect-true! (= true (.is Object (count (event-receipts fixture "disposed")) 1)))))))

(test/test
 "render-triggered reload survives the in-progress render transition"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         controller Any (.-controller fixture)
         triggered (Atom Bool) (atom false)
         session-0 Any (frozen {:opaque "session-0"})
         frame-0 Any (envelope "frame-0")
         package-1 Any (frozen {:opaque "package-b"})
         reload-results Any (atom [])]
     (reset! (.-renderHook fixture)
             (fn [_frame Any] Any
               (when (not @triggered)
                 (reset! triggered true)
                 (doseq [_index Int (range 32)]
                   (.push @reload-results
                          ((.-reloadPackage controller) package-1)))
                 (throw (new Error "renderer-failed-after-reload")))))
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      frame-0)
     (expect-true! (= true (.is Object (count (.filter @reload-results
                       (fn [accepted Any] Bool (= accepted true)))) 1)))
     (expect-true! (= true (.is Object (.-length @(.-packageRequests fixture)) 2)))
     (expect-true! (= true (.is Object (.-package (request-at (.-packageRequests fixture) 1)) package-1)))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "accepted-b"})))
     (let [session-1 Any (frozen {:opaque "session-1"})
           revision-1 Any (frozen {:opaque "revision-1"})
           frame-1 Any (envelope "frame-1")]
       (complete-request!
        (.-sessionRequests fixture)
        1
        (workbench/->SessionStarted session-1 revision-1 frame-1))
       (let [reloaded Any (snapshot fixture)]
         (expect-true! (= true (.is Object (.-phase reloaded) "ready")))
         (expect-true! (= true (.is Object (.-revision reloaded) revision-1)))
         (expect-true! (= true (.is Object (.-frame reloaded) frame-1)))
         (expect-true! (= @(.-rendered fixture) [frame-0 frame-1]))
         (expect-true! (= @(.-disposals fixture) [session-0])))))))

(test/test
 "receipt-triggered fixed ticks retain only one pending transition"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package"}))
         reentrant-results Any (atom [])
         reentered (Atom Bool) (atom false)]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     (reset! (.-receiptHook fixture)
             (fn [receipt Any] Any
               (when (and (= (.-event receipt) "candidate-requested")
                          (not @reentered))
                 (reset! reentered true)
                 (doseq [_index Int (range 32)]
                   (.push @reentrant-results
                          (tick! fixture))))))
     (expect-true! (= true (.is Object (tick! fixture) true)))
     (expect-true! (= true (.is Object (count (.filter @reentrant-results
                       (fn [accepted Any] Bool (= accepted true)))) 1)))
     (expect-true! (= true (.is Object (.-length @(.-candidateRequests fixture)) 1)))
     (complete-request!
      (.-candidateRequests fixture)
      0
      (workbench/->CandidateFailed "cycle-held"))
     (expect-true! (= true (.is Object (tick! fixture) true)))
     (expect-true! (= true (.is Object (.-length @(.-candidateRequests fixture)) 2))))))

(test/test
 "renderer failure is visible without revoking installed authority"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         session-0 Any (frozen {:opaque "session-0"})
         revision-1 Any (frozen {:opaque "revision-1"})
         frame-0 Any (envelope "frame-0")
         frame-1 Any (envelope "frame-1")]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      frame-0)
     (reset! (.-renderHook fixture)
             (fn [frame Any] Any
               (when (identical? frame frame-1)
                 (throw (new Error "renderer-failed")))))
     (tick! fixture)
     (let [operation-id Int (.-operationId (snapshot fixture))]
       (complete-request!
        (.-candidateRequests fixture)
        0
        (workbench/->CandidateProduced (frozen {:opaque "candidate"})))
       (complete-request!
        (.-admissionRequests fixture)
        0
        (workbench/->AdmissionAccepted
         (frozen {:opaque "successor"})
         revision-1
         frame-1))
       (let [installed Any (snapshot fixture)
             failed-receipts Any (event-receipts fixture
                                                  "frame-render-failed")]
         (expect-true! (= true (.is Object (.-phase installed) "ready")))
         (expect-true! (= true (.is Object (.-generation installed) 1)))
         (expect-true! (= true (.is Object (.-revision installed) revision-1)))
         (expect-true! (= true (.is Object (.-frame installed) frame-1)))
         (expect-true! (= @(.-rendered fixture) [frame-0 frame-1]))
         (expect-true! (= @(.-disposals fixture) []))
         (expect-true! (= true (.is Object (count failed-receipts) 1)))
         (expect-true! (= true (.is Object (.-operationId (nth failed-receipts 0)) operation-id))))))))

(test/test
 "synchronous completion wins when every port throws afterward"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         session-1 Any (frozen {:opaque "session-1"})
         revision-1 Any (frozen {:opaque "revision-1"})
         revision-2 Any (frozen {:opaque "revision-2"})
         frame-1 Any (envelope "frame-1")
         frame-2 Any (envelope "frame-2")]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      (envelope "frame-0"))
     (reset! (.-packageHook fixture)
             (fn [request Any] Any
               ((.-complete request)
                (workbench/->PackageAccepted
                 (frozen {:opaque "accepted-b"})))
               (throw (new Error "package-threw-after-callback"))))
     (reset! (.-sessionHook fixture)
             (fn [request Any] Any
               ((.-complete request)
                (workbench/->SessionStarted session-1 revision-1 frame-1))
               (throw (new Error "session-threw-after-callback"))))
     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (expect-true! (= true (.is Object (.-revision (snapshot fixture)) revision-1)))

     (reset! (.-candidateHook fixture)
             (fn [request Any] Any
               ((.-complete request)
                (workbench/->CandidateProduced
                 (frozen {:opaque "candidate"})))
               (throw (new Error "candidate-threw-after-callback"))))
     (reset! (.-admissionHook fixture)
             (fn [request Any] Any
               ((.-complete request)
                (workbench/->AdmissionAccepted
                 (frozen {:opaque "successor"})
                 revision-2
                 frame-2))
               (throw (new Error "admission-threw-after-callback"))))
     (tick! fixture)
     (let [settled Any (snapshot fixture)]
       (expect-true! (= true (.is Object (.-phase settled) "ready")))
       (expect-true! (= true (.is Object (.-revision settled) revision-2)))
       (expect-true! (= true (.is Object (.-frame settled) frame-2)))
       (expect-true! (= @(.-disposals fixture) [session-0]))
       (doseq [event String ["package-boundary-failed"
                             "session-boundary-failed"
                             "candidate-boundary-failed"
                             "admission-boundary-failed"]]
         (expect-true! (= true (.is Object (count (event-receipts fixture event)) 0))))))))

(test/test
 "port throws before completion restore authority and contain late callbacks"
 (fn [] Nil
   (let [package-fixture Any (fake-fixture! (frozen {:opaque "package-a"}))
         package-session Any (frozen {:opaque "package-session"})
         package-revision Any (frozen {:opaque "package-revision"})
         package-frame Any (envelope "package-frame")
         session-fixture Any (fake-fixture! (frozen {:opaque "session-package"}))
         session-0 Any (frozen {:opaque "session-0"})
         late-session Any (frozen {:opaque "late-session"})
         session-revision Any (frozen {:opaque "session-revision"})
         session-frame Any (envelope "session-frame")
         candidate-fixture Any (fake-fixture! (frozen {:opaque "candidate-package"}))
         candidate-revision Any (frozen {:opaque "candidate-revision"})
         candidate-frame Any (envelope "candidate-frame")
         admission-fixture Any (fake-fixture! (frozen {:opaque "admission-package"}))
         admission-revision Any (frozen {:opaque "admission-revision"})
         admission-frame Any (envelope "admission-frame")]
     (bootstrap!
      package-fixture
      (frozen {:opaque "package-accepted"})
      package-session
      package-revision
      package-frame)
     (reset! (.-packageHook package-fixture)
             (fn [_request Any] Any
               (throw (new Error "package-boundary"))))
     ((.-reloadPackage (.-controller package-fixture))
      (frozen {:opaque "package-b"}))
     (expect-true! (= true (.is Object (.-phase (snapshot package-fixture)) "ready")))
     (expect-true! (= true (.is Object (count (event-receipts package-fixture "package-boundary-failed")) 1)))
     (complete-request!
      (.-packageRequests package-fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "late-package"})))
     (expect-true! (= true (.is Object (.-length @(.-sessionRequests package-fixture)) 1)))

     (bootstrap!
      session-fixture
      (frozen {:opaque "session-accepted"})
      session-0
      session-revision
      session-frame)
     (reset! (.-sessionHook session-fixture)
             (fn [_request Any] Any
               (throw (new Error "session-boundary"))))
     ((.-reloadPackage (.-controller session-fixture))
      (frozen {:opaque "session-package-b"}))
     (complete-request!
      (.-packageRequests session-fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "session-accepted-b"})))
     (expect-true! (= true (.is Object (.-phase (snapshot session-fixture)) "ready")))
     (expect-true! (= true (.is Object (count (event-receipts session-fixture "session-boundary-failed")) 1)))
     (complete-request!
      (.-sessionRequests session-fixture)
      1
      (workbench/->SessionStarted
       late-session
       (frozen {:opaque "late-revision"})
       (envelope "late-frame")))
     (expect-true! (= true (.is Object (.-revision (snapshot session-fixture)) session-revision)))
     (expect-true! (= @(.-disposals session-fixture) [late-session]))

     (bootstrap!
      candidate-fixture
      (frozen {:opaque "candidate-accepted"})
      (frozen {:opaque "candidate-session"})
      candidate-revision
      candidate-frame)
     (reset! (.-candidateHook candidate-fixture)
             (fn [_request Any] Any
               (throw (new Error "candidate-boundary"))))
     (tick! candidate-fixture)
     (expect-true! (= true (.is Object (count (event-receipts candidate-fixture
                              "candidate-boundary-failed")) 1)))
     (complete-request!
      (.-candidateRequests candidate-fixture)
      0
      (workbench/->CandidateProduced (frozen {:opaque "late-candidate"})))
     (expect-true! (= true (.is Object (.-length @(.-admissionRequests candidate-fixture)) 0)))

     (bootstrap!
      admission-fixture
      (frozen {:opaque "admission-accepted"})
      (frozen {:opaque "admission-session"})
      admission-revision
      admission-frame)
     (tick! admission-fixture)
     (reset! (.-admissionHook admission-fixture)
             (fn [_request Any] Any
               (throw (new Error "admission-boundary"))))
     (complete-request!
      (.-candidateRequests admission-fixture)
      0
      (workbench/->CandidateProduced (frozen {:opaque "candidate"})))
     (expect-true! (= true (.is Object (count (event-receipts admission-fixture
                              "admission-boundary-failed")) 1)))
     (complete-request!
      (.-admissionRequests admission-fixture)
      0
      (workbench/->AdmissionAccepted
       (frozen {:opaque "late-successor"})
       (frozen {:opaque "late-revision"})
       (envelope "late-frame")))
     (expect-true! (= true (.is Object (.-revision (snapshot admission-fixture)) admission-revision))))))

(test/test
 "throwing RuntimeSession starts retain bounded identity custody"
 (fn [] Nil
   (let [fixture Any (fake-fixture-with-policy!
                      (frozen {:opaque "package-a"})
                      (workbench-policy 8 3))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         session-1 Any (frozen {:opaque "session-1"})
         session-2 Any (frozen {:opaque "session-2"})]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      (envelope "frame-0"))
     (reset! (.-sessionHook fixture)
             (fn [_request Any] Any
               (throw (new Error "session-boundary"))))

     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "accepted-b"})))
     ((.-reloadPackage controller) (frozen {:opaque "package-c"}))
     (complete-request!
      (.-packageRequests fixture)
      2
      (workbench/->PackageAccepted (frozen {:opaque "accepted-c"})))

     ((.-reloadPackage controller) (frozen {:opaque "package-d"}))
     (complete-request!
      (.-packageRequests fixture)
      3
      (workbench/->PackageAccepted (frozen {:opaque "accepted-d"})))
     (expect-true! (= true (.is Object (.-length @(.-sessionRequests fixture)) 3)))
     (expect-true! (= true (.is Object (count (event-receipts fixture "session-boundary-failed")) 2)))
     (expect-true! (= true (.is Object (count (event-receipts fixture "session-identity-limit")) 1)))

     (complete-request!
      (.-sessionRequests fixture)
      1
      (workbench/->SessionStarted
       session-1
       (frozen {:opaque "late-revision-1"})
       (envelope "late-frame-1")))
     (complete-request!
      (.-sessionRequests fixture)
      2
      (workbench/->SessionStarted
       session-2
       (frozen {:opaque "late-revision-2"})
       (envelope "late-frame-2")))
     (expect-true! (= @(.-disposals fixture) [session-1 session-2]))
     (expect-true! (= true (.is Object (.-generation (snapshot fixture)) 1))))))

(test/test
 "cancellation and session-disposal throws cannot escape terminal disposal"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package"}))
         controller Any (.-controller fixture)
         session Any (frozen {:opaque "session"})
         tick-results Any (atom [])]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      session
      (frozen {:opaque "revision"})
      (envelope "frame"))
     (reset! (.-cancellationHook fixture)
             (fn [] Any
               (.push @tick-results (tick! fixture))
               (throw (new Error "cancel-failed"))))
     (reset! (.-disposalHook fixture)
             (fn [_session Any] Any
               (.push @tick-results (tick! fixture))
               (throw (new Error "dispose-failed"))))
     (expect-true! (= true (.is Object ((.-dispose controller)) true)))
     (let [terminal Any (snapshot fixture)
           disposed-receipts Any (event-receipts fixture "disposed")]
       (expect-true! (= true (.is Object (.-phase terminal) "disposed")))
       (expect-true! (= true (.is Object (.-disposed terminal) true)))
       (expect-true! (= @tick-results [false false]))
       (expect-true! (= true (.is Object @(.-cancellations fixture) 1)))
       (expect-true! (= @(.-disposals fixture) [session]))
       (expect-true! (= true (.is Object (.-length @(.-candidateRequests fixture)) 0)))
       (expect-true! (= true (.is Object (count disposed-receipts) 1)))
       (expect-true! (= true (.is Object (.-detail (nth disposed-receipts 0)) "terminal-cancel-and-disposal-uncertain")))))))

(test/test
 "a throwing fixed-tick scheduler yields an inert terminal controller"
 (fn [] Nil
   (let [package-calls (Atom Int) (atom 0)
         retained-tick Any (atom (fn [] Any false))
         receipts Any (atom [])
         port workbench/CartridgePort (workbench/->CartridgePort
          (fn
            [_package Any
             _complete Any] Any
            (swap! package-calls inc))
          (fn
            [_package Any
             _generation Int
             _complete Any] Any
            nil)
          (fn
            [_session Any
             _tick workbench/FixedTick
             _configuration workbench/InputConfiguration
             _complete Any] Any
            nil)
          (fn
            [_session Any
             _candidate Any
             _complete Any] Any
            nil)
          (fn [_session Any] Any nil))
         controller Any (workbench/create-cartridge-workbench!
          port
          (workbench/->FixedTick 16)
          (workbench-policy 8 8)
          (fn
            [_delay Int
             tick (Fn [] Any)] (Fn [] Any)
            (do
              (reset! retained-tick tick)
              (throw (new Error "scheduler-failed"))))
          (fn [_frame Any] Any nil)
          (fn [receipt workbench/LifecycleReceipt] Any
            (.push @receipts receipt))
          (frozen {:opaque "package"}))]
     (let [terminal Any ((.-snapshot controller))]
       (expect-true! (= true (.is Object (.-phase terminal) "disposed")))
       (expect-true! (= true (.is Object (.-disposed terminal) true)))
       (expect-true! (= true (.is Object @package-calls 0)))
       (expect-true! (= true (.is Object (@retained-tick) false)))
       (expect-true! (= true (.is Object ((.-dispose controller)) false)))
       (expect-true! (= true (.is Object (.-event (nth @receipts 0)) "fixed-tick-schedule-uncertain")))))))

(test/test
 "frames require bounded generic deep immutability"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package"}))
         revision-0 Any (frozen {:opaque "revision-0"})
         frame-0 Any (envelope "frame-0")
         source Any [["envelope" ["token" "stable"]]]
         deep-frame Any (envelope-tree source)
         shallow-frame Any (frozen {:envelope {:token "mutable"}})]
     (.defineProperty Object
                      (nth (nth source 0) 1)
                      1
                      {:configurable true
                       :enumerable true
                       :value "source-mutated"
                       :writable true})
     (expect-true! (= true (.is Object (nth (nth (nth deep-frame 0) 1) 1) "stable")))
     (expect-true! (= true (.is Object (.getPrototypeOf Object deep-frame) nil)))
     (expect-true! (= true (.is Object (.getPrototypeOf Object (nth deep-frame 0)) nil)))
     (expect-true! (= true (.is Object (.isFrozen Object deep-frame) true)))
     (expect-true! (expect-throws? (fn [] Any
         (.defineProperty Object
                          deep-frame
                          0
                          {:configurable true
                           :enumerable true
                           :value "forged"
                           :writable true}))))
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      revision-0
      frame-0)
     (tick! fixture)
     (complete-request!
      (.-candidateRequests fixture)
      0
      (workbench/->CandidateProduced (frozen {:opaque "candidate-1"})))
     (complete-request!
      (.-admissionRequests fixture)
      0
      (workbench/->AdmissionAccepted
       (frozen {:opaque "successor-1"})
       (frozen {:opaque "revision-1"})
       deep-frame))
     (expect-true! (= true (.is Object (.-frame (snapshot fixture)) deep-frame)))

     (tick! fixture)
     (complete-request!
      (.-candidateRequests fixture)
      1
      (workbench/->CandidateProduced (frozen {:opaque "candidate-2"})))
     (complete-request!
      (.-admissionRequests fixture)
      1
      (workbench/->AdmissionAccepted
       (frozen {:opaque "successor-2"})
       (frozen {:opaque "revision-2"})
       shallow-frame))
     (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "ready")))
     (expect-true! (= true (.is Object (.-frame (snapshot fixture)) deep-frame)))
     (expect-true! (= @(.-rendered fixture) [frame-0 deep-frame]))
     (expect-true! (= true (.includes (receipt-events fixture) "admission-frame-rejected")))

     (let [forged Any (new Array 1)
           _forged-value Any (.defineProperty Object
                                                forged
                                                0
                                                {:configurable true
                                                 :enumerable true
                                                 :value "unmeasured"
                                                 :writable true})
           _forged-prototype Any (.setPrototypeOf Object forged nil)
           _forged-frozen Any (.freeze Object forged)
           bounded Any (fake-fixture-with-policy!
                        (frozen {:opaque "bounded-package"})
                        (workbench/->WorkbenchPolicy
                         8 8 1 8 512 (default-sequence-limits)))
           bounded-properties Any (fake-fixture-with-policy!
                                   (frozen {:opaque "property-package"})
                                   (workbench/->WorkbenchPolicy
                                    8 8 32 2 512 (default-sequence-limits)))
           bounded-source Any (fake-fixture-with-policy!
                               (frozen {:opaque "source-package"})
                               (workbench/->WorkbenchPolicy
                                8 8 32 128 8 (default-sequence-limits)))
           forged-fixture Any (fake-fixture! (frozen {:opaque "forged-package"}))
           custom-prototype-frame Any (.freeze Object
                                               (.create Object
                                                        {:inherited "mutable"}))
           custom-prototype Any (fake-fixture! (frozen {:opaque "custom-prototype-package"}))
           holey-frame Any (.freeze Object (new Array 1))
           holey Any (fake-fixture! (frozen {:opaque "holey-package"}))]
       (bootstrap!
        bounded
        (frozen {:opaque "bounded-accepted"})
        (frozen {:opaque "bounded-session"})
        (frozen {:opaque "bounded-revision"})
        deep-frame)
       (expect-true! (= true (.is Object (.-phase (snapshot bounded)) "idle")))
       (expect-true! (= @(.-rendered bounded) []))
       (expect-true! (= true (.includes (receipt-events bounded) "session-frame-rejected")))

       (bootstrap!
        bounded-properties
        (frozen {:opaque "property-accepted"})
        (frozen {:opaque "property-session"})
        (frozen {:opaque "property-revision"})
        deep-frame)
       (expect-true! (= true (.is Object (.-phase (snapshot bounded-properties)) "idle")))
       (expect-true! (= @(.-rendered bounded-properties) []))

       (bootstrap!
        bounded-source
        (frozen {:opaque "source-accepted"})
        (frozen {:opaque "source-session"})
        (frozen {:opaque "source-revision"})
        deep-frame)
       (expect-true! (= true (.is Object (.-phase (snapshot bounded-source)) "idle")))
       (expect-true! (= @(.-rendered bounded-source) []))

       (bootstrap!
        forged-fixture
        (frozen {:opaque "forged-accepted"})
        (frozen {:opaque "forged-session"})
        (frozen {:opaque "forged-revision"})
        forged)
       (expect-true! (= true (.is Object (.-phase (snapshot forged-fixture)) "idle")))
       (expect-true! (= @(.-rendered forged-fixture) []))
       (expect-true! (expect-throws? (fn [] Any
           ((.-observeInput (.-controller forged-fixture)) forged))))

       (bootstrap!
        custom-prototype
        (frozen {:opaque "custom-prototype-accepted"})
        (frozen {:opaque "custom-prototype-session"})
        (frozen {:opaque "custom-prototype-revision"})
        custom-prototype-frame)
       (expect-true! (= true (.is Object (.-phase (snapshot custom-prototype)) "idle")))
       (expect-true! (= @(.-rendered custom-prototype) []))

       (bootstrap!
        holey
        (frozen {:opaque "holey-accepted"})
        (frozen {:opaque "holey-session"})
        (frozen {:opaque "holey-revision"})
        holey-frame)
       (expect-true! (= true (.is Object (.-phase (snapshot holey)) "idle")))
       (expect-true! (= @(.-rendered holey) [])))

     (expect-true! (expect-throws? (fn [] Any
         (workbench/create-workbench-envelope
          (workbench/->WorkbenchPolicy
           8 8 8 4 64 (default-sequence-limits))
          "[0,0,0,0,0]"))))
     (expect-true! (expect-throws? (fn [] Any
         (workbench/create-workbench-envelope
          (workbench/->WorkbenchPolicy
           8 8 1 8 64 (default-sequence-limits))
          "[[\"nested\"]]"))))

     (.defineProperty Object
                      (.-prototype Object)
                      "workbenchEnvelopePoison"
                      {:configurable true
                       :value "object-poison"})
     (.defineProperty Object
                      (.-prototype Array)
                      "workbenchEnvelopePoison"
                      {:configurable true
                       :value "array-poison"})
     (try
       (do
         (expect-true! (= (js/typeof (.-workbenchEnvelopePoison deep-frame)) "undefined"))
         (expect-true! (= (js/typeof (.-workbenchEnvelopePoison (nth deep-frame 0))) "undefined")))
       (finally
         (.deleteProperty Reflect
                          (.-prototype Object)
                          "workbenchEnvelopePoison")
         (.deleteProperty Reflect
                          (.-prototype Array)
                          "workbenchEnvelopePoison"))))))

(test/test
 "serialized envelope ingress excludes live objects and undeclared primitives"
 (fn [] Nil
   (let [policy workbench/WorkbenchPolicy (workbench-policy 8 8)
         primitives Any (workbench/create-workbench-envelope
                         policy
                         "[null,true,false,0,1.5,\"text\"]")
         trap-reads (Atom Int) (atom 0)
         array-proxy Any (new Proxy
                          []
                          {:get (fn
                                  [_target Any
                                   _property Any] Any
                                  (do
                                   (swap! trap-reads inc)
                                   (throw (new Error "proxy get invoked"))))
                           :getOwnPropertyDescriptor (fn
                                                       [_target Any
                                                        _property Any] Any
                                                       (do
                                                       (swap! trap-reads inc)
                                                       (throw
                                                        (new Error
                                                         "proxy descriptor invoked"))))})]
     (expect-true! (= true (.is Object (count primitives) 6)))
     (expect-true! (= true (.is Object (.getPrototypeOf Object primitives) nil)))
     (expect-true! (= true (.is Object (.isFrozen Object primitives) true)))
     (doseq [source Any ["{}"
                         "[{}]"
                         "[undefined]"
                         "[1e999]"]]
       (expect-true! (expect-throws? (fn [] Any
           (workbench/create-workbench-envelope policy source)))))
     (expect-true! (expect-throws? (fn [] Any
         (workbench/create-workbench-envelope policy array-proxy))))
     (expect-true! (= true (.is Object @trap-reads 0))))))

(test/test
 "workbench policy limits must be positive safe integers"
 (fn [] Nil
   (let [maximum Int (.-MAX_SAFE_INTEGER Number)
         infinity Any (.-POSITIVE_INFINITY Number)
         not-a-number Any (.-NaN Number)]
     (expect-true! (= (workbench/create-workbench-envelope
        (workbench-policy-with-sequences
         (sequence-limits maximum maximum maximum maximum maximum))
        "[]") []))
     (doseq [invalid-limit Any [0
                                -1
                                1.5
                                infinity
                                not-a-number
                                (+ maximum 1)]]
       (let [invalid-policy Any (workbench/->WorkbenchPolicy
                                 invalid-limit
                                 8
                                 32
                                 128
                                 512
                                 (default-sequence-limits))]
         (expect-true! (expect-throws? (fn [] Any
             (workbench/create-workbench-envelope invalid-policy "[]"))))))
     (expect-true! (expect-throws? (fn [] Any
         (workbench/create-workbench-envelope
          (workbench-policy-with-sequences
           (sequence-limits 1 maximum maximum maximum maximum))
          "[]"))))
     (doseq [invalid-limit Any [0
                                -1
                                1.5
                                infinity
                                not-a-number
                                (+ maximum 1)]]
       (expect-true! (expect-throws? (fn [] Any
           (workbench/create-workbench-envelope
            (workbench-policy-with-sequences
             (sequence-limits
              2
              invalid-limit
              invalid-limit
              invalid-limit
              invalid-limit))
            "[]"))))))))

(test/test
 "receipt exhaustion is one terminal occurrence under hostile reentrancy"
 (fn [] Nil
   (let [maximum Int (.-MAX_SAFE_INTEGER Number)
         fixture Any (fake-fixture-with-policy!
                      (frozen {:opaque "package"})
                      (workbench-policy-with-sequences
                       (sequence-limits 6 maximum maximum maximum maximum)))
         controller Any (.-controller fixture)
         session Any (frozen {:opaque "session"})
         terminal-results Any (atom [])]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      session
      (frozen {:opaque "revision"})
      (envelope "frame"))
     (reset! (.-receiptHook fixture)
             (fn [receipt Any] Any
               (when (= (.-event receipt) "counter-exhausted")
                 (doseq [_index Int (range 32)]
                   (.push @terminal-results (tick! fixture))
                   (.push @terminal-results
                          ((.-reloadPackage controller)
                           (frozen {:opaque "late-package"})))
                   (.push @terminal-results
                          ((.-observeInput controller) (envelope "late-input")))
                   (.push @terminal-results ((.-dispose controller))))
                 (throw (new Error "terminal-receipt-failed")))))
     (expect-true! (= true (.is Object (tick! fixture) true)))
     (let [terminal Any (snapshot fixture)
           exhausted Any (event-receipts fixture "counter-exhausted")]
       (expect-true! (= true (.is Object (.-phase terminal) "disposed")))
       (expect-true! (= true (.is Object (.-disposed terminal) true)))
       (expect-true! (= true (.is Object (count exhausted) 1)))
       (expect-true! (= true (.is Object (.-sequence (nth exhausted 0)) 6)))
       (expect-true! (= true (.is Object (.-detail (nth exhausted 0)) "receipt-sequence")))
       (expect-true! (= true (.is Object (count (.filter @terminal-results
                                    (fn [result Any] Bool (= result true)))) 0)))
       (expect-true! (= true (.is Object @(.-cancellations fixture) 1)))
       (expect-true! (= @(.-disposals fixture) [session]))
       (expect-true! (= true (.is Object (.-length @(.-candidateRequests fixture)) 0)))))))

(test/test
 "receipt exhaustion retires a fresh RuntimeSession with a rejected frame"
 (fn [] Nil
   (let [maximum Int (.-MAX_SAFE_INTEGER Number)
         fixture Any (fake-fixture-with-policy!
                      (frozen {:opaque "package-a"})
                      (workbench-policy-with-sequences
                       (sequence-limits 8 maximum maximum maximum maximum)))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         session-1 Any (frozen {:opaque "session-1"})]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      (envelope "frame-0"))
     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "accepted-b"})))
     (complete-request!
      (.-sessionRequests fixture)
      1
      (workbench/->SessionStarted
       session-1
       (frozen {:opaque "revision-1"})
       (frozen {:opaque "unbranded-frame"})))
     (let [terminal Any (snapshot fixture)
           exhausted Any (event-receipts fixture "counter-exhausted")]
       (expect-true! (= true (.is Object (.-phase terminal) "disposed")))
       (expect-true! (= @(.-disposals fixture) [session-0 session-1]))
       (expect-true! (= true (.is Object (count exhausted) 1)))
       (expect-true! (= true (.is Object (.-sequence (nth exhausted 0)) 8)))
       (expect-true! (= true (.is Object (.-detail (nth exhausted 0)) "receipt-sequence")))
       (expect-true! (= true (.is Object (count (event-receipts fixture "session-frame-rejected")) 0)))))))

(test/test
 "generation operation input and configuration counters fail closed"
 (fn [] Nil
   (let [maximum Int (.-MAX_SAFE_INTEGER Number)
         generation-fixture Any (fake-fixture-with-policy!
                                 (frozen {:opaque "generation-package"})
                                 (workbench-policy-with-sequences
                                  (sequence-limits
                                   maximum maximum 1 maximum maximum)))
         operation-fixture Any (fake-fixture-with-policy!
                                (frozen {:opaque "operation-package"})
                                (workbench-policy-with-sequences
                                 (sequence-limits
                                  maximum maximum maximum 1 maximum)))
         input-fixture Any (fake-fixture-with-policy!
                            (frozen {:opaque "input-package"})
                            (workbench-policy-with-sequences
                             (sequence-limits
                              maximum 1 maximum maximum maximum)))
         configuration-fixture Any (fake-fixture-with-policy!
                                    (frozen {:opaque "configuration-package"})
                                    (workbench-policy-with-sequences
                                     (sequence-limits
                                      maximum maximum maximum maximum 2)))]
     (bootstrap!
      generation-fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     ((.-reloadPackage (.-controller generation-fixture))
      (frozen {:opaque "second-package"}))
     (expect-true! (= true (.is Object (.-phase (snapshot generation-fixture)) "disposed")))
     (expect-true! (= true (.is Object (.-length @(.-packageRequests generation-fixture)) 1)))
     (expect-true! (= true (.is Object (.-detail (nth (event-receipts
                                   generation-fixture
                                   "counter-exhausted")
                                  0)) "generation-sequence")))

     (bootstrap!
      operation-fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     (tick! operation-fixture)
     (complete-request!
      (.-candidateRequests operation-fixture)
      0
      (workbench/->CandidateFailed "settled"))
     (tick! operation-fixture)
     (expect-true! (= true (.is Object (.-phase (snapshot operation-fixture)) "disposed")))
     (expect-true! (= true (.is Object (.-length @(.-candidateRequests operation-fixture)) 1)))
     (expect-true! (= true (.is Object (.-detail (nth (event-receipts
                                   operation-fixture
                                   "counter-exhausted")
                                  0)) "operation-sequence")))

     (bootstrap!
      input-fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     ((.-observeInput (.-controller input-fixture)) (envelope "input-1"))
     ((.-observeInput (.-controller input-fixture)) (envelope "input-2"))
     (expect-true! (= true (.is Object (.-phase (snapshot input-fixture)) "disposed")))
     (expect-true! (= true (.is Object (.-pendingObservations (snapshot input-fixture)) 1)))
     (expect-true! (= true (.is Object (.-detail (nth (event-receipts
                                   input-fixture
                                   "counter-exhausted")
                                  0)) "input-sequence")))

     (bootstrap!
      configuration-fixture
      (frozen {:opaque "accepted"})
      (frozen {:opaque "session"})
      (frozen {:opaque "revision"})
      (envelope "frame"))
     ((.-observeInput (.-controller configuration-fixture))
      (envelope "input-1"))
     ((.-observeInput (.-controller configuration-fixture))
      (envelope "input-2"))
     (expect-true! (= true (.is Object (.-phase (snapshot configuration-fixture)) "disposed")))
     (expect-true! (= true (.is Object (.-configurationRevision (snapshot configuration-fixture)) 2)))
     (expect-true! (= true (.is Object (.-pendingObservations (snapshot configuration-fixture)) 1)))
     (expect-true! (= true (.is Object (.-detail (nth (event-receipts
                                   configuration-fixture
                                   "counter-exhausted")
                                  0)) "configuration-revision"))))))

(test/test
 "counter exhaustion retires a returned session that cannot be installed"
 (fn [] Nil
   (let [maximum Int (.-MAX_SAFE_INTEGER Number)
         fixture Any (fake-fixture-with-policy!
                      (frozen {:opaque "package-a"})
                      (workbench-policy-with-sequences
                       (sequence-limits maximum maximum maximum maximum 1)))
         controller Any (.-controller fixture)
         session-0 Any (frozen {:opaque "session-0"})
         session-1 Any (frozen {:opaque "session-1"})]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted-a"})
      session-0
      (frozen {:opaque "revision-0"})
      (envelope "frame-0"))
     ((.-reloadPackage controller) (frozen {:opaque "package-b"}))
     (complete-request!
      (.-packageRequests fixture)
      1
      (workbench/->PackageAccepted (frozen {:opaque "accepted-b"})))
     (reset! (.-disposalHook fixture)
             (fn [session Any] Any
               (when (identical? session session-1)
                 (throw (new Error "fresh-session-disposal-failed")))))
     (complete-request!
      (.-sessionRequests fixture)
      1
      (workbench/->SessionStarted
       session-1
       (frozen {:opaque "revision-1"})
       (envelope "frame-1")))
     (expect-true! (= true (.is Object (.-phase (snapshot fixture)) "disposed")))
     (expect-true! (= @(.-disposals fixture) [session-0 session-1]))
     (expect-true! (= true (.is Object (.-detail (nth (event-receipts
                                   fixture
                                   "counter-exhausted")
                                  0)) "configuration-revision:disposal-uncertain"))))))

(test/test
 "terminal disposal fences outstanding candidate and Admission completions"
 (fn [] Nil
   (let [candidate-fixture Any (fake-fixture! (frozen {:opaque "candidate-package"}))
         candidate-controller Any (.-controller candidate-fixture)
         candidate-session Any (frozen {:opaque "candidate-session"})
         candidate-frame Any (envelope "candidate-frame")
         admission-fixture Any (fake-fixture! (frozen {:opaque "admission-package"}))
         admission-controller Any (.-controller admission-fixture)
         admission-session Any (frozen {:opaque "admission-session"})
         admission-frame Any (envelope "admission-frame")]
     (bootstrap!
      candidate-fixture
      (frozen {:opaque "candidate-accepted"})
      candidate-session
      (frozen {:opaque "candidate-revision"})
      candidate-frame)
     (tick! candidate-fixture)
     ((.-dispose candidate-controller))
     (complete-request!
      (.-candidateRequests candidate-fixture)
      0
      (workbench/->CandidateProduced (frozen {:opaque "late-candidate"})))
     (expect-true! (= true (.is Object (.-phase (snapshot candidate-fixture)) "disposed")))
     (expect-true! (= true (.is Object (.-length @(.-admissionRequests candidate-fixture)) 0)))
     (expect-true! (= @(.-rendered candidate-fixture) [candidate-frame]))
     (expect-true! (= @(.-disposals candidate-fixture) [candidate-session]))

     (bootstrap!
      admission-fixture
      (frozen {:opaque "admission-accepted"})
      admission-session
      (frozen {:opaque "admission-revision"})
      admission-frame)
     (tick! admission-fixture)
     (complete-request!
      (.-candidateRequests admission-fixture)
      0
      (workbench/->CandidateProduced (frozen {:opaque "candidate"})))
     ((.-dispose admission-controller))
     (complete-request!
      (.-admissionRequests admission-fixture)
      0
      (workbench/->AdmissionAccepted
       (frozen {:opaque "late-successor"})
       (frozen {:opaque "late-revision"})
       (envelope "late-frame")))
     (expect-true! (= true (.is Object (.-phase (snapshot admission-fixture)) "disposed")))
     (expect-true! (= @(.-rendered admission-fixture) [admission-frame]))
     (expect-true! (= @(.-disposals admission-fixture) [admission-session])))))

(test/test
 "disposal is terminal and idempotent"
 (fn [] Nil
   (let [fixture Any (fake-fixture! (frozen {:opaque "package"}))
         controller Any (.-controller fixture)
         session Any (frozen {:opaque "session"})
         frame Any (envelope "frame")]
     (bootstrap!
      fixture
      (frozen {:opaque "accepted"})
      session
      (frozen {:opaque "revision"})
      frame)
     ((.-dispose controller))
     ((.-dispose controller))
     (tick! fixture)
     ((.-observeInput controller) (frozen {:opaque "late-input"}))
     ((.-reloadPackage controller) (frozen {:opaque "late-package"}))
     (let [terminal Any (snapshot fixture)
           events Any (receipt-events fixture)]
       (expect-true! (= true (.is Object (.-phase terminal) "disposed")))
       (expect-true! (= true (.is Object (.-disposed terminal) true)))
       (expect-true! (= true (.is Object @(.-cancellations fixture) 1)))
       (expect-true! (= @(.-disposals fixture) [session]))
       (expect-true! (= true (.is Object (.-length @(.-packageRequests fixture)) 1)))
       (expect-true! (= true (.is Object (.-length @(.-candidateRequests fixture)) 0)))
       (expect-true! (= true (.is Object (.-length events) (.-length @(.-receipts fixture)))))
       (expect-true! (= true (.is Object (count (filter
                                  (fn [event Any] Bool
                                    (= event "disposed"))
                                  events)) 1)))))))

(test/test
 "opaque port values are not interpreted and foreign objects cannot forge envelopes"
 (fn [] Nil
   (let [reads Any (atom 0)
         poison Any (new Proxy
              (frozen {})
              {:get (fn
                      [_target Any
                       _property Any] Any
                      (do
                        (swap! reads inc)
                        (throw (new Error "opaque value was interpreted"))))})
         fixture Any (fake-fixture! poison)
         frame Any (envelope "frame")]
     (expect-true! (expect-throws? (fn [] Any
         (workbench/create-workbench-envelope
          (workbench-policy 8 8)
          poison))))
     (bootstrap! fixture poison poison poison frame)
     (expect-true! (expect-throws? (fn [] Any ((.-observeInput (.-controller fixture)) poison))))
     ((.-observeInput (.-controller fixture)) (envelope "input"))
     (tick! fixture)
     (complete-request!
      (.-candidateRequests fixture)
      0
      (workbench/->CandidateProduced poison))
     (complete-request!
      (.-admissionRequests fixture)
      0
      (workbench/->AdmissionRejected "opaque-rejection"))
     (expect-true! (= true (.is Object @reads 0)))
     (expect-true! (= (mapv (fn [call Any] Any (.-kind call)) @(.-calls fixture)) ["acceptPackage"
       "startSession"
       "runCandidate"
       "requestAdmission"])))))
