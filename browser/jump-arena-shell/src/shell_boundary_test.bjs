#lang beagle/js

(ns jump-arena-shell.shell-boundary-test
  (:require [jump-arena-shell.shell :as shell]))

(require '["bun:test" :as test])

(declare-extern [test/test test/expect JSON] Any)

(defn empty-listener-map [] (JsMap String Any)
  (new Map))

(def browser-listeners (Atom (JsMap String Any)) (atom (empty-listener-map)))
(def canvas-listeners (Atom (JsMap String Any)) (atom (empty-listener-map)))
(def pointer-captures Any (atom (new Set)))
(def emitted-inputs Any (atom []))
(def render-count Any (atom 0))
(def resource-disposals Any (atom 0))
(def renderer-disposals Any (atom 0))
(def context-losses Any (atom 0))
(def canvas-removals Any (atom 0))
(def released-pointers Any (atom 0))
(def focus-requests Any (atom 0))
(def pixel-ratio Any (atom 0.0))

(defn vector3 [] Any
  {:x 0.0
   :y 0.0
   :z 0.0
   :set (fn
          [_x Any
           _y Any
           _z Any] Any
          nil)})

(defn node [] Any
  {:position (vector3)
   :rotation {:x 0.0 :y 0.0 :z 0.0}
   :scale (vector3)
   :add (fn [_child Any] Any nil)
   :remove (fn [_child Any] Any nil)
   :clear (fn [] Any nil)
   :lookAt (fn
             [_x Any
              _y Any
              _z Any] Any
             nil)
   :updateProjectionMatrix (fn [] Any nil)})

(defn fakeScene [] Any (node))
(defn fakeColor [_color Any] Any {})
(defn fakeCamera
  [_fov Any
   _aspect Any
   _near Any
   _far Any] Any
  (node))
(defn fakeLight
  [_color Any
   _ground-or-intensity Any
   & _rest (List Any)] Any
  (node))

(defn fakeResource! [& _arguments (List Any)] Any
  {:dispose (fn [] Any (swap! resource-disposals inc))})

(defn fakeMesh
  [geometry Any
   material Any] Any
  (merge (node) {:geometry geometry :material material}))

(defn fakeGroup [] Any (node))

(defn fakeCanvas! [] Any
  {:addEventListener (fn
                       [kind Any
                        handler Any] Any
                       (.set @canvas-listeners kind handler))
   :removeEventListener (fn
                          [kind Any
                           _handler Any] Any
                          (.delete @canvas-listeners kind))
   :getBoundingClientRect (fn [] Any
                            {:left 10.0 :top 20.0 :width 200.0 :height 100.0})
   :setPointerCapture (fn [pointer-id Any] Any
                        (.add @pointer-captures pointer-id))
   :hasPointerCapture (fn [pointer-id Any] Any
                        (.has @pointer-captures pointer-id))
   :releasePointerCapture (fn [pointer-id Any] Any
                            (do
                              (.delete @pointer-captures pointer-id)
                              (swap! released-pointers inc)))
   :focus (fn [_options Any] Any
            (do
              (swap! focus-requests inc)
              ((.get @canvas-listeners "focus") {})))
   :setAttribute (fn
                   [_name Any
                    _value Any] Any
                   nil)
   :remove (fn [] Any (swap! canvas-removals inc))})

(defn fakeRenderer! [_options Any] Any
  {:domElement (fakeCanvas!)
   :setPixelRatio (fn [ratio Any] Any (reset! pixel-ratio ratio))
   :setSize (fn
              [_width Any
               _height Any
               _update-style Any] Any
              nil)
   :render (fn
             [_scene Any
              _camera Any] Any
             (swap! render-count inc))
   :dispose (fn [] Any (swap! renderer-disposals inc))
   :forceContextLoss (fn [] Any (swap! context-losses inc))})

(defn fakeBrowser! [] Any
  {:devicePixelRatio 4.0
   :addEventListener (fn
                       [kind Any
                        handler Any] Any
                       (.set @browser-listeners kind handler))
   :removeEventListener (fn
                          [kind Any
                           _handler Any] Any
                          (.delete @browser-listeners kind))})

(defn fakeMount [] Any
  {:clientWidth 640.0
   :clientHeight 360.0
   :appendChild (fn [_canvas Any] Any nil)})

(defn frozen-vec3
  [x Float
   y Float
   z Float] Any
  (.freeze Object {:x x :y y :z z}))

(defn frozen-platform [] Any
  (.freeze Object
           {:position (frozen-vec3 0.0 -0.25 0.0)
            :size (frozen-vec3 12.0 0.5 12.0)}))

(defn sample-frame [] Any
  (.freeze Object
           {:player (.freeze Object
                             {:position (frozen-vec3 2.0 3.0 4.0)
                              :velocity (frozen-vec3 5.0 6.0 7.0)
                              :yaw 0.5
                              :grounded false})
            :world (.freeze Object
                            {:platforms (.freeze Object [(frozen-platform)])})}))

(defn reset-fixture! [] Any
  (do
    (reset! browser-listeners (empty-listener-map))
    (reset! canvas-listeners (empty-listener-map))
    (reset! pointer-captures (new Set))
    (reset! emitted-inputs [])
    (reset! render-count 0)
    (reset! resource-disposals 0)
    (reset! renderer-disposals 0)
    (reset! context-losses 0)
    (reset! canvas-removals 0)
    (reset! released-pointers 0)
    (reset! focus-requests 0)
    (reset! pixel-ratio 0.0)))

(test/test
 "production shell emits input without advancing player state and tears down"
 (fn [] Any
   (reset-fixture!)
   (let [three Any {:Scene fakeScene
                    :Color fakeColor
                    :PerspectiveCamera fakeCamera
                    :WebGLRenderer fakeRenderer!
                    :HemisphereLight fakeLight
                    :DirectionalLight fakeLight
                    :BoxGeometry fakeResource!
                    :MeshStandardMaterial fakeResource!
                    :Mesh fakeMesh
                    :Group fakeGroup}
         arena Any (shell/create-jump-arena-shell!
                    (fakeMount)
                    (fakeBrowser!)
                    three
                    (fn [input Any] Any (.push @emitted-inputs input)))
         frame Any (sample-frame)
         before String (.stringify JSON frame)
         resize-handler Any (.get @browser-listeners "resize")
         focus-handler Any (.get @canvas-listeners "focus")
         blur-handler Any (.get @canvas-listeners "blur")
         key-down Any (.get @canvas-listeners "keydown")
         key-up Any (.get @canvas-listeners "keyup")
         pointer-down Any (.get @canvas-listeners "pointerdown")
         pointer-move Any (.get @canvas-listeners "pointermove")
         pointer-up Any (.get @canvas-listeners "pointerup")
         pointer-cancel Any (.get @canvas-listeners "pointercancel")]
     ((.-renderFrame arena) frame)
     (key-down {:code "Space" :repeat false})
     (.toBe (test/expect (.-length @emitted-inputs)) 0)
     (focus-handler {})
     (key-down {:code "Space" :repeat false})
     (.toBe (test/expect (.-length @emitted-inputs)) 1)
     (blur-handler {})
     (key-down {:code "Space" :repeat false})
     (.toBe (test/expect (.-length @emitted-inputs)) 1)
     (pointer-down {:clientX 110.0
                    :clientY 70.0
                    :pointerId 9
                    :button 0
                    :buttons 1})
     (.toBe (test/expect (.stringify JSON frame)) before)
     (.toEqual (test/expect (.-position (.-player frame)))
               {:x 2.0 :y 3.0 :z 4.0})
     (.toEqual (test/expect (.-velocity (.-player frame)))
               {:x 5.0 :y 6.0 :z 7.0})
     (.toBe (test/expect (.-grounded (.-player frame))) false)
     (.toBe (test/expect @render-count) 1)
     (.toBe (test/expect (.-length @emitted-inputs)) 2)
     (.toBe (test/expect @pixel-ratio) 2.0)
     (.toBe (test/expect (.has @browser-listeners "keydown")) false)
     (.toBe (test/expect (.has @browser-listeners "keyup")) false)
     (.toBe (test/expect @focus-requests) 1)
     ((.-dispose arena))
     ((.-dispose arena))
     (key-down {:code "KeyW" :repeat false})
     (focus-handler {})
     (blur-handler {})
     (key-down {:code "KeyW" :repeat false})
     (key-up {:code "KeyW" :repeat false})
     (pointer-down {:clientX 110.0
                    :clientY 70.0
                    :pointerId 10
                    :button 0
                    :buttons 1})
     (pointer-move {:clientX 111.0
                    :clientY 71.0
                    :pointerId 9
                    :button 0
                    :buttons 1})
     (pointer-up {:clientX 111.0
                  :clientY 71.0
                  :pointerId 9
                  :button 0
                  :buttons 0})
     (pointer-cancel {:clientX 111.0
                      :clientY 71.0
                      :pointerId 9
                      :button 0
                      :buttons 0})
     (resize-handler)
     (.toThrow (test/expect (fn [] Any ((.-renderFrame arena) frame)))
               "jump arena shell is disposed")
     (.toBe (test/expect (.-size @browser-listeners)) 0)
     (.toBe (test/expect (.-size @canvas-listeners)) 0)
     (.toBe (test/expect (.-size @pointer-captures)) 0)
     (.toBe (test/expect (.-length @emitted-inputs)) 2)
     (.toBe (test/expect @focus-requests) 1)
     (.toBe (test/expect @render-count) 1)
     (.toBe (test/expect @released-pointers) 1)
     (.toBe (test/expect @resource-disposals) 4)
     (.toBe (test/expect @renderer-disposals) 1)
     (.toBe (test/expect @context-losses) 1)
     (.toBe (test/expect @canvas-removals) 1))))
