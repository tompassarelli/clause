#lang beagle/js

(ns jump-arena-shell.branch-wasm-port-test
  (:require [jump-arena-shell.branch-wasm-port :as branch]
            [jump-arena-shell.wasm-cartridge-port :as wire]))

(require '["bun:test" :as test])
(require
 '["#clause-runtime-wasm"
   :refer [clause_branch_v1_command
           clause_branch_v1_event_byte
           clause_branch_v1_event_len
           clause_branch_v1_io_reset
           clause_branch_v1_open
           clause_branch_v1_request_push
           initSync
           InitOutput
           SyncInitInput]])

(declare-extern [Bun require] Any)

(defn initialize-real-branch-module [module ArrayBuffer] Any
  (let [input SyncInitInput module
        _initialized InitOutput (initSync input)]
    (.freeze
     Object
     {:clause_branch_v1_io_reset
      (fn [] Nil (clause_branch_v1_io_reset))
      :clause_branch_v1_request_push
      (fn [byte Int] Float (clause_branch_v1_request_push byte))
      :clause_branch_v1_open
      (fn [] Float (clause_branch_v1_open))
      :clause_branch_v1_command
      (fn [] Float (clause_branch_v1_command))
      :clause_branch_v1_event_len
      (fn [] Float (clause_branch_v1_event_len))
      :clause_branch_v1_event_byte
      (fn [index Int] Float (clause_branch_v1_event_byte index))})))

(defn json-string [value Any] String
  (.stringify JSON value))

(let [runtime Any (require "bun:test")
      register-test Any (.-test runtime)]
  (register-test
   "real Wasm forks reconnects admits and explains one construct-blind process"
   (fn [] Any
     (.then
      (.all Promise [(.arrayBuffer (.file Bun "./generated/wasm/clause_runtime_bg.wasm"))
                     (.text (.file Bun
                                   "./fixtures/wasm-process-continuation-v1/process-continuation-v1.cwr1.hex"))])
      (fn [assets Any] Any
        (let [module Any (initialize-real-branch-module (nth assets 0))
              request wire/ExactProcessRequest (wire/->ExactProcessRequest
               (wire/decode-cwr1-hex (nth assets 1)))
              occurrences Any (wire/process-request-occurrences! request)
              process-branch branch/WasmProcessBranch (branch/open-process-branch! module request 41 (nth occurrences 0) 8)
              opened Any (.-opened process-branch)
              parent Any (.-parentState (.-pins opened))
              branch-run Any (.-run (.-ancestry opened))
              authoritative Any (branch/admit-authoritative-occurrences!
                                 module process-branch occurrences)
              r1 Any (.-successor authoritative)
              proposal Any (branch/propose-branch-reconnect!
                            module process-branch occurrences)
              evidence Any (.-evidence proposal)
              admitted Any (branch/adjudicate-branch-reconnect!
                            module process-branch proposal r1 occurrences)
              explanation Any (.-explanation admitted)
              queried Any (.-explanation
                           (branch/explain-process-branch! module process-branch))
              branch-command Any (nth (.-commandEvidence evidence) 0)
              explained-branch-command Any (nth (.-branchCommandEvidence explanation) 0)
              authoritative-command Any (nth (.-authoritativeCommandEvidence explanation) 0)]
          (.toBe (test/expect (str (.-disconnectTick (.-pins opened)))) "41")
          (.toBe (test/expect (json-string (.-predecessor authoritative)))
                 (json-string parent))
          (.toBe (test/expect
                   (if (not= (json-string r1) (json-string parent)) "true" "false"))
                 "true")
          (.toBe (test/expect
                   (if (not= (json-string (.-run authoritative))
                             (json-string branch-run))
                     "true"
                     "false"))
                 "true")
          (.toBe (test/expect (json-string (.-parentState (.-pins evidence))))
                 (json-string parent))
          (.toBe (test/expect (json-string (.-run (.-ancestry evidence))))
                 (json-string branch-run))
          (.toBe (test/expect (str (.-length (.-commandEvidence evidence)))) "2")
          (.toBe (test/expect (json-string (.-occurrence branch-command)))
                 (json-string (nth occurrences 0)))
          (.toBe (test/expect (str (.-length (.-step branch-command)))) "32")
          (.toBe (test/expect (str (.-length (.-observation branch-command)))) "32")
          (.toBe (test/expect (json-string (.-predecessor admitted)))
                 (json-string r1))
          (.toBe (test/expect
                   (if (not= (json-string (.-successor admitted)) (json-string r1))
                     "true"
                     "false"))
                 "true")
          (.toBe (test/expect (json-string (.-branchCandidate admitted)))
                 (json-string (.-candidate evidence)))
          (.toBe (test/expect (json-string (.-successor explanation)))
                 (json-string (.-successor admitted)))
          (.toBe (test/expect (json-string explained-branch-command))
                 (json-string branch-command))
          (.toBe (test/expect (json-string (.-occurrence authoritative-command)))
                 (json-string (nth occurrences 0)))
          (.toBe (test/expect
                   (if (not= (json-string (.-step authoritative-command))
                             (json-string (.-step branch-command)))
                     "true"
                     "false"))
                 "true")
          (.toBe (test/expect
                   (if (not= (json-string (.-observation authoritative-command))
                             (json-string (.-observation branch-command)))
                     "true"
                     "false"))
                 "true")
          (.toBe (test/expect (json-string queried)) (json-string explanation))
          (.toBe (test/expect
                   (if (> (.-length (.-causalRecords explanation)) 0) "true" "false"))
                 "true")
          (.toBe (test/expect
                   (str (branch/dispose-process-branch! module process-branch)))
                 "true")
          nil))))))
