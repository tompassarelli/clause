#lang beagle/js

(ns jump-arena-shell.demo
  (:require [jump-arena-shell.wasm-cartridge-port :as wasm]
            [jump-arena-shell.wasm-workbench-shell :as integration]
            [jump-arena-shell.workbench :as workbench])
  (:require-global ["typescript:lib.dom" :refer [Response fetch]]
                   ["typescript:lib.es5" :refer [Error]]))

(require
 '["three"
   :refer [BoxGeometry
           Color
           DirectionalLight
           Group
           HemisphereLight
           Mesh
           MeshStandardMaterial
           PerspectiveCamera
           Scene
           WebGLRenderer]]
 '["#clause-runtime-wasm"
   :refer [clause_session_v1_command_bulk
           clause_session_v1_event_bulk
           clause_session_v1_open_bulk
           clause_session_v1_reclaim_retired
           initSync
           InitOutput
           SyncInitInput]])

(declare-extern [document window] Any)

(def module-path String "./generated/wasm/clause_runtime_bg.wasm")
(def request-path String "./fixtures/wasm-jump-v1/jump-v1.cwr1.hex")

(defn demo-policy [] workbench/WorkbenchPolicy
  (workbench/->WorkbenchPolicy
   8 8 32 wasm/cse1-projected-term-max-properties
   wasm/cse1-projected-term-json-max-source-units
   (workbench/->WorkbenchSequenceLimits
    64 16 8 8 16)))

(defn ^:async fetch-text! [path String] (Promise String)
  (let [response Response (await (fetch path))]
    (if (.-ok response)
      (await (.text response))
      (throw (new Error (str "Unable to load " path))))))

(defn ^:async fetch-bytes! [path String] (Promise ArrayBuffer)
  (let [response Response (await (fetch path))]
    (if (.-ok response)
      (await (.arrayBuffer response))
      (throw (new Error (str "Unable to load " path))))))

(defn initialize-session-module [module ArrayBuffer] Any
  (let [input SyncInitInput module
        _initialized InitOutput (initSync input)]
    (.freeze
     Object
     {:clause_session_v1_open_bulk
      (fn [request (Vec Int)] Float
        (clause_session_v1_open_bulk (new Uint8Array request)))
      :clause_session_v1_command_bulk
      (fn [request (Vec Int)] Float
        (clause_session_v1_command_bulk (new Uint8Array request)))
      :clause_session_v1_event_bulk
      (fn [] Any (clause_session_v1_event_bulk))
      :clause_session_v1_reclaim_retired
      (fn [] Bool (clause_session_v1_reclaim_retired))})))

(def arena Any (.querySelector document "#arena"))
(def status Any (.querySelector document "#arena-status"))
(def active-composition Any (atom nil))

(def three-module Any
  (.freeze Object
           {:BoxGeometry BoxGeometry
            :Color Color
            :DirectionalLight DirectionalLight
            :Group Group
            :HemisphereLight HemisphereLight
            :Mesh Mesh
            :MeshStandardMaterial MeshStandardMaterial
            :PerspectiveCamera PerspectiveCamera
            :Scene Scene
            :WebGLRenderer WebGLRenderer}))

(defn ^:async load-demo! [] (Promise Nil)
  (let [module-request (Promise ArrayBuffer) (fetch-bytes! module-path)
        fixture-request (Promise String) (fetch-text! request-path)
        module-bytes ArrayBuffer (await module-request)
        fixture-text String (await fixture-request)
        module Any (initialize-session-module module-bytes)
        composition Any (integration/create-passive-wasm-workbench-shell!
                         arena
                         window
                         three-module
                         module
                         (wasm/decode-cwr1-hex fixture-text)
                         (workbench/->FixedTick 16)
                         (demo-policy)
                         (fn [_receipt Any] Any nil))]
    (reset! active-composition composition)
    (set! (.-textContent status)
          "Ready — click the arena, move with A/D, and jump with Space.")
    nil))

(def load-demo (Promise Nil)
  (.catch
   (load-demo!)
   (fn [_error Any] Nil
     (do
       (set! (.-textContent status) "Arena load failed safely.")
       nil))))

(.addEventListener
 window
 "beforeunload"
 (fn [] Any
   (let [composition Any @active-composition]
     (when (not (nil? composition))
       ((.-dispose composition)))))
 {:once true})
