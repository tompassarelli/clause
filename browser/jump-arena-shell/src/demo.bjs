#lang beagle/js

(ns jump-arena-shell.demo
  (:require [jump-arena-shell.wasm-cartridge-port :as wasm]
            [jump-arena-shell.wasm-workbench-shell :as integration]
            [jump-arena-shell.workbench :as workbench]))

(require
 '["#clause-runtime-wasm"
   :refer [clause_session_v1_command
           clause_session_v1_event_byte
           clause_session_v1_event_len
           clause_session_v1_io_reset
           clause_session_v1_open
           clause_session_v1_request_push
           initSync
           InitOutput
           SyncInitInput]])

(declare-extern [document window fetch] Any)

(def module-path String "./generated/wasm/clause_runtime_bg.wasm")
(def request-path String "./fixtures/wasm-jump-v1/jump-v1.cwr1.hex")

(defn demo-policy [] workbench/WorkbenchPolicy
  (workbench/->WorkbenchPolicy
   8 8 32 wasm/cse1-projected-term-max-properties
   wasm/cse1-projected-term-json-max-source-units
   (workbench/->WorkbenchSequenceLimits
    64 16 8 8 16)))

(defn fetch-text! [path String] (Promise String)
  (.then (fetch path)
         (fn [response Any] Any
           (if (.-ok response)
             (.text response)
             (.reject Promise (new Error (str "Unable to load " path)))))))

(defn fetch-bytes! [path String] (Promise Any)
  (.then (fetch path)
         (fn [response Any] Any
           (if (.-ok response)
             (.arrayBuffer response)
             (.reject Promise (new Error (str "Unable to load " path)))))))

(defn initialize-session-module [module ArrayBuffer] Any
  (let [input SyncInitInput module
        _initialized InitOutput (initSync input)]
    (.freeze
     Object
     {:clause_session_v1_io_reset
      (fn [] Nil (clause_session_v1_io_reset))
      :clause_session_v1_request_push
      (fn [byte Int] Float (clause_session_v1_request_push byte))
      :clause_session_v1_open
      (fn [] Float (clause_session_v1_open))
      :clause_session_v1_command
      (fn [] Float (clause_session_v1_command))
      :clause_session_v1_event_len
      (fn [] Float (clause_session_v1_event_len))
      :clause_session_v1_event_byte
      (fn [index Int] Float (clause_session_v1_event_byte index))})))

(def status Any (.querySelector document "#replay-status"))
(def result Any (.querySelector document "#replay-result"))
(def active-composition Any (atom nil))

(defn create-result-shell! [_emit-input (Fn [Any] Any)] Any
  (let [disposed Any (atom false)]
    (.freeze Object
             {:renderFrame (fn [values Any] Any
                             (if @disposed
                               (throw (new Error "replay result shell is disposed"))
                               (do
                                 (set! (.-textContent status)
                                       "Separate Admission accepted; exact scalar result:")
                                 (set! (.-textContent result)
                                       (.stringify JSON values))
                                 values)))
              :dispose (fn [] Any
                         (when (not @disposed)
                           (reset! disposed true)))})))

(def load-demo Any
  (.catch
   (.then
    (.then
     (.all Promise [(fetch-bytes! module-path)
                    (fetch-text! request-path)])
     (fn [assets Any] Any
        (integration/load-passive-wasm-workbench-shell!
         (integration/create-sync-wasm-initializer
          initialize-session-module)
        (nth assets 0)
        create-result-shell!
        integration/project-persistent-term-frame
        window
        (wasm/decode-cwr1-hex (nth assets 1))
        (workbench/->FixedTick 16)
        (demo-policy)
        (fn [_receipt Any] Any nil))))
    (fn [composition Any] Any
      (do
        (reset! active-composition composition)
        (set! (.-textContent status)
              "Exact replay loaded; awaiting separate Admission.")
        composition)))
   (fn [_error Any] Any
     (do
       (set! (.-textContent status) "Replay load failed safely.")
       (set! (.-textContent result) "")
       nil))))

(.addEventListener
 window
 "beforeunload"
 (fn [] Any
   (let [composition Any @active-composition]
     (when (not (nil? composition))
       ((.-dispose composition)))))
 {:once true})
