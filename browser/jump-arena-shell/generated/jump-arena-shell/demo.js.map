#lang beagle/js

(ns jump-arena-shell.demo
  (:require [jump-arena-shell.shell :as shell]))

(require '["three" :as THREE])

(declare-extern
  [document window
   THREE/Scene THREE/Color
   THREE/PerspectiveCamera THREE/WebGLRenderer
   THREE/HemisphereLight THREE/DirectionalLight
   THREE/BoxGeometry THREE/MeshStandardMaterial
   THREE/Mesh THREE/Group] Any)

(defn frozen-vec3
  [x Float
   y Float
   z Float] Any
  (.freeze Object {:x x :y y :z z}))

(defn frozen-platform
  [x Float
   y Float
   z Float
   width Float
   height Float
   depth Float] Any
  (.freeze Object
           {:position (frozen-vec3 x y z)
            :size (frozen-vec3 width height depth)}))

(def static-sample-frame Any
  (.freeze Object
           {:player (.freeze Object
                             {:position (frozen-vec3 0.0 1.15 0.0)
                              :velocity (frozen-vec3 0.0 0.0 0.0)
                              :yaw 0.0
                              :grounded true})
            :world (.freeze Object
                            {:platforms (.freeze Object
                                                 [(frozen-platform 0.0 -0.25 0.0 12.0 0.5 12.0)
                                                  (frozen-platform 4.0 1.0 -2.0 3.0 0.5 3.0)
                                                  (frozen-platform -3.0 2.2 -5.0 2.5 0.5 2.5)])})}))

(def mount Any (.querySelector document "#arena"))

(def three Any
  {:Scene THREE/Scene
   :Color THREE/Color
   :PerspectiveCamera THREE/PerspectiveCamera
   :WebGLRenderer THREE/WebGLRenderer
   :HemisphereLight THREE/HemisphereLight
   :DirectionalLight THREE/DirectionalLight
   :BoxGeometry THREE/BoxGeometry
   :MeshStandardMaterial THREE/MeshStandardMaterial
   :Mesh THREE/Mesh
   :Group THREE/Group})

(def arena Any
  (shell/create-jump-arena-shell!
   mount
   window
   three
   (fn [input Any] Any
     (.dispatchEvent mount (new CustomEvent "arena-shell-input" {:detail input})))))

((.-renderFrame arena) static-sample-frame)

(.addEventListener window "beforeunload" (.-dispose arena) {:once true})
