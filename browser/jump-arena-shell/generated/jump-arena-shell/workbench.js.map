#lang beagle/js

(ns jump-arena-shell.workbench)

(js/export
  (defrecord FixedTick [milliseconds Int]))

(js/export
  (defrecord WorkbenchSequenceLimits
    [maxReceiptSequence Int
     maxInputSequence Int
     maxGeneration Int
     maxOperationId Int
     maxConfigurationRevision Int]))

(js/export
  (defrecord WorkbenchPolicy
    [maxPendingObservations Int
     maxSessionIdentities Int
     maxImmutableObjects Int
     maxImmutableProperties Int
     maxEnvelopeSourceUnits Int
     sequenceLimits WorkbenchSequenceLimits]))

(js/export
  (defrecord InputObservation
    [sequence Int
     value Any]))

(js/export
  (defrecord InputConfiguration
    [revision Int
     observations (Vec InputObservation)]))

(js/export
  (defrecord LifecycleReceipt
    [schema String
     sequence Int
     event String
     phase String
     activeGeneration Int
     operationGeneration Int
     operationId Int
     configurationRevision Int
     revision Any
     detail String]))

(js/export
  (defrecord WorkbenchSnapshot
    [phase String
     generation Int
     operationId Int
     configurationRevision Int
     pendingObservations Int
     revision Any
     frame Any
     disposed Bool]))

(js/export
  (defunion PackageCheck
    (PackageAccepted [acceptedPackage Any])
    (PackageRejected [reason String])))

(js/export
  (defunion SessionCompletion
    (SessionStarted
      [session Any
       revision Any
       frame Any])
    (SessionFailed [reason String])))

(js/export
  (defunion CandidateCompletion
    (CandidateProduced [candidate Any])
    (CandidateFailed [reason String])))

(js/export
  (defunion AdmissionCompletion
    (AdmissionAccepted
      [successor Any
       revision Any
       frame Any])
    (AdmissionRejected [reason String])))

(js/export
  (defrecord CartridgePort
    [acceptPackage (Fn [Any (Fn [PackageCheck] Any)] Any)
     startSession (Fn [Any Int (Fn [SessionCompletion] Any)] Any)
     runCandidate (Fn [Any FixedTick InputConfiguration (Fn [CandidateCompletion] Any)] Any)
     requestAdmission (Fn [Any Any (Fn [AdmissionCompletion] Any)] Any)
     disposeSession (Fn [Any] Any)]))

(defrecord ActiveRuntime
  [generation Int
   session Any
   revision Any
   frame Any])

(defrecord WorkbenchState
  [phase String
   active ActiveRuntime?
   operationId Int
   configuration InputConfiguration
   latestReload Int
   disposed Bool])

(defunion WorkbenchTransition
  (ObserveInput [value Any])
  (InputRejected)
  (FixedTickElapsed)
  (CandidateCompleted
    [generation Int
     operationId Int
     completion CandidateCompletion])
  (CandidateBoundaryFailed
    [generation Int
     operationId Int])
  (AdmissionCompleted
    [generation Int
     operationId Int
     completion AdmissionCompletion])
  (AdmissionBoundaryFailed
    [generation Int
     operationId Int])
  (ReloadRequested [packageCandidate Any])
  (PackageCompleted
    [generation Int
     completion PackageCheck])
  (PackageBoundaryFailed [generation Int])
  (ReloadRejected)
  (SessionCompleted
    [generation Int
     priorSession Any
     completion SessionCompletion])
  (SessionBoundaryFailed
    [generation Int
     priorSession Any])
  (DisposeRequested))

(defrecord EnvelopeMeasure
  [objectCount Int
   propertyCount Int
   sourceUnitCount Int])

(defrecord EnvelopeCopy
  [source Any
   target Any])

(defunion EnvelopeScan
  (EnvelopeScanAccepted
    [pending (Vec EnvelopeCopy)
     targets (Vec Any)
     objectCount Int
     propertyCount Int])
  (EnvelopeScanRejected))

(def lifecycle-schema String "clause-cartridge-workbench/v1")

(def envelope-measures Any (new WeakMap))

(defn empty-configuration [revision Int] InputConfiguration
  (->InputConfiguration revision (.freeze Object [])))

(defn active-generation [active ActiveRuntime?] Int
  (if (nil? active) 0 (.-generation active)))

(defn active-revision [active ActiveRuntime?] Any
  (if (nil? active) nil (.-revision active)))

(defn active-frame [active ActiveRuntime?] Any
  (if (nil? active) nil (.-frame active)))

(defn settled-phase [active ActiveRuntime?] String
  (if (nil? active) "idle" "ready"))

(defn runtime-session-token? [value Any] Bool
  (let [kind String (js/typeof value)]
    (and (not (nil? value))
         (or (= kind "object")
             (= kind "function")))))

(defn positive-safe-limit? [value Any] Bool
  (and (.isSafeInteger Number value)
       (pos? value)))

(defn require-workbench-policy [policy WorkbenchPolicy] WorkbenchPolicy
  (let [limits WorkbenchSequenceLimits (.-sequenceLimits policy)]
    (if (and (positive-safe-limit? (.-maxPendingObservations policy))
             (positive-safe-limit? (.-maxSessionIdentities policy))
             (positive-safe-limit? (.-maxImmutableObjects policy))
             (positive-safe-limit? (.-maxImmutableProperties policy))
             (positive-safe-limit? (.-maxEnvelopeSourceUnits policy))
             (not (nil? limits))
             (positive-safe-limit? (.-maxReceiptSequence limits))
             (>= (.-maxReceiptSequence limits) 2)
             (positive-safe-limit? (.-maxInputSequence limits))
             (positive-safe-limit? (.-maxGeneration limits))
             (positive-safe-limit? (.-maxOperationId limits))
             (positive-safe-limit? (.-maxConfigurationRevision limits)))
      policy
      (throw (new Error
              "workbench policy limits must be positive safe integers")))))

(defn envelope-array-length
  [policy WorkbenchPolicy
   source Any] Int
  (if-not (.isArray Array source)
    -1
    (let [length Any (.-length source)]
      (if (and (.isSafeInteger Number length)
               (>= length 0)
               (<= length (.-maxImmutableProperties policy)))
        length
        -1))))

(defn create-envelope-target [length Int] Any
  (let [target Any (new Array length)]
    (.setPrototypeOf Object target nil)
    target))

(defn define-envelope-index
  [target Any
   index Int
   value Any] Any
  (.defineProperty Object
                   target
                   index
                   {:configurable true
                    :enumerable true
                    :value value
                    :writable true}))

(defn envelope-primitive?
  [value Any
   value-kind String] Bool
  (or (nil? value)
      (= value-kind "string")
      (= value-kind "boolean")
      (and (= value-kind "number")
           (.isFinite Number value))))

(defn scan-envelope-copy
  [policy WorkbenchPolicy
   copy EnvelopeCopy
   copies Any
   pending (Vec EnvelopeCopy)
   targets (Vec Any)
   object-count Int
   property-count Int] EnvelopeScan
  (let [source Any (.-source copy)
        target Any (.-target copy)
        length Int (.-length target)]
    (loop [index Int 0
           next-pending (Vec EnvelopeCopy) pending
           next-targets (Vec Any) targets
           next-object-count Int object-count
           next-property-count Int property-count]
      (if (= index length)
        (->EnvelopeScanAccepted
         next-pending
         next-targets
         next-object-count
         next-property-count)
        (let [descriptor Any (.getOwnPropertyDescriptor Object source index)]
          (if (or (nil? descriptor)
                  (not (.hasOwn Object descriptor "value")))
            (->EnvelopeScanRejected)
            (let [child Any (.-value descriptor)
                  child-kind String (js/typeof child)]
              (cond
                (= child-kind "function")
                (->EnvelopeScanRejected)

                (and (= child-kind "object") (not (nil? child)))
                (if-not (.isArray Array child)
                  (->EnvelopeScanRejected)
                  (if (.has copies child)
                    (do
                      (define-envelope-index target index (.get copies child))
                      (recur (inc index)
                             next-pending
                             next-targets
                             next-object-count
                             next-property-count))
                    (let [child-length Int (envelope-array-length policy child)
                          candidate-property-count Int (+ next-property-count child-length)]
                      (if (or (< child-length 0)
                              (>= next-object-count
                                  (.-maxImmutableObjects policy))
                              (> candidate-property-count
                                 (.-maxImmutableProperties policy)))
                        (->EnvelopeScanRejected)
                        (let [child-target Any (create-envelope-target child-length)]
                          (.set copies child child-target)
                          (define-envelope-index target index child-target)
                          (recur (inc index)
                                 (conj next-pending
                                       (->EnvelopeCopy child child-target))
                                 (conj next-targets child-target)
                                 (inc next-object-count)
                                 candidate-property-count))))))

                (envelope-primitive? child child-kind)
                (do
                  (define-envelope-index target index child)
                  (recur (inc index)
                         next-pending
                         next-targets
                         next-object-count
                         next-property-count))

                :else
                (->EnvelopeScanRejected)))))))))

(js/export
  (defn create-workbench-envelope
    [incomingPolicy WorkbenchPolicy
     sourceText String] Any
    (let [policy WorkbenchPolicy (require-workbench-policy incomingPolicy)
          source-kind String (js/typeof sourceText)
          source-units Int (if (= source-kind "string")
                             (.-length sourceText)
                             -1)]
      (if (or (< source-units 0)
              (> source-units (.-maxEnvelopeSourceUnits policy)))
        (throw (new Error "workbench envelope source exceeds its policy"))
        (let [source Any (.parse JSON sourceText)
              root-length Int (envelope-array-length policy source)]
          (if (< root-length 0)
            (throw (new Error "workbench envelope source exceeds its policy"))
            (let [root Any (create-envelope-target root-length)
                  copies (JsMap Any Any) (new Map)]
              (.set copies source root)
              (loop [pending (Vec EnvelopeCopy) [(->EnvelopeCopy source root)]
                     targets (Vec Any) [root]
                     object-count Int 1
                     property-count Int root-length]
                (if (empty? pending)
                  (do
                    (doseq [target Any targets]
                      (.freeze Object target))
                    (.set envelope-measures
                          root
                          (->EnvelopeMeasure
                           object-count
                           property-count
                           source-units))
                    root)
                  (let [copy EnvelopeCopy (peek pending)
                        remaining (Vec EnvelopeCopy) (pop pending)]
                    (match (scan-envelope-copy
                            policy
                            copy
                            copies
                            remaining
                            targets
                            object-count
                            property-count)
                      [(EnvelopeScanRejected)
                       (throw (new Error
                               "workbench envelope source exceeds its policy"))]
                      [(EnvelopeScanAccepted
                        next-pending
                        next-targets
                        next-object-count
                        next-property-count)
                       (recur next-pending
                              next-targets
                              next-object-count
                              next-property-count)])))))))))))

(defn immutable-envelope?
  [policy WorkbenchPolicy
   value Any] Bool
  (try
    (let [measure Any (.get envelope-measures value)]
      (and (not (nil? measure))
           (<= (.-objectCount measure) (.-maxImmutableObjects policy))
           (<= (.-propertyCount measure) (.-maxImmutableProperties policy))
           (<= (.-sourceUnitCount measure) (.-maxEnvelopeSourceUnits policy))
           (nil? (.getPrototypeOf Object value))))
    (catch Error _error false)))

(defn require-immutable-input
  [policy WorkbenchPolicy
   value Any] Any
  (if (immutable-envelope? policy value)
    value
    (throw (new Error
            "workbench input observations require a checked immutable envelope"))))

(js/export
  (defn create-cartridge-workbench!
    [port CartridgePort
     fixedTick FixedTick
     incomingPolicy WorkbenchPolicy
     scheduleFixedTick (Fn [Int (Fn [] Any)] (Fn [] Any))
     renderFrame (Fn [Any] Any)
     emitReceipt (Fn [LifecycleReceipt] Any)
     initialPackageCandidate Any] Any
    (let [policy WorkbenchPolicy (require-workbench-policy incomingPolicy)
          sequence-limits WorkbenchSequenceLimits (.-sequenceLimits policy)
          state (Atom WorkbenchState) (atom (->WorkbenchState
                 "idle"
                 nil
                 0
                 (empty-configuration 0)
                 0
                 false))
          receipt-sequence (Atom Int) (atom 0)
          input-sequence (Atom Int) (atom 0)
          generation-sequence (Atom Int) (atom 0)
          operation-sequence (Atom Int) (atom 0)
          disposed-sessions Any (new Set)
          retirement-reservations (Atom Int) (atom 0)
          pending-input-transitions (Atom Int) (atom 0)
          input-rejection-pending (Atom Bool) (atom false)
          tick-transition-pending (Atom Bool) (atom false)
          reload-transition-pending (Atom Bool) (atom false)
          dispose-transition-pending (Atom Bool) (atom false)
          transition-queue (Atom (Vec WorkbenchTransition)) (atom [])
          dispatching (Atom Bool) (atom false)
          ticks-enabled (Atom Bool) (atom false)
          cancel-fixed-tick (Atom (Fn [] Any)) (atom (fn [] Any nil))]
      (letfn [(increment-capacity?
                [current Int
                 needed Int
                 maximum Int] Bool
                (<= needed (- maximum current)))

              (normal-receipt-capacity? [needed Int] Bool
                (<= needed
                    (- (- (.-maxReceiptSequence sequence-limits)
                          @receipt-sequence)
                       1)))

              (capacity-failure
                [receipts Int
                 inputs Int
                 generations Int
                 operations Int
                 configurations Int] Any
                (cond
                  (not (normal-receipt-capacity? receipts))
                  "receipt-sequence"

                  (not (increment-capacity?
                        @input-sequence
                        inputs
                        (.-maxInputSequence sequence-limits)))
                  "input-sequence"

                  (not (increment-capacity?
                        @generation-sequence
                        generations
                        (.-maxGeneration sequence-limits)))
                  "generation-sequence"

                  (not (increment-capacity?
                        @operation-sequence
                        operations
                        (.-maxOperationId sequence-limits)))
                  "operation-sequence"

                  (not (increment-capacity?
                        (.-revision (.-configuration @state))
                        configurations
                        (.-maxConfigurationRevision sequence-limits)))
                  "configuration-revision"

                  :else
                  nil))

              (counter-exhausted-with-session!
                [domain String
                 uninstalled-session Any] Any
                (let [current WorkbenchState @state]
                  (when (not (.-disposed current))
                    (let [active ActiveRuntime? (.-active current)
                          generation Int (active-generation active)
                          cancel Any @cancel-fixed-tick]
                      (reset! state
                              (->WorkbenchState
                               "disposed"
                               active
                               0
                               (.-configuration current)
                               (.-latestReload current)
                               true))
                      (reset! ticks-enabled false)
                      (reset! cancel-fixed-tick (fn [] Any nil))
                      (let [cancel-uncertain Bool (try
                                                    (do
                                                      (cancel)
                                                      false)
                                                    (catch Error _error true))
                            active-disposal-uncertain Bool (if (nil? active)
                                                              false
                                                              (dispose-session-once!
                                                               (.-session active)))
                            uninstalled-disposal-uncertain Bool (if (nil?
                                                                      uninstalled-session)
                                                                  false
                                                                  (dispose-session-once!
                                                                   uninstalled-session))
                            disposal-uncertain Bool (or
                                                      active-disposal-uncertain
                                                      uninstalled-disposal-uncertain)
                            sequence Int (swap! receipt-sequence inc)
                            detail String (cond
                                            (and cancel-uncertain
                                                 disposal-uncertain)
                                            (str domain
                                                 ":cancel-and-disposal-uncertain")

                                            cancel-uncertain
                                            (str domain ":cancel-uncertain")

                                            disposal-uncertain
                                            (str domain ":disposal-uncertain")

                                            :else
                                            domain)
                            receipt LifecycleReceipt (->LifecycleReceipt
                             lifecycle-schema
                             sequence
                             "counter-exhausted"
                             "disposed"
                             generation
                             generation
                             0
                             (.-revision (.-configuration current))
                             (active-revision active)
                             detail)]
                        (try
                          (emitReceipt receipt)
                          (catch Error _error nil))
                        (reset! state
                                (->WorkbenchState
                                 "disposed"
                                 nil
                                 0
                                 (.-configuration current)
                                 (.-latestReload current)
                                 true))
                        (maybe-release-retired-sessions!))))))

              (counter-exhausted! [domain String] Any
                (counter-exhausted-with-session! domain nil))

              (ensure-capacity!
                [receipts Int
                 inputs Int
                 generations Int
                 operations Int
                 configurations Int] Bool
                (let [failure Any (capacity-failure
                                   receipts
                                   inputs
                                   generations
                                   operations
                                   configurations)]
                  (if (nil? failure)
                    true
                    (do
                      (counter-exhausted! failure)
                      false))))

              (ensure-capacity-retiring!
                [receipts Int
                 inputs Int
                 generations Int
                 operations Int
                 configurations Int
                 uninstalled-session Any] Bool
                (let [failure Any (capacity-failure
                                   receipts
                                   inputs
                                   generations
                                   operations
                                   configurations)]
                  (if (nil? failure)
                    true
                    (do
                      (counter-exhausted-with-session!
                       failure
                       uninstalled-session)
                      false))))

              (emit-lifecycle-for!
                [event String
                 operation-generation Int
                 operation-id Int
                 detail String] Any
                (if (normal-receipt-capacity? 1)
                  (let [current WorkbenchState @state
                        active ActiveRuntime? (.-active current)
                        sequence Int (swap! receipt-sequence inc)
                        receipt LifecycleReceipt (->LifecycleReceipt
                         lifecycle-schema
                         sequence
                         event
                         (.-phase current)
                         (active-generation active)
                         operation-generation
                         operation-id
                         (.-revision (.-configuration current))
                         (active-revision active)
                         detail)]
                    (try
                      (emitReceipt receipt)
                      (catch Error _error nil)))
                  (counter-exhausted! "receipt-sequence")))

              (emit-lifecycle!
                [event String
                 operation-generation Int
                 detail String] Any
                (emit-lifecycle-for!
                 event
                 operation-generation
                 (.-operationId @state)
                 detail))

              (one-shot-transition! [] Any
                (let [completed (Atom Bool) (atom false)]
                  (fn [transition WorkbenchTransition] Any
                    (if @completed
                      false
                      (do
                        (reset! completed true)
                        (dispatch! transition)
                        true)))))

              (maybe-release-retired-sessions! [] Any
                (when (and (.-disposed @state)
                           (= 0 @retirement-reservations))
                  (.clear disposed-sessions)))

              (dispose-session-once! [session Any] Any
                (if (and (runtime-session-token? session)
                         (not (.has disposed-sessions session)))
                  (do
                    (when (>= (.-size disposed-sessions)
                              (.-maxSessionIdentities policy))
                      (throw (new Error
                              "retired RuntimeSession identity bound exceeded")))
                    (.add disposed-sessions session)
                    (try
                      (do
                        ((.-disposeSession port) session)
                        false)
                      (catch Error _error true)))
                  false))

              (restore-settled-phase! [] Any
                (let [current WorkbenchState @state
                      active ActiveRuntime? (.-active current)]
                  (reset! state
                          (->WorkbenchState
                           (settled-phase active)
                           active
                           0
                           (.-configuration current)
                           (.-latestReload current)
                           (.-disposed current)))))

              (install-authority!
                [generation Int
                 session Any
                 revision Any
                 frame Any
                 reset-configuration Bool
                 uninstalled-session Any
                 accepted-event String
                 accepted-detail String] Any
                (let [configuration-increment Int (if reset-configuration 1 0)]
                  (when (ensure-capacity-retiring!
                         3
                         0
                         0
                         0
                         configuration-increment
                         uninstalled-session)
                    (let [current WorkbenchState @state
                          operation-id Int (.-operationId current)
                          previous ActiveRuntime? (.-active current)
                          previous-session Any (if (nil? previous)
                                                 nil
                                                 (.-session previous))
                          configuration InputConfiguration (.-configuration current)
                          next-configuration InputConfiguration (if reset-configuration
                            (empty-configuration (inc (.-revision configuration)))
                            configuration)
                          next-active ActiveRuntime (->ActiveRuntime generation session revision frame)]
                      (reset! state
                              (->WorkbenchState
                               "successor"
                               next-active
                               operation-id
                               next-configuration
                               (.-latestReload current)
                               false))
                      (emit-lifecycle!
                       accepted-event
                       generation
                       accepted-detail)
                      (emit-lifecycle!
                       "successor-installed"
                       generation
                       "port-successor")
                      (reset! state
                              (->WorkbenchState
                               "render"
                               next-active
                               operation-id
                               next-configuration
                               (.-latestReload current)
                               false))
                      (let [render-event String (try
                                                  (do
                                                    (renderFrame frame)
                                                    "frame-rendered")
                                                  (catch Error _error
                                                    "frame-render-failed"))]
                        (reset! state
                                (->WorkbenchState
                                 "ready"
                                 next-active
                                 0
                                 next-configuration
                                 (.-latestReload current)
                                 false))
                        (let [disposal-uncertain Bool (if (and
                                                           (not (nil? previous-session))
                                                           (not (identical?
                                                                 previous-session
                                                                 session)))
                                                          (dispose-session-once!
                                                           previous-session)
                                                          false)
                              detail String (cond
                                              disposal-uncertain
                                              "prior-session-disposal-uncertain"

                                              (= render-event "frame-rendered")
                                              "port-frame"

                                              :else
                                              "renderer-threw")]
                          (emit-lifecycle-for!
                           render-event
                           generation
                           operation-id
                           detail)))))))

              (stale-completion!
                [operation-generation Int
                 operation-id Int
                 detail String] Any
                (when (and (not (.-disposed @state))
                           (ensure-capacity! 1 0 0 0 0))
                  (emit-lifecycle-for!
                   "completion-stale"
                   operation-generation
                   operation-id
                   detail)))

              (apply-transition! [transition WorkbenchTransition] Any
                (match transition
                  [(ObserveInput value)
                   (let [_remaining-input-transitions Int (swap! pending-input-transitions dec)
                         current WorkbenchState @state]
                     (when (and (not (.-disposed current))
                                (ensure-capacity! 1 1 0 0 1))
                       (let [configuration InputConfiguration (.-configuration current)
                             observation-sequence Int (swap! input-sequence inc)
                             observation InputObservation (->InputObservation
                              observation-sequence
                              value)
                             observations (Vec InputObservation) (.freeze Object
                                      (conj (.-observations configuration)
                                            observation))
                             next-configuration InputConfiguration (->InputConfiguration
                              (inc (.-revision configuration))
                              observations)]
                         (reset! state
                                 (->WorkbenchState
                                  (.-phase current)
                                  (.-active current)
                                  (.-operationId current)
                                  next-configuration
                                  (.-latestReload current)
                                  false))
                         (emit-lifecycle!
                          "configuration-observed"
                          (active-generation (.-active current))
                          "input"))))]

                  [(InputRejected)
                   (try
                     (let [current WorkbenchState @state]
                       (when (and (not (.-disposed current))
                                  (ensure-capacity! 1 0 0 0 0))
                         (emit-lifecycle!
                          "configuration-input-rejected"
                          (active-generation (.-active current))
                          "pending-observation-limit")))
                     (finally
                       (reset! input-rejection-pending false)))]

                  [(FixedTickElapsed)
                   (do
                     (reset! tick-transition-pending false)
                     (let [current WorkbenchState @state
                           active ActiveRuntime? (.-active current)]
                       (when (and (not (.-disposed current))
                                  (= (.-phase current) "ready")
                                  (not (nil? active))
                                  (ensure-capacity! 1 0 0 1 1))
                         (let [generation Int (.-generation active)
                               operation-id Int (swap! operation-sequence inc)
                               configuration InputConfiguration (.-configuration current)]
                           (reset! state
                                   (->WorkbenchState
                                    "candidate"
                                    active
                                    operation-id
                                    (empty-configuration
                                     (inc (.-revision configuration)))
                                    (.-latestReload current)
                                    false))
                           (emit-lifecycle!
                            "candidate-requested"
                            generation
                            "fixed-tick")
                           (let [settle Any (one-shot-transition!)]
                             (try
                               ((.-runCandidate port)
                                (.-session active)
                                fixedTick
                                configuration
                                (fn [completion CandidateCompletion] Any
                                  (settle
                                   (->CandidateCompleted
                                    generation
                                    operation-id
                                    completion))))
                               (catch Error _error
                                 (settle
                                  (->CandidateBoundaryFailed
                                   generation
                                   operation-id)))))))))]

                  [(CandidateCompleted generation operation-id completion)
                   (let [current WorkbenchState @state
                         active ActiveRuntime? (.-active current)]
                     (if (or (.-disposed current)
                             (nil? active)
                             (not= generation (.-generation active))
                             (not= operation-id (.-operationId current))
                             (not= (.-phase current) "candidate"))
                       (stale-completion! generation operation-id "candidate")
                       (match completion
                         [(CandidateFailed reason)
                          (when (ensure-capacity! 1 0 0 0 0)
                            (emit-lifecycle!
                             "candidate-failed"
                             generation
                             reason)
                            (restore-settled-phase!))]

                         [(CandidateProduced candidate)
                          (when (ensure-capacity! 2 0 0 0 0)
                            (reset! state
                                    (->WorkbenchState
                                     "admission"
                                     active
                                     operation-id
                                     (.-configuration current)
                                     (.-latestReload current)
                                     false))
                            (emit-lifecycle!
                             "candidate-produced"
                             generation
                             "candidate")
                            (emit-lifecycle!
                             "admission-requested"
                             generation
                             "candidate")
                            (let [settle Any (one-shot-transition!)]
                              (try
                                ((.-requestAdmission port)
                                 (.-session active)
                                 candidate
                                 (fn [result AdmissionCompletion] Any
                                   (settle
                                    (->AdmissionCompleted
                                     generation
                                     operation-id
                                     result))))
                                (catch Error _error
                                  (settle
                                   (->AdmissionBoundaryFailed
                                    generation
                                    operation-id))))))])))]

                  [(CandidateBoundaryFailed generation operation-id)
                   (let [current WorkbenchState @state
                         active ActiveRuntime? (.-active current)]
                     (if (or (.-disposed current)
                             (nil? active)
                             (not= generation (.-generation active))
                             (not= operation-id (.-operationId current))
                             (not= (.-phase current) "candidate"))
                       (stale-completion!
                        generation
                        operation-id
                        "candidate-boundary")
                       (when (ensure-capacity! 1 0 0 0 0)
                         (emit-lifecycle-for!
                          "candidate-boundary-failed"
                          generation
                          operation-id
                          "port-threw")
                         (restore-settled-phase!))))]

                  [(AdmissionCompleted generation operation-id completion)
                   (let [current WorkbenchState @state
                         active ActiveRuntime? (.-active current)]
                     (if (or (.-disposed current)
                             (nil? active)
                             (not= generation (.-generation active))
                             (not= operation-id (.-operationId current))
                             (not= (.-phase current) "admission"))
                       (stale-completion! generation operation-id "admission")
                       (match completion
                         [(AdmissionRejected reason)
                          (when (ensure-capacity! 1 0 0 0 0)
                            (emit-lifecycle!
                             "admission-rejected"
                             generation
                             reason)
                            (restore-settled-phase!))]

                         [(AdmissionAccepted _successor revision frame)
                          (if (not (immutable-envelope? policy frame))
                            (when (ensure-capacity! 1 0 0 0 0)
                              (emit-lifecycle!
                               "admission-frame-rejected"
                               generation
                               "frame-not-deeply-immutable")
                              (restore-settled-phase!))
                            (install-authority!
                             generation
                             (.-session active)
                             revision
                             frame
                             false
                             nil
                             "admission-accepted"
                             "successor"))])))]

                  [(AdmissionBoundaryFailed generation operation-id)
                   (let [current WorkbenchState @state
                         active ActiveRuntime? (.-active current)]
                     (if (or (.-disposed current)
                             (nil? active)
                             (not= generation (.-generation active))
                             (not= operation-id (.-operationId current))
                             (not= (.-phase current) "admission"))
                       (stale-completion!
                        generation
                        operation-id
                        "admission-boundary")
                       (when (ensure-capacity! 1 0 0 0 0)
                         (emit-lifecycle-for!
                          "admission-boundary-failed"
                          generation
                          operation-id
                          "port-threw")
                         (restore-settled-phase!))))]

                  [(ReloadRequested package-candidate)
                   (do
                     (reset! reload-transition-pending false)
                     (let [current WorkbenchState @state]
                       (cond
                         (.-disposed current)
                         nil

                         (= (.-phase current) "session-start")
                         (when (ensure-capacity! 1 0 0 0 0)
                           (emit-lifecycle!
                            "reload-rejected"
                            (.-latestReload current)
                            "runtime-session-start-pending"))

                         :else
                         (when (ensure-capacity! 1 0 1 0 0)
                           (let [generation Int (swap! generation-sequence inc)]
                             (reset! state
                                     (->WorkbenchState
                                      "package-check"
                                      (.-active current)
                                      0
                                      (.-configuration current)
                                      generation
                                      false))
                             (emit-lifecycle!
                              "reload-requested"
                              generation
                              "package-candidate")
                             (let [settle Any (one-shot-transition!)]
                               (try
                                 ((.-acceptPackage port)
                                  package-candidate
                                  (fn [completion PackageCheck] Any
                                    (settle
                                     (->PackageCompleted
                                      generation
                                      completion))))
                                 (catch Error _error
                                   (settle
                                    (->PackageBoundaryFailed
                                     generation))))))))))]

                  [(PackageCompleted generation completion)
                   (let [current WorkbenchState @state]
                     (if (or (.-disposed current)
                             (not= generation (.-latestReload current))
                             (not= (.-phase current) "package-check"))
                       (stale-completion! generation 0 "package")
                       (match completion
                         [(PackageRejected reason)
                          (when (ensure-capacity! 1 0 0 0 0)
                            (restore-settled-phase!)
                            (emit-lifecycle!
                             "package-rejected"
                             generation
                             reason))]

                         [(PackageAccepted accepted-package)
                          (let [active ActiveRuntime? (.-active current)
                                active-count Int (if (nil? active) 0 1)
                                retired-count Int (.-size disposed-sessions)
                                used-identities Int (+ retired-count
                                   active-count
                                   @retirement-reservations)]
                            (if (>= used-identities
                                    (.-maxSessionIdentities policy))
                              (do
                                (when (ensure-capacity! 1 0 0 0 0)
                                  (emit-lifecycle!
                                   "session-identity-limit"
                                   generation
                                   "reload-rejected")
                                  (restore-settled-phase!)))
                              (when (ensure-capacity! 1 0 0 0 0)
                                (let [prior-session Any (if (nil? active)
                                                          nil
                                                          (.-session active))]
                                  (reset! state
                                          (->WorkbenchState
                                           "session-start"
                                           active
                                           0
                                           (.-configuration current)
                                           generation
                                           false))
                                  (emit-lifecycle!
                                   "package-accepted"
                                   generation
                                   "accepted-package")
                                  (swap! retirement-reservations inc)
                                  (let [callback-completed (Atom Bool) (atom false)
                                        boundary-reported (Atom Bool) (atom false)
                                        complete-session! Any (fn [result SessionCompletion] Any
                                         (if @callback-completed
                                           false
                                           (do
                                             (reset! callback-completed true)
                                             (dispatch!
                                              (->SessionCompleted
                                               generation
                                               prior-session
                                               result))
                                             true)))]
                                    (try
                                      ((.-startSession port)
                                       accepted-package
                                       generation
                                       complete-session!)
                                      (catch Error _error
                                        (when (and (not @callback-completed)
                                                   (not @boundary-reported))
                                          (reset! boundary-reported true)
                                          (dispatch!
                                           (->SessionBoundaryFailed
                                            generation
                                            prior-session))))))))))])))]

                  [(PackageBoundaryFailed generation)
                   (let [current WorkbenchState @state]
                     (if (or (.-disposed current)
                             (not= generation (.-latestReload current))
                             (not= (.-phase current) "package-check"))
                       (stale-completion! generation 0 "package-boundary")
                       (when (ensure-capacity! 1 0 0 0 0)
                         (restore-settled-phase!)
                         (emit-lifecycle-for!
                          "package-boundary-failed"
                          generation
                          0
                          "port-threw"))))]

                  [(ReloadRejected)
                   (try
                     (let [current WorkbenchState @state]
                       (when (and (not (.-disposed current))
                                  (ensure-capacity! 1 0 0 0 0))
                         (emit-lifecycle!
                          "reload-rejected"
                          (.-latestReload current)
                          "runtime-session-start-pending")))
                     (finally
                       (reset! reload-transition-pending false)))]

                  [(SessionCompleted generation prior-session completion)
                   (let [_remaining-reservations Int (swap! retirement-reservations dec)
                         current WorkbenchState @state
                         current-completion Bool (and (not (.-disposed current))
                              (= generation (.-latestReload current))
                              (= (.-phase current) "session-start"))]
                     (if (not current-completion)
                       (let [can-emit Bool (ensure-capacity! 1 0 0 0 0)
                             disposal-uncertain Bool (match completion
                             [(SessionStarted session _revision _frame)
                              (let [active ActiveRuntime? (.-active current)
                                    current-session Any (if (nil? active)
                                                          nil
                                                          (.-session active))]
                                (if (and (runtime-session-token? session)
                                         (not (identical? session prior-session))
                                         (not (identical? session current-session))
                                         (not (.has disposed-sessions session)))
                                  (dispose-session-once! session)
                                  false))]
                             [(SessionFailed _reason) false])]
                         (when can-emit
                           (emit-lifecycle-for!
                            "completion-stale"
                            generation
                            0
                            (if disposal-uncertain
                              "session-disposal-uncertain"
                              "session")))
                         (maybe-release-retired-sessions!))
                       (match completion
                         [(SessionFailed reason)
                          (when (ensure-capacity! 1 0 0 0 0)
                            (restore-settled-phase!)
                            (emit-lifecycle!
                             "session-failed"
                             generation
                             reason))]

                         [(SessionStarted session revision frame)
                          (let [previous ActiveRuntime? (.-active current)
                                previous-session Any (if (nil? previous)
                                                       nil
                                                       (.-session previous))]
                            (cond
                              (not (runtime-session-token? session))
                              (when (ensure-capacity! 1 0 0 0 0)
                                (restore-settled-phase!)
                                (emit-lifecycle!
                                 "session-invalid"
                                 generation
                                 "runtime-session-reference-required"))

                              (.has disposed-sessions session)
                              (when (ensure-capacity! 1 0 0 0 0)
                                (restore-settled-phase!)
                                (emit-lifecycle!
                                 "session-retired"
                                 generation
                                 "retired-runtime-session-rejected"))

                              (and (not (nil? previous-session))
                                   (identical? previous-session session))
                              (when (ensure-capacity! 1 0 0 0 0)
                                (restore-settled-phase!)
                                (emit-lifecycle!
                                 "session-reused"
                                 generation
                                 "fresh-runtime-session-required"))

                              (not (immutable-envelope? policy frame))
                              (when (ensure-capacity-retiring!
                                     1 0 0 0 0 session)
                                (let [disposal-uncertain Bool (dispose-session-once!
                                                               session)]
                                  (restore-settled-phase!)
                                  (emit-lifecycle!
                                   "session-frame-rejected"
                                   generation
                                   (if disposal-uncertain
                                     "session-disposal-uncertain"
                                     "frame-not-deeply-immutable"))))

                              :else
                              (install-authority!
                               generation
                               session
                               revision
                               frame
                               true
                               session
                               "session-started"
                               "fresh-runtime-session")))])))]

                  [(SessionBoundaryFailed generation _prior-session)
                   (let [current WorkbenchState @state
                         current-completion Bool (and (not (.-disposed current))
                              (= generation (.-latestReload current))
                              (= (.-phase current) "session-start"))]
                     (if current-completion
                       (when (ensure-capacity! 1 0 0 0 0)
                         (restore-settled-phase!)
                         (emit-lifecycle-for!
                          "session-boundary-failed"
                          generation
                          0
                          "port-threw"))
                       (stale-completion!
                        generation
                        0
                        "session-boundary"))
                     (maybe-release-retired-sessions!))]

                  [(DisposeRequested)
                   (do
                     (reset! dispose-transition-pending false)
                     (let [current WorkbenchState @state]
                       (when (and (not (.-disposed current))
                                  (ensure-capacity! 1 0 0 0 0))
                         (let [active ActiveRuntime? (.-active current)
                               generation Int (active-generation active)
                               cancel Any @cancel-fixed-tick]
                           (reset! state
                                   (->WorkbenchState
                                    "disposed"
                                    active
                                    0
                                    (.-configuration current)
                                    (.-latestReload current)
                                    true))
                           (reset! ticks-enabled false)
                           (reset! cancel-fixed-tick (fn [] Any nil))
                           (let [cancel-uncertain Bool (try
                                                         (do
                                                           (cancel)
                                                           false)
                                                         (catch Error _error true))
                                 disposal-uncertain Bool (if (nil? active)
                                                            false
                                                            (dispose-session-once!
                                                             (.-session active)))
                                 detail String (cond
                                                 (and cancel-uncertain
                                                      disposal-uncertain)
                                                 "terminal-cancel-and-disposal-uncertain"

                                                 cancel-uncertain
                                                 "terminal-cancel-uncertain"

                                                 disposal-uncertain
                                                 "terminal-disposal-uncertain"

                                                 :else
                                                 "terminal")]
                             (emit-lifecycle!
                              "disposed"
                              generation
                              detail)
                             (reset! state
                                     (->WorkbenchState
                                      "disposed"
                                      nil
                                      0
                                      (.-configuration current)
                                      (.-latestReload current)
                                      true))
                             (maybe-release-retired-sessions!))))))]))

              (dispatch! [transition WorkbenchTransition] Any
                (.push @transition-queue transition)
                (when (not @dispatching)
                  (reset! dispatching true)
                  (try
                    (loop []
                      (when (pos? (count @transition-queue))
                        (let [next-transition WorkbenchTransition (first @transition-queue)]
                          (reset! transition-queue
                                  (vec (rest @transition-queue)))
                          (apply-transition! next-transition)
                          (recur))))
                    (finally
                      (reset! dispatching false)))))

              (observe-input! [value Any] Bool
                (let [current WorkbenchState @state
                      configuration InputConfiguration (.-configuration current)
                      retained-inputs Int (+ (count (.-observations configuration))
                                             @pending-input-transitions)]
                  (cond
                    (.-disposed current)
                    false

                    (>= retained-inputs (.-maxPendingObservations policy))
                    (do
                      (when (not @input-rejection-pending)
                        (reset! input-rejection-pending true)
                        (dispatch! (->InputRejected)))
                      false)

                    :else
                    (let [accepted-value Any (require-immutable-input policy value)]
                      (swap! pending-input-transitions inc)
                      (dispatch! (->ObserveInput accepted-value))
                      true))))

              (reload-package! [package-candidate Any] Bool
                (let [current WorkbenchState @state]
                  (cond
                    (.-disposed current)
                    false

                    @reload-transition-pending
                    false

                    (= (.-phase current) "package-check")
                    false

                    (= (.-phase current) "session-start")
                    (do
                      (reset! reload-transition-pending true)
                      (dispatch! (->ReloadRejected))
                      false)

                    :else
                    (do
                      (reset! reload-transition-pending true)
                      (dispatch! (->ReloadRequested package-candidate))
                      true))))

              (fixed-tick-elapsed! [] Bool
                (let [current WorkbenchState @state]
                  (if (or (not @ticks-enabled)
                          (.-disposed current)
                          @tick-transition-pending)
                    false
                    (do
                      (reset! tick-transition-pending true)
                      (dispatch! (->FixedTickElapsed))
                      true))))

              (dispose-workbench! [] Bool
                (let [current WorkbenchState @state]
                  (if (or (.-disposed current)
                          @dispose-transition-pending)
                    false
                    (do
                      (reset! dispose-transition-pending true)
                      (dispatch! (->DisposeRequested))
                      true))))

              (snapshot! [] WorkbenchSnapshot
                (let [current WorkbenchState @state
                      active ActiveRuntime? (.-active current)
                      configuration InputConfiguration (.-configuration current)]
                  (->WorkbenchSnapshot
                   (.-phase current)
                   (active-generation active)
                   (.-operationId current)
                   (.-revision configuration)
                   (count (.-observations configuration))
                   (active-revision active)
                   (active-frame active)
                   (.-disposed current))))]
        (let [scheduled Bool (try
                               (let [cancel Any (scheduleFixedTick
                                                 (.-milliseconds fixedTick)
                                                 fixed-tick-elapsed!)]
                                 (if (= (js/typeof cancel) "function")
                                   (do
                                     (reset! cancel-fixed-tick cancel)
                                     (reset! ticks-enabled true)
                                     true)
                                   (throw (new Error
                                           "fixed-tick scheduler must return a cancellation function"))))
                               (catch Error _error
                                 (do
                                   (reset! ticks-enabled false)
                                   (reset! state
                                           (->WorkbenchState
                                            "disposed"
                                            nil
                                            0
                                            (empty-configuration 0)
                                            0
                                            true))
                                   (emit-lifecycle-for!
                                    "fixed-tick-schedule-uncertain"
                                    0
                                    0
                                    "scheduler-threw")
                                   false)))]
          (when scheduled
            (dispatch! (->ReloadRequested initialPackageCandidate)))
          (.freeze Object
                   {:observeInput observe-input!
                    :reloadPackage reload-package!
                    :snapshot snapshot!
                    :dispose dispose-workbench!}))))))
