#lang beagle/js

(ns jump-arena-shell.branch-wasm-port
  (:require [jump-arena-shell.wasm-cartridge-port :as wire]))

(def identity-bytes Int 32)
(def branch-command-max-bytes Int (* 1024 1024))
(def branch-event-max-bytes Int (* 64 1024))
(def branch-open-max-bytes Int (* 4 1024 1024))

(js/export
  (defrecord WasmProcessBranch
    [handle Any
     sequence Any
     disposed Any
     opened Any]))

(defn identity-at
  [bytes Any
   offset Int] Any
  (wire/frozen-byte-range bytes offset (+ offset identity-bytes)))

(defn append-u16!
  [bytes Any
   value Int] Any
  (do
    (.push bytes (rem value 256))
    (.push bytes (rem (quot value 256) 256))))

(defn append-occurrences!
  [bytes Any
   occurrences Any] Any
  (let [count Int (.-length occurrences)]
    (when (or (= count 0) (> count 256))
      (throw (new Error "branch occurrence sequence is outside its bound")))
    (append-u16! bytes count)
    (doseq [occurrence Any occurrences]
      (when-not (wire/exact-byte-array? occurrence branch-command-max-bytes)
        (throw (new Error "branch occurrence must carry bounded exact bytes")))
      (wire/append-blob! bytes occurrence))))

(defn parse-identity-list
  [bytes Any
   offset Int
   label String] Any
  (let [count Int (wire/little-u16 bytes offset)
        start Int (wire/require-range bytes offset 2 label)
        end Int (wire/require-range bytes start (* count identity-bytes) label)]
    {:values (loop [index Int 0
                    values (Vec Any) []]
               (if (= index count)
                 (.freeze Object values)
                 (recur (inc index)
                        (conj values (identity-at bytes (+ start (* index identity-bytes)))))))
     :next end}))

(defn parse-occurrences
  [bytes Any
   offset Int
   label String] Any
  (let [count Int (wire/little-u16 bytes offset)
        start Int (wire/require-range bytes offset 2 label)]
    (when (or (= count 0) (> count 256))
      (throw (new Error (str label " count is outside its bound"))))
    (loop [index Int 0
           cursor Int start
           values (Vec Any) []]
      (if (= index count)
        {:values (.freeze Object values) :next cursor}
        (let [record Any (wire/parse-blob bytes cursor branch-command-max-bytes label)]
          (recur (inc index)
                 (.-next record)
                 (conj values (.-bytes record))))))))

(defn parse-pins
  [bytes Any
   offset Int] Any
  (let [end Int (wire/require-range bytes offset 308 "branch pins")]
    {:value
     {:parentState (identity-at bytes offset)
      :programRevision (identity-at bytes (+ offset 32))
      :packageId (identity-at bytes (+ offset 64))
      :applicationSnapshot (identity-at bytes (+ offset 96))
      :applicationLocal (wire/little-u32 bytes (+ offset 128))
      :sessionId (identity-at bytes (+ offset 132))
      :runtimePolicy (identity-at bytes (+ offset 164))
      :rootPolicy (identity-at bytes (+ offset 196))
      :inputEvidence (identity-at bytes (+ offset 228))
      :physicalPlan (identity-at bytes (+ offset 260))
      :budgetUnits (wire/little-safe-u64 bytes (+ offset 292))
      :disconnectTick (wire/little-safe-u64 bytes (+ offset 300))}
     :next end}))

(defn parse-ancestry
  [bytes Any
   offset Int] Any
  (let [end Int (wire/require-range bytes offset (* 6 identity-bytes)
                                    "branch ancestry")]
    {:value
     {:parentState (identity-at bytes offset)
      :run (identity-at bytes (+ offset 32))
      :activation (identity-at bytes (+ offset 64))
      :disconnectStep (identity-at bytes (+ offset 96))
      :suspensionStep (identity-at bytes (+ offset 128))
      :continuation (identity-at bytes (+ offset 160))}
     :next end}))

(defn parse-suspension
  [bytes Any
   offset Int] Any
  (let [end Int (wire/require-range bytes offset (+ (* 6 identity-bytes) 8)
                                    "branch suspension")]
    {:value
     {:step (identity-at bytes offset)
      :continuation (identity-at bytes (+ offset 32))
      :run (identity-at bytes (+ offset 64))
      :activation (identity-at bytes (+ offset 96))
      :before (identity-at bytes (+ offset 128))
      :after (identity-at bytes (+ offset 160))
      :remainingBudget (wire/little-safe-u64 bytes (+ offset 192))}
     :next end}))

(defn parse-resumption
  [bytes Any
   offset Int] Any
  (let [end Int (wire/require-range bytes offset (+ (* 7 identity-bytes) 8)
                                    "branch resumption")]
    {:value
     {:occurrence (identity-at bytes offset)
      :step (identity-at bytes (+ offset 32))
      :continuation (identity-at bytes (+ offset 64))
      :run (identity-at bytes (+ offset 96))
      :activation (identity-at bytes (+ offset 128))
      :before (identity-at bytes (+ offset 160))
      :after (identity-at bytes (+ offset 192))
      :remainingBudget (wire/little-safe-u64 bytes (+ offset 224))}
     :next end}))

(js/export
  (defn decode-reconnect-evidence [bytes Any] Any
    (if-not (wire/exact-byte-array? bytes branch-event-max-bytes)
      (throw (new Error "reconnect evidence must carry bounded exact bytes"))
      (do
        (when (or (< (.-length bytes) 4)
                  (not= (wire/frozen-byte-range bytes 0 4) [67 82 69 49]))
          (throw (new Error "reconnect evidence magic is invalid")))
        (let [pins Any (parse-pins bytes 4)
              ancestry Any (parse-ancestry bytes (.-next pins))
              resumption Any (parse-resumption bytes (.-next ancestry))
              commands Any (parse-occurrences bytes (.-next resumption)
                                               "reconnect commands")
              steps Any (parse-identity-list bytes (.-next commands) "branch steps")
              observations Any (parse-identity-list bytes (.-next steps)
                                                     "branch observations")
              candidate-offset Int (.-next observations)
              final-end Int (wire/require-range bytes candidate-offset
                                                (* 2 identity-bytes)
                                                "reconnect candidate")]
          (when (not= final-end (.-length bytes))
            (throw (new Error "reconnect evidence has trailing bytes")))
          {:pins (.-value pins)
           :ancestry (.-value ancestry)
           :resumption (.-value resumption)
           :commands (.-values commands)
           :steps (.-values steps)
           :observations (.-values observations)
           :candidate (identity-at bytes candidate-offset)
           :candidateStep (identity-at bytes (+ candidate-offset identity-bytes))
           :exactBytes bytes})))))

(defn parse-causal-ref
  [bytes Any
   offset Int] Any
  (let [tag-end Int (wire/require-range bytes offset 1 "causal reference")
        tag Int (wire/byte-at bytes offset)]
    (if (= tag 5)
      (let [end Int (wire/require-range bytes tag-end (* 3 identity-bytes)
                                        "causal Step reference")]
        {:value {:kind tag
                 :run (identity-at bytes tag-end)
                 :activation (identity-at bytes (+ tag-end 32))
                 :step (identity-at bytes (+ tag-end 64))}
         :next end})
      (do
        (when (or (< tag 0) (> tag 9))
          (throw (new Error "causal reference tag is invalid")))
        (let [end Int (wire/require-range bytes tag-end identity-bytes
                                          "causal identity reference")]
          {:value {:kind tag :identity (identity-at bytes tag-end)}
           :next end})))))

(defn parse-causal-predecessors
  [bytes Any
   offset Int] Any
  (let [count Int (wire/little-u16 bytes offset)
        start Int (wire/require-range bytes offset 2 "causal predecessor count")]
    (loop [index Int 0
           cursor Int start
           values (Vec Any) []]
      (if (= index count)
        {:values (.freeze Object values) :next cursor}
        (let [reference Any (parse-causal-ref bytes cursor)]
          (recur (inc index)
                 (.-next reference)
                 (conj values (.-value reference))))))))

(defn parse-causal-records
  [bytes Any
   offset Int] Any
  (let [count Int (wire/little-u16 bytes offset)
        start Int (wire/require-range bytes offset 2 "causal record count")]
    (when (> count 2048)
      (throw (new Error "causal record count exceeds its bound")))
    (loop [index Int 0
           cursor Int start
           values (Vec Any) []]
      (if (= index count)
        {:values (.freeze Object values) :next cursor}
        (let [occurrence Any (parse-causal-ref bytes cursor)
              predecessors Any (parse-causal-predecessors bytes (.-next occurrence))]
          (recur (inc index)
                 (.-next predecessors)
                 (conj values {:occurrence (.-value occurrence)
                               :predecessors (.-values predecessors)})))))))

(js/export
  (defn decode-branch-explanation [bytes Any] Any
    (if-not (wire/exact-byte-array? bytes branch-event-max-bytes)
      (throw (new Error "branch explanation must carry bounded exact bytes"))
      (do
        (when (or (< (.-length bytes) 4)
                  (not= (wire/frozen-byte-range bytes 0 4) [67 66 88 49]))
          (throw (new Error "branch explanation magic is invalid")))
        (let [pins Any (parse-pins bytes 4)
              ancestry Any (parse-ancestry bytes (.-next pins))
              resumption Any (parse-resumption bytes (.-next ancestry))
              branch-steps Any (parse-identity-list bytes (.-next resumption)
                                                    "explanation branch steps")
              branch-observations Any (parse-identity-list bytes (.-next branch-steps)
                                                           "explanation branch observations")
              branch-observations-end Int (.-next branch-observations)
              authority-prefix Int (wire/require-range bytes branch-observations-end
                                                       (* 4 identity-bytes)
                                                       "explanation authority prefix")
              authoritative-steps Any (parse-identity-list bytes authority-prefix
                                                           "explanation authority steps")
              authoritative-observations Any (parse-identity-list
                                               bytes (.-next authoritative-steps)
                                               "explanation authority observations")
              authoritative-observations-end Int (.-next authoritative-observations)
              authority-suffix Int (wire/require-range bytes
                                                        authoritative-observations-end
                                                        (* 5 identity-bytes)
                                                        "explanation authority suffix")
              causal Any (parse-causal-records bytes authority-suffix)]
          (when (not= (.-next causal) (.-length bytes))
            (throw (new Error "branch explanation has trailing bytes")))
          {:pins (.-value pins)
           :ancestry (.-value ancestry)
           :resumption (.-value resumption)
           :branchSteps (.-values branch-steps)
           :branchObservations (.-values branch-observations)
           :branchCandidate (identity-at bytes branch-observations-end)
           :authoritativeBase (identity-at bytes (+ branch-observations-end 32))
           :authoritativeRun (identity-at bytes (+ branch-observations-end 64))
           :authoritativeActivation (identity-at bytes (+ branch-observations-end 96))
           :authoritativeSteps (.-values authoritative-steps)
           :authoritativeObservations (.-values authoritative-observations)
           :authoritativeCandidate (identity-at bytes authoritative-observations-end)
           :authorization (identity-at bytes (+ authoritative-observations-end 32))
           :judgment (identity-at bytes (+ authoritative-observations-end 64))
           :admission (identity-at bytes (+ authoritative-observations-end 96))
           :successor (identity-at bytes (+ authoritative-observations-end 128))
           :causalRecords (.-values causal)
           :exactBytes bytes})))))

(defn branch-module-functions [module Any] Any
  (let [reset Any (.-clause_branch_v1_io_reset module)
        push Any (.-clause_branch_v1_request_push module)
        open Any (.-clause_branch_v1_open module)
        command Any (.-clause_branch_v1_command module)
        event-length Any (.-clause_branch_v1_event_len module)
        event-byte Any (.-clause_branch_v1_event_byte module)]
    (when (or (nil? reset) (nil? push) (nil? open) (nil? command)
              (nil? event-length) (nil? event-byte))
      (throw (new Error "Wasm module lacks the Clause branch ABI")))
    {:reset reset :push push :open open :command command
     :eventLength event-length :eventByte event-byte}))

(defn dispatch-branch-request
  [module Any
   request Any
   operation String] Any
  (if-not (wire/exact-byte-array?
           request
           (if (= operation "open") branch-open-max-bytes branch-command-max-bytes))
    (throw (new Error "branch request must carry bounded exact bytes"))
    (let [api Any (branch-module-functions module)]
      ((.-reset api))
      (doseq [byte Int request]
        (let [status Int (wire/process-status ((.-push api) byte))]
          (when (not= status 0)
            (throw (new Error (str "branch byte transfer rejected with status " status))))))
      (let [status Int (wire/process-status
                        (if (= operation "open") ((.-open api)) ((.-command api))))]
        (when (not= status 0)
          (throw (new Error (str "Clause branch " operation
                                 " rejected with status " status)))))
      (let [length Int (wire/process-status ((.-eventLength api)))]
        (when (or (< length 21) (> length branch-event-max-bytes))
          (throw (new Error "CBE1 event length is out of bounds")))
        (loop [index Int 0
               values (Vec Int) []]
          (if (= index length)
            (.freeze Object values)
            (let [byte Int (wire/process-status ((.-eventByte api) index))]
              (if (or (< byte 0) (> byte 255))
                (throw (new Error "CBE1 event byte is out of bounds"))
                (recur (inc index) (conj values byte))))))))))

(defn parse-projection
  [bytes Any
   offset Int] Any
  (let [tag-end Int (wire/require-range bytes offset 1 "branch projection")
        tag Int (wire/byte-at bytes offset)]
    (cond
      (= tag 0) {:value nil :next tag-end}
      (= tag 1)
      (let [observation-end Int (wire/require-range bytes tag-end identity-bytes
                                                   "branch projection observation")
            term Any (wire/parse-blob bytes observation-end branch-event-max-bytes
                                      "branch projected Term")]
        {:value {:observation (identity-at bytes tag-end)
                 :termBytes (.-bytes term)}
         :next (.-next term)})
      :else (throw (new Error "branch projection tag is invalid")))))

(defn decode-cbe1-event [bytes Any] Any
  (if-not (wire/exact-byte-array? bytes branch-event-max-bytes)
    (throw (new Error "CBE1 event must carry bounded exact bytes"))
    (do
      (when (or (< (.-length bytes) 21)
                (not= (wire/frozen-byte-range bytes 0 4) [67 66 69 49]))
        (throw (new Error "CBE1 event magic is invalid")))
      (let [slot Int (wire/little-u32 bytes 4)
            generation Int (wire/little-u32 bytes 8)
            sequence Int (wire/little-safe-u64 bytes 12)
            tag Int (wire/byte-at bytes 20)
            common Any {:slot slot :generation generation :sequence sequence}]
        (cond
          (= tag 1)
          (let [pins Any (parse-pins bytes 21)
                ancestry Any (parse-ancestry bytes (.-next pins))
                suspension Any (parse-suspension bytes (.-next ancestry))]
            (when (not= (.-next suspension) (.-length bytes))
              (throw (new Error "CBE1 Opened event has trailing bytes")))
            (.assign Object common
                     {:kind "opened" :pins (.-value pins) :ancestry (.-value ancestry)
                      :suspension (.-value suspension)}))

          (= tag 2)
          (do
            (when (not= (.-length bytes) (+ 21 (* 7 identity-bytes)))
              (throw (new Error "CBE1 authoritative Admission has an invalid shape")))
            (.assign Object common
                     {:kind "authoritative-admission"
                      :candidate (identity-at bytes 21)
                      :predecessor (identity-at bytes 53)
                      :successor (identity-at bytes 85)
                      :judgment (identity-at bytes 117)
                      :admission (identity-at bytes 149)
                      :run (identity-at bytes 181)
                      :activation (identity-at bytes 213)}))

          (= tag 3)
          (let [record Any (wire/parse-blob bytes 21 branch-event-max-bytes
                                            "CBE1 reconnect evidence")]
            (when (not= (.-next record) (.-length bytes))
              (throw (new Error "CBE1 reconnect evidence has trailing bytes")))
            (.assign Object common
                     {:kind "reconnect-proposed"
                      :evidence (decode-reconnect-evidence (.-bytes record))}))

          (= tag 4)
          (let [prefix-end Int (wire/require-range bytes 21 (* 6 identity-bytes)
                                                   "CBE1 reconnect Admission")
                projection Any (parse-projection bytes prefix-end)
                record Any (wire/parse-blob bytes (.-next projection)
                                            branch-event-max-bytes
                                            "CBE1 branch explanation")]
            (when (not= (.-next record) (.-length bytes))
              (throw (new Error "CBE1 reconnect Admission has trailing bytes")))
            (.assign Object common
                     {:kind "reconnect-admission"
                      :predecessor (identity-at bytes 21)
                      :successor (identity-at bytes 53)
                      :branchCandidate (identity-at bytes 85)
                      :authoritativeCandidate (identity-at bytes 117)
                      :judgment (identity-at bytes 149)
                      :admission (identity-at bytes 181)
                      :projection (.-value projection)
                      :explanation (decode-branch-explanation (.-bytes record))}))

          (= tag 5)
          (let [record Any (wire/parse-blob bytes 21 branch-event-max-bytes
                                            "CBE1 retained explanation")]
            (when (not= (.-next record) (.-length bytes))
              (throw (new Error "CBE1 explanation has trailing bytes")))
            (.assign Object common
                     {:kind "explanation"
                      :explanation (decode-branch-explanation (.-bytes record))}))

          (= tag 6)
          (do
            (when (not= (.-length bytes) 21)
              (throw (new Error "CBE1 Disposed event has trailing bytes")))
            (.assign Object common {:kind "disposed"}))

          (= tag 7)
          (let [reason Int (wire/byte-at bytes 21)
                expected Int (if (= reason 7) 23 22)]
            (when (not= (.-length bytes) expected)
              (throw (new Error "CBE1 rejection has an invalid shape")))
            (.assign Object common
                     {:kind "rejected" :reason reason
                      :pin (if (= reason 7) (wire/byte-at bytes 22) nil)}))

          :else (throw (new Error "CBE1 event tag is invalid")))))))

(defn encode-open [request wire/ExactProcessRequest
                   disconnect-tick Int disconnect-occurrence Any max-commands Int] Any
  (let [bytes Any [67 66 82 49]]
    (wire/append-blob! bytes (.-bytes request))
    (wire/append-u64! bytes disconnect-tick)
    (wire/append-blob! bytes disconnect-occurrence)
    (wire/append-u64! bytes max-commands)
    (.freeze Object bytes)))

(defn encode-command
  [branch WasmProcessBranch
   tag Int
   payload Any] Any
  (let [bytes Any [67 66 73 49]]
    (wire/append-u32! bytes (.-slot (.-handle branch)))
    (wire/append-u32! bytes (.-generation (.-handle branch)))
    (wire/append-u64! bytes @(.-sequence branch))
    (.push bytes tag)
    (when (not (nil? payload))
      (doseq [byte Int payload] (.push bytes byte)))
    (.freeze Object bytes)))

(defn require-live-branch [value Any] WasmProcessBranch
  (if (or (nil? value) (nil? (.-handle value)) (nil? (.-sequence value)))
    (throw (new Error "Wasm process branch is invalid"))
    (if @(.-disposed value)
      (throw (new Error "Wasm process branch is disposed"))
      value)))

(defn apply-command!
  [module Any
   branch WasmProcessBranch
   command Any] Any
  (let [event Any (decode-cbe1-event (dispatch-branch-request module command "command"))
        sequence Int @(.-sequence branch)]
    (when (or (not= (.-slot event) (.-slot (.-handle branch)))
              (not= (.-generation event) (.-generation (.-handle branch)))
              (not= (.-sequence event) (inc sequence)))
      (throw (new Error "CBE1 event does not advance exact branch custody")))
    (reset! (.-sequence branch) (.-sequence event))
    (when (= (.-kind event) "rejected")
      (throw (new Error (str "Clause branch operation rejected with reason "
                             (.-reason event)))))
    event))

(js/export
  (defn open-process-branch!
    [module Any
     request wire/ExactProcessRequest
     disconnect-tick Int
     disconnect-occurrence Any
     max-commands Int] WasmProcessBranch
    (when (or (< disconnect-tick 0) (<= max-commands 0))
      (throw (new Error "branch tick and command budget are invalid")))
    (let [event Any (decode-cbe1-event
                     (dispatch-branch-request
                      module
                      (encode-open request disconnect-tick disconnect-occurrence max-commands)
                      "open"))]
      (when (or (not= (.-kind event) "opened") (not= (.-sequence event) 0))
        (throw (new Error "Clause branch did not open exactly once")))
      (->WasmProcessBranch
       (.freeze Object {:slot (.-slot event) :generation (.-generation event)})
       (atom 0)
       (atom false)
       event))))

(defn occurrence-command!
  [branch WasmProcessBranch
   tag Int
   occurrences Any] Any
  (let [payload Any []]
    (append-occurrences! payload occurrences)
    (encode-command branch tag payload)))

(js/export
  (defn admit-authoritative-occurrences!
    [module Any
     incoming-branch Any
     occurrences Any] Any
    (let [branch WasmProcessBranch (require-live-branch incoming-branch)
          event Any (apply-command! module branch
                                    (occurrence-command! branch 1 occurrences))]
      (when (not= (.-kind event) "authoritative-admission")
        (throw (new Error "branch authority advance produced no Admission")))
      event)))

(js/export
  (defn propose-branch-reconnect!
    [module Any
     incoming-branch Any
     occurrences Any] Any
    (let [branch WasmProcessBranch (require-live-branch incoming-branch)
          event Any (apply-command! module branch
                                    (occurrence-command! branch 2 occurrences))]
      (when (not= (.-kind event) "reconnect-proposed")
        (throw (new Error "branch continuation produced no reconnect evidence")))
      event)))

(js/export
  (defn adjudicate-branch-reconnect!
    [module Any
     incoming-branch Any
     proposal Any
     authoritative-base Any
     occurrences Any] Any
    (let [branch WasmProcessBranch (require-live-branch incoming-branch)
          evidence Any (.-evidence proposal)
          payload Any []]
      (when (or (nil? evidence)
                (not (wire/exact-byte-array? (.-exactBytes evidence)
                                             branch-event-max-bytes)))
        (throw (new Error "reconnect proposal lacks exact retained evidence")))
      (wire/append-blob! payload (.-exactBytes evidence))
      (doseq [identity Any [(.-candidate evidence) authoritative-base]]
        (when (not (wire/exact-byte-array? identity identity-bytes))
          (throw (new Error "reconnect adjudication identity is invalid")))
        (doseq [byte Int identity] (.push payload byte)))
      (append-occurrences! payload occurrences)
      (let [event Any (apply-command! module branch (encode-command branch 3 payload))]
        (when (not= (.-kind event) "reconnect-admission")
          (throw (new Error "reconnect adjudication produced no Admission")))
        event))))

(js/export
  (defn explain-process-branch!
    [module Any
     incoming-branch Any] Any
    (let [branch WasmProcessBranch (require-live-branch incoming-branch)
          event Any (apply-command! module branch (encode-command branch 4 nil))]
      (when (not= (.-kind event) "explanation")
        (throw (new Error "retained branch produced no causal explanation")))
      event)))

(js/export
  (defn dispose-process-branch!
    [module Any
     incoming-branch Any] Bool
    (let [branch WasmProcessBranch (require-live-branch incoming-branch)
          event Any (apply-command! module branch (encode-command branch 5 nil))]
      (when (not= (.-kind event) "disposed")
        (throw (new Error "Clause branch did not dispose")))
      (reset! (.-disposed branch) true)
      true)))
