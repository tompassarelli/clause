{
  "name": "clause-browser-runtime",
  "private": true,
  "type": "module",
  "imports": {
    "#clause-runtime-wasm": "./generated/wasm/clause_runtime.js"
  },
  "exports": "./generated/runtime/wasm-cartridge-port.js",
  "scripts": {
    "typecheck": "bun run tsc --project tsconfig.json --noEmit",
    "build": "bun run tsc --project tsconfig.json",
    "test": "bun test ./generated/runtime/workbench-boundary-test.js ./generated/runtime/wasm-cartridge-port-test.js ./generated/runtime/branch-wasm-port-test.js ./generated/runtime/wasm-workbench-shell-test.js",
    "test:branch": "bun test ./generated/runtime/branch-wasm-port-test.js",
    "test:referent-input": "bun test ./src/referent-input-test.ts",
    "test:live-semantics": "bun test ./src/live-semantics-test.ts",
    "test:created-collections": "bun test ./src/created-collections-test.ts",
    "test:gameplay-hot-reload": "bun test ./generated/runtime/wasm-cartridge-port-test.js --test-name-pattern 'real Wasm (workbench )?hot-reloads Clause'",
    "check:gameplay-hot-reload": "bun run build && bun run test:gameplay-hot-reload"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
