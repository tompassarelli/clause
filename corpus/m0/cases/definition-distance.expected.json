{
  "schema": "clause-m0-contrast-v1",
  "id": "definition-distance",
  "axis": "recursive-definition-surface",
  "decision": {
    "status": "accepted-target",
    "canonical": "definition-denotation"
  },
  "source": {
    "lines": [
      "distance between ?a and ?b :=",
      "  length(position of ?a - position of ?b)"
    ],
    "line_break": "LF",
    "ends_with_line_break": true
  },
  "context": {
    "relations": [
      "$distance",
      "$position",
      "$referent:length",
      "$referent:subtraction"
    ]
  },
  "structural_intent": "pure-definition",
  "required": [
    "outer := means definition",
    "named holes correlate by identity across pattern and body",
    "- elaborates to minuend and subtrahend roles with difference as the solved role",
    "each projection is a recursive relation term"
  ],
  "forbidden": [
    "primitive-derivation-rule-object",
    "field-access",
    "flat-token-template",
    "fresh-hole-on-repeat"
  ],
  "elaborated": [
    {
      "kind": "definition",
      "term": {
        "kind": "pattern-application",
        "relation": "$distance",
        "roles": {
          "first": {
            "kind": "named-hole",
            "identity": "$hole:a"
          },
          "second": {
            "kind": "named-hole",
            "identity": "$hole:b"
          }
        }
      },
      "denotation": {
        "kind": "relation-application",
        "relation": "$referent:length",
        "roles": {
          "vector": {
            "kind": "relation-application",
            "surface_operator": "-",
            "relation": "$referent:subtraction",
            "roles": {
              "minuend": {
                "kind": "relation-projection",
                "relation": "$position",
                "roles": {
                  "member": {
                    "kind": "named-hole",
                    "identity": "$hole:a"
                  }
                },
                "output_role": "value"
              },
              "subtrahend": {
                "kind": "relation-projection",
                "relation": "$position",
                "roles": {
                  "member": {
                    "kind": "named-hole",
                    "identity": "$hole:b"
                  }
                },
                "output_role": "value"
              }
            },
            "output_role": "difference"
          }
        },
        "output_role": "length"
      }
    }
  ]
}
