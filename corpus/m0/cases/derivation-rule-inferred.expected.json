{
  "schema": "clause-m0-contrast-v1",
  "id": "derivation-rule-inferred",
  "axis": "derivation-rule-inference-surface",
  "decision": {"status": "unresolved", "candidate": "conclusion-if-premises", "layout_style": "canonical-two-space"},
  "source": {
    "lines": [
      "?origin has a usable egress path to ?destination if",
      "  ?door connects ?origin to ?destination",
      "  ?door passed Fire-Marshal Inspection"
    ],
    "line_break": "LF",
    "ends_with_line_break": true
  },
  "structural_intent": "inferred-positive-derivation-rule",
  "required": [
    "conclusion plus if body proves the derivation-rule mode",
    "repeated named holes correlate across conclusion and premises",
    "the derivation rule retains a stable semantic identity without a human label"
  ],
  "forbidden": ["universal-law-keyword", "fresh-hole-on-repeat", "label-derived-semantic-identity"],
  "derivation_rule": {
    "kind": "positive-derivation-rule",
    "identity": "$rule:egress-direct",
    "conclusion": {
      "kind": "relation-pattern",
      "relation": "$route",
      "roles": {
        "origin": {"kind": "named-hole", "identity": "$hole:origin"},
        "destination": {"kind": "named-hole", "identity": "$hole:destination"}
      }
    },
    "premises": [
      {
        "kind": "relation-pattern",
        "relation": "$connects",
        "roles": {
          "door": {"kind": "named-hole", "identity": "$hole:door"},
          "origin": {"kind": "named-hole", "identity": "$hole:origin"},
          "destination": {"kind": "named-hole", "identity": "$hole:destination"}
        }
      },
      {
        "kind": "relation-pattern",
        "relation": "$passed",
        "roles": {
          "door": {"kind": "named-hole", "identity": "$hole:door"},
          "inspection": {"kind": "symbol", "name": "Fire-Marshal Inspection"}
        }
      }
    ]
  },
  "elaborated": [
    {"kind": "derivation-rule-admission", "derivation_rule": "$rule:egress-direct"}
  ]
