Observer
Target
Space

observer-position-v1:
  ?observer shape Observer
  ?space shape Space
  ?point shape point2-v1
  ?observer:
    has observer-position ?point in: ?space

mode observer-position-v1 given observer space yields point: one

target-position-v1:
  ?target shape Target
  ?space shape Space
  ?point shape point2-v1
  ?target:
    has target-position ?point in: ?space

mode target-position-v1 given target space yields point: one

proximity-radius-v1:
  ?observer shape Observer
  ?space shape Space
  ?radius shape nonnegative-q16-16-v1
  ?observer:
    has proximity-radius ?radius in: ?space

mode proximity-radius-v1 given observer space yields radius: one

law radius-proximity-law-v1
  if
    ?observer has observer-position ?observer-point in ?space
    ?observer has proximity-radius ?radius in ?space
    ?target has target-position ?target-point in ?space
    within-radius-v1 ?target-point ?observer-point ?radius
  then
    ?observer has in-proximity ?target in ?space

derive radius-proximity-law-v1
