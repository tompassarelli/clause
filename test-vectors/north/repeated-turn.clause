North
NorthPhase
TurnReadiness
AgentRunIdentity
idle
dispatching
delegating
settling
completed
failed
turn-ready
turn-active
no-agent-run

phase:
  ?example:
    north: North
    phase: NorthPhase
    ?north:
      phase: ?phase

mode phase given north yields phase: one

active-delegated-child:
  ?example:
    north: North
    active-delegated-child: AgentRunIdentity
    ?north:
      active delegated child: ?active-delegated-child

mode active-delegated-child given north yields active-delegated-child: one

terminal-delegated-child:
  ?example:
    north: North
    terminal-delegated-child: AgentRunIdentity
    ?north:
      terminal delegated child: ?terminal-delegated-child

mode terminal-delegated-child given north yields terminal-delegated-child: one

turn-readiness:
  ?example:
    north: North
    turn-readiness: TurnReadiness
    ?north:
      turn readiness: ?turn-readiness

mode turn-readiness given north yields turn-readiness: one

north-main
  member of: North
north-main phase idle
north-main turn readiness turn-ready
north-main active delegated child no-agent-run
north-main terminal delegated child no-agent-run

on inspect ?north
  when
    ?north phase ?phase
  withdraw
    ?north phase ?phase
  include
    ?north phase ?phase

on submit ?north
  when
    ?north phase ?phase
    ?north turn readiness ?readiness
    ?readiness = turn-ready
    ?north terminal delegated child ?previous-terminal-child
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
    ?north terminal delegated child ?previous-terminal-child
  include
    ?north phase dispatching
    ?north turn readiness turn-active
    ?north terminal delegated child no-agent-run

on delegate ?north
  when
    ?north phase ?phase
    ?north turn readiness ?readiness
    ?readiness = turn-ready
    ?north terminal delegated child ?previous-terminal-child
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
    ?north terminal delegated child ?previous-terminal-child
  include
    ?north phase delegating
    ?north turn readiness turn-active
    ?north terminal delegated child no-agent-run

on child-spawned ?north ?child
  when
    ?north phase ?phase
    ?phase = delegating
    ?north active delegated child ?previous-child
    ?previous-child = no-agent-run
  withdraw
    ?north phase ?phase
    ?north active delegated child ?previous-child
  include
    ?north phase settling
    ?north active delegated child ?child

on settle-success ?north
  when
    ?north phase ?phase
    ?phase = dispatching
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
  include
    ?north phase completed
    ?north turn readiness turn-ready

on settle-failure ?north
  when
    ?north phase ?phase
    ?phase = dispatching
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
  include
    ?north phase failed
    ?north turn readiness turn-ready

on settle-delegation-success ?north ?child
  when
    ?north phase ?phase
    ?phase = settling
    ?north active delegated child ?active-child
    ?active-child = ?child
    ?north terminal delegated child ?previous-terminal-child
    ?previous-terminal-child = no-agent-run
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north active delegated child ?active-child
    ?north terminal delegated child ?previous-terminal-child
    ?north turn readiness ?readiness
  include
    ?north phase completed
    ?north active delegated child no-agent-run
    ?north terminal delegated child ?child
    ?north turn readiness turn-ready

on fail-delegation-before-child ?north
  when
    ?north phase ?phase
    ?phase = delegating
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north turn readiness ?readiness
  include
    ?north phase failed
    ?north turn readiness turn-ready

on fail-delegation-after-child ?north ?child
  when
    ?north phase ?phase
    ?phase = settling
    ?north active delegated child ?active-child
    ?active-child = ?child
    ?north terminal delegated child ?previous-terminal-child
    ?previous-terminal-child = no-agent-run
    ?north turn readiness ?readiness
    ?readiness = turn-active
  withdraw
    ?north phase ?phase
    ?north active delegated child ?active-child
    ?north terminal delegated child ?previous-terminal-child
    ?north turn readiness ?readiness
  include
    ?north phase failed
    ?north active delegated child no-agent-run
    ?north terminal delegated child ?child
    ?north turn readiness turn-ready
