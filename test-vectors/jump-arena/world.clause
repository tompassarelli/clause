F64
Bool
Player
Arena

Vec3:
  ?example:
    x: F64
    y: F64
    z: F64

clamped-between:
  ?example:
    value: F64
    lower: F64
    upper: F64
    result: F64
    ?value clamped between ?lower and ?upper as ?result

mode clamped-between given value lower upper yields result: maybe

position:
  ?example:
    player: Player
    position: Vec3
    ?player:
      position: ?position

mode position given player yields position: one

velocity:
  ?example:
    player: Player
    velocity: Vec3
    ?player:
      velocity: ?velocity

mode velocity given player yields velocity: one

grounded:
  ?example:
    player: Player
    grounded: Bool
    ?player:
      grounded: ?grounded

mode grounded given player yields grounded: one

horizontal-intent:
  ?example:
    player: Player
    horizontal-intent: Vec3
    ?player:
      horizontal intent: ?horizontal-intent

mode horizontal-intent given player yields horizontal-intent: one

gravity:
  ?example:
    arena: Arena
    gravity: F64
    ?arena:
      gravity: ?gravity

mode gravity given arena yields gravity: one

jump-speed:
  ?example:
    arena: Arena
    jump-speed: F64
    ?arena:
      jump speed: ?jump-speed

mode jump-speed given arena yields jump-speed: one

move-speed:
  ?example:
    arena: Arena
    move-speed: F64
    ?arena:
      move speed: ?move-speed

mode move-speed given arena yields move-speed: one

floor-height:
  ?example:
    arena: Arena
    floor-height: F64
    ?arena:
      floor height: ?floor-height

mode floor-height given arena yields floor-height: one

min-x:
  ?example:
    arena: Arena
    min-x: F64
    ?arena:
      minimum x: ?min-x

mode min-x given arena yields min-x: one

max-x:
  ?example:
    arena: Arena
    max-x: F64
    ?arena:
      maximum x: ?max-x

mode max-x given arena yields max-x: one

min-z:
  ?example:
    arena: Arena
    min-z: F64
    ?arena:
      minimum z: ?min-z

mode min-z given arena yields min-z: one

max-z:
  ?example:
    arena: Arena
    max-z: F64
    ?arena:
      maximum z: ?max-z

mode max-z given arena yields max-z: one

law clamp-lower
  if
    ?lower <= ?upper
    ?value < ?lower
  then
    ?value clamped between ?lower and ?upper as ?lower

law clamp-interior
  if
    ?lower <= ?value
    ?value <= ?upper
  then
    ?value clamped between ?lower and ?upper as ?value

law clamp-upper
  if
    ?lower <= ?upper
    ?value > ?upper
  then
    ?value clamped between ?lower and ?upper as ?upper

derive clamp-lower
derive clamp-interior
derive clamp-upper

jump-arena
  member of: Arena
player-1
  member of: Player

jump-arena gravity -8.0
jump-arena jump speed 8.0
jump-arena move speed 5.0
jump-arena floor height 0.0
jump-arena minimum x -10.0
jump-arena maximum x 10.0
jump-arena minimum z -10.0
jump-arena maximum z 10.0

player-1 position Vec3 { x: 0.0, y: 0.0, z: 0.0 }
player-1 velocity Vec3 { x: 0.0, y: 0.0, z: 0.0 }
player-1 grounded true
player-1 horizontal intent Vec3 { x: 0.0, y: 0.0, z: 0.0 }

on input ?player Vec3 { x: ?intent-x, y: 0.0, z: ?intent-z }
  when
    ?player horizontal intent ?old-intent
  withdraw
    ?player horizontal intent ?old-intent
  include
    ?player horizontal intent Vec3 { x: ?intent-x, y: 0.0, z: ?intent-z }

on jump ?player
  when
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded true
    jump-arena jump speed ?jump-speed
  withdraw
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded true
  include
    ?player velocity Vec3 { x: ?velocity-x, y: ?jump-speed, z: ?velocity-z }
    ?player grounded false

on tick ?player ?dt
  when
    ?dt > 0.0
    ?player position Vec3 { x: ?position-x, y: ?floor, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: 0.0, z: ?velocity-z }
    ?player horizontal intent Vec3 { x: ?intent-x, y: 0.0, z: ?intent-z }
    ?player grounded true
    jump-arena move speed ?move-speed
    jump-arena floor height ?floor
    jump-arena minimum x ?min-x
    jump-arena maximum x ?max-x
    jump-arena minimum z ?min-z
    jump-arena maximum z ?max-z
    (?position-x + ?intent-x * ?move-speed * ?dt) clamped between ?min-x and ?max-x as ?next-x
    (?position-z + ?intent-z * ?move-speed * ?dt) clamped between ?min-z and ?max-z as ?next-z
  withdraw
    ?player position Vec3 { x: ?position-x, y: ?floor, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: 0.0, z: ?velocity-z }
  include
    ?player position Vec3 { x: ?next-x, y: ?floor, z: ?next-z }
    ?player velocity Vec3 { x: (?next-x - ?position-x) / ?dt, y: 0.0, z: (?next-z - ?position-z) / ?dt }

on tick ?player ?dt
  when
    ?dt > 0.0
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player horizontal intent Vec3 { x: ?intent-x, y: 0.0, z: ?intent-z }
    ?player grounded false
    jump-arena gravity ?gravity
    jump-arena move speed ?move-speed
    jump-arena floor height ?floor
    jump-arena minimum x ?min-x
    jump-arena maximum x ?max-x
    jump-arena minimum z ?min-z
    jump-arena maximum z ?max-z
    (?position-x + (?velocity-x + ?intent-x * ?move-speed * ?dt) * ?dt) clamped between ?min-x and ?max-x as ?next-x
    (?position-z + (?velocity-z + ?intent-z * ?move-speed * ?dt) * ?dt) clamped between ?min-z and ?max-z as ?next-z
    ?position-y + (?velocity-y + ?gravity * ?dt) * ?dt > ?floor
  withdraw
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
  include
    ?player position Vec3 { x: ?next-x, y: ?position-y + (?velocity-y + ?gravity * ?dt) * ?dt, z: ?next-z }
    ?player velocity Vec3 { x: (?next-x - ?position-x) / ?dt, y: ?velocity-y + ?gravity * ?dt, z: (?next-z - ?position-z) / ?dt }

on tick ?player ?dt
  when
    ?dt > 0.0
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player horizontal intent Vec3 { x: ?intent-x, y: 0.0, z: ?intent-z }
    ?player grounded false
    jump-arena gravity ?gravity
    jump-arena move speed ?move-speed
    jump-arena floor height ?floor
    jump-arena minimum x ?min-x
    jump-arena maximum x ?max-x
    jump-arena minimum z ?min-z
    jump-arena maximum z ?max-z
    (?position-x + (?velocity-x + ?intent-x * ?move-speed * ?dt) * ?dt) clamped between ?min-x and ?max-x as ?next-x
    (?position-z + (?velocity-z + ?intent-z * ?move-speed * ?dt) * ?dt) clamped between ?min-z and ?max-z as ?next-z
    ?position-y + (?velocity-y + ?gravity * ?dt) * ?dt <= ?floor
  withdraw
    ?player position Vec3 { x: ?position-x, y: ?position-y, z: ?position-z }
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    ?player grounded false
  include
    ?player position Vec3 { x: ?next-x, y: ?floor, z: ?next-z }
    ?player velocity Vec3 { x: (?next-x - ?position-x) / ?dt, y: 0.0, z: (?next-z - ?position-z) / ?dt }
    ?player grounded true
