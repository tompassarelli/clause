  "process_rules": {
    "input": {
      "source_head": "on input",
      "guard": "intent.y = 0",
      "candidate": "replace exactly one horizontal-intent occurrence",
      "outer_admission_required": true
    },
    "jump": {
      "source_head": "on jump",
      "guard": "grounded = true",
      "candidate": "replace velocity.y with jump-speed and grounded with false",
      "no_matching_guard": "NO_APPLICABLE_PROCESS_RULE",
      "outer_admission_required": true
    },
    "tick": {
      "source_head": "on tick",
      "guard_partition": ["grounded", "airborne-above-floor", "airborne-landing"],
      "horizontal_candidate": "clamp(position + intent * move-speed * dt, arena bounds)",
      "horizontal_velocity": "(clamped-position - prior-position) / dt",
      "vertical_candidate": "position.y + (velocity.y + gravity * dt) * dt",
      "vertical_velocity": "velocity.y + gravity * dt",
      "landing": "when vertical candidate <= floor, position.y = floor, velocity.y = 0, grounded = true",
      "outer_admission_required": true
    },
    "position_observation": {
