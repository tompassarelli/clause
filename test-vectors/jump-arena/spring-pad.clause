SpringPad

spring-pad-1: SpringPad

on spring-contact ?player
  when
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?velocity-y = 0.0
    ?player-x = 0.16
    ?player-z = 0.0
  withdraw
    ?player velocity Vec3 { x: ?velocity-x, y: ?velocity-y, z: ?velocity-z }
  include
    ?player velocity Vec3 { x: ?velocity-x, y: 12.0, z: ?velocity-z }

on spring-airborne ?player
  when
    ?player grounded ?was-grounded
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?was-grounded = true
    ?player-x = 0.16
    ?player-z = 0.0
  withdraw
    ?player grounded ?was-grounded
  include
    ?player grounded false
