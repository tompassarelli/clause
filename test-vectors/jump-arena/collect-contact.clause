State
Collectible
active
collected
spent

state:
  ?collectible shape Collectible
  ?state shape State
  ?collectible:
    state: ?state

mode state given collectible yields state: one

coin-1 state active

on collect ?collectible
  when
    ?collectible state ?state
    player-1 position Vec3 { x: ?player-x, y: ?player-y, z: ?player-z }
    ?state = active
    ?player-x = 0.08
    ?player-z = 0.0
  withdraw
    ?collectible state ?state
  include
    ?collectible state collected
