State
Collectible
active
collected
spent

state:
  ?example:
    collectible: Collectible
    state: State
    ?collectible:
      state: ?state

mode state given collectible yields state: one

coin-1 state active

on collect ?collectible
  when
    ?collectible state ?state
  withdraw
    ?collectible state ?state
  include
    ?collectible state collected
