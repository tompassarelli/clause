mode enemy-period given enemy yields enemy-period: one
enemy-burn-duration:
  ?enemy shape Enemy
  ?enemy-burn-duration shape F64
  ?enemy:
    enemy burn duration: ?enemy-burn-duration

mode enemy-burn-duration given enemy yields enemy-burn-duration: one
encounter-state:
  ?encounter shape Encounter
  ?encounter-state shape EncounterState
  ?encounter:
    encounter state: ?encounter-state

mode encounter-state given encounter yields encounter-state: one
state-name:
  ?state shape EncounterState
  ?state-name shape Text
  ?state:
    state name: ?state-name

mode state-name given state yields state-name: one
burn-damage:
  ?rules shape CombatRules
  ?burn-damage shape F64
  ?rules:
    burn damage: ?burn-damage

mode burn-damage given rules yields burn-damage: one

law clamp-lower
  if
    ?lower <= ?upper
    ?value < ?lower
  then
    ?value clamped between ?lower and ?upper as ?lower
law clamp-interior
  if
    ?lower <= ?value
    ?value <= ?upper
  then
    ?value clamped between ?lower and ?upper as ?value
law clamp-upper
  if
    ?lower <= ?upper
    ?value > ?upper
  then
    ?value clamped between ?lower and ?upper as ?upper
law full-damage
  if
    ?remaining <= 0.0
  then
    ?incoming damage after ward ?remaining as ?incoming
law warded-damage
  if
    ?remaining > 0.0
  then
    ?incoming damage after ward ?remaining as ?incoming * 0.5
derive clamp-lower
derive clamp-interior
derive clamp-upper
derive full-damage
derive warded-damage

