mode action-cooldown given unit yields action-cooldown: one
action-period:
  ?unit shape Unit
  ?action-period shape F64
  ?unit:
    action period: ?action-period

mode action-period given unit yields action-period: one
enemy-target:
  ?enemy shape Enemy
  ?enemy-target shape Actor
  ?enemy:
    enemy target: ?enemy-target

mode enemy-target given enemy yields enemy-target: one
enemy-damage:
  ?enemy shape Enemy
  ?enemy-damage shape F64
  ?enemy:
    enemy damage: ?enemy-damage

mode enemy-damage given enemy yields enemy-damage: one
