bind scalar-input PointerWorldX to observe-order-x
bind scalar-input PointerWorldZ to observe-order-z
bind keyboard ClearSelection down to clear-selection
bind keyboard SelectAll down to select-all
bind referent-input Pick as Unit to select-unit
bind referent-input Target as Actor to choose-target
bind keyboard IssueMove down to issue-move
bind keyboard BeginEncounter down to begin-encounter
bind keyboard Attack down to party-attack
bind keyboard Heal down to party-heal
bind keyboard Ward down to raise-ward

on observe-order-x ?controller ?x
  when
    ?controller order target Vec3 { x: ?prior-x, y: ?y, z: ?z }
  withdraw
    ?controller order target Vec3 { x: ?prior-x, y: ?y, z: ?z }
  include
    ?controller order target Vec3 { x: ?x, y: ?y, z: ?z }
on observe-order-z ?controller ?z
  when
    ?controller order target Vec3 { x: ?x, y: ?y, z: ?prior-z }
  withdraw
    ?controller order target Vec3 { x: ?x, y: ?y, z: ?prior-z }
  include
    ?controller order target Vec3 { x: ?x, y: ?y, z: ?z }
on clear-selection ?unit
  when
    ?unit selected ?was-selected
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected false
on select-all ?unit
  when
    ?unit selected ?was-selected
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected true
on select-unit ?unit ?target
  when
    ?unit selected ?was-selected
    ?unit = ?target
  withdraw
    ?unit selected ?was-selected
  include
    ?unit selected true
on choose-target ?controller ?picked
  when
    ?controller chosen target ?prior
    ?picked vitality ?health
  withdraw
    ?controller chosen target ?prior
  include
    ?controller chosen target ?picked
on begin-encounter ?encounter
  when
    ?encounter encounter state ?state
    ?state = ready
  withdraw
    ?encounter encounter state ?state
  include
    ?encounter encounter state active
on issue-move ?unit
  when
    player-1 order target Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?unit selected true
    ?unit vitality ?health
    ?unit alive true
    ?health > 0.0
    ?unit formation offset Vec3 { x: ?offset-x, y: ?offset-y, z: ?offset-z }
    ?unit unit destination ?prior-destination
    ?unit moving ?was-moving
  withdraw
    ?unit unit destination ?prior-destination
    ?unit moving ?was-moving
  include
    ?unit unit destination Vec3 { x: ?target-x + ?offset-x, y: 0.0, z: ?target-z + ?offset-z }
    ?unit moving true

on party-attack ?unit
  when
    encounter encounter state active
    ?unit selected true
    ?unit vitality ?unit-health
    ?unit alive true
    ?unit actor position Vec3 { x: ?unit-x, y: ?unit-y, z: ?unit-z }
    ?unit attack damage ?damage
    ?unit attack range ?range
    ?unit action cooldown ?cooldown
    ?unit action period ?period
    player-1 chosen target ?target
    ?target actor position Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?target vitality ?health
    ?target hostile true
    ?health > 0.0
    ?unit-health > 0.0
    ?cooldown <= 0.0
    (?target-x - ?unit-x) * (?target-x - ?unit-x) + (?target-z - ?unit-z) * (?target-z - ?unit-z) <= ?range * ?range
  withdraw
    ?unit action cooldown ?cooldown
  include
    ?unit action cooldown ?period
  accumulate
    ?target vitality 0.0 - ?damage
on party-heal ?unit
  when
    encounter encounter state active
    ?unit selected true
    ?unit vitality ?unit-health
    ?unit alive true
    ?unit actor position Vec3 { x: ?unit-x, y: ?unit-y, z: ?unit-z }
    ?unit healing power ?healing
    ?unit attack range ?range
    ?unit action cooldown ?cooldown
    ?unit action period ?period
    player-1 chosen target ?target
    ?target actor position Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?target vitality ?health
    ?target maximum vitality ?maximum
    ?target hostile false
    ?target alive true
    ?healing > 0.0
    ?unit-health > 0.0
    ?health < ?maximum
    ?cooldown <= 0.0
    (?target-x - ?unit-x) * (?target-x - ?unit-x) + (?target-z - ?unit-z) * (?target-z - ?unit-z) <= ?range * ?range
    ?health + ?healing clamped between 0.0 and ?maximum as ?next-health
  withdraw
    ?unit action cooldown ?cooldown
  include
    ?unit action cooldown ?period
  accumulate
    ?target vitality ?next-health - ?health
on raise-ward ?unit
  when
    encounter encounter state active
    ?unit selected true
    ?unit vitality ?unit-health
    ?unit alive true
    ?unit actor position Vec3 { x: ?unit-x, y: ?unit-y, z: ?unit-z }
    ?unit ward duration ?duration
    ?unit attack range ?range
    ?unit action cooldown ?cooldown
    ?unit action period ?period
    player-1 chosen target ?target
    ?target actor position Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?target ward remaining ?prior
    ?target hostile false
    ?target alive true
    ?duration > 0.0
    ?unit-health > 0.0
    ?cooldown <= 0.0
    (?target-x - ?unit-x) * (?target-x - ?unit-x) + (?target-z - ?unit-z) * (?target-z - ?unit-z) <= ?range * ?range
  withdraw
    ?unit action cooldown ?cooldown
    ?target ward remaining ?prior
  include
    ?unit action cooldown ?period
    ?target ward remaining ?duration

on tick ?unit ?dt
  when
    ?dt > 0.0
    ?unit actor position Vec3 { x: ?x, y: ?y, z: ?z }
    ?unit unit destination Vec3 { x: ?destination-x, y: ?destination-y, z: ?destination-z }
    ?unit movement speed ?speed
    ?unit alive true
    ?unit moving ?is-moving
    ?is-moving = true
    (?destination-x - ?x) * (?destination-x - ?x) + (?destination-z - ?z) * (?destination-z - ?z) > 0.0001
    (?destination-x - ?x) clamped between 0.0 - (?speed * ?dt) and ?speed * ?dt as ?step-x
    (?destination-z - ?z) clamped between 0.0 - (?speed * ?dt) and ?speed * ?dt as ?step-z
  withdraw
    ?unit actor position Vec3 { x: ?x, y: ?y, z: ?z }
  include
    ?unit actor position Vec3 { x: ?x + ?step-x, y: 0.0, z: ?z + ?step-z }
on tick ?unit ?dt
  when
    ?unit actor position Vec3 { x: ?x, y: ?y, z: ?z }
    ?unit unit destination Vec3 { x: ?destination-x, y: ?destination-y, z: ?destination-z }
    ?unit moving ?is-moving
    ?is-moving = true
    (?destination-x - ?x) * (?destination-x - ?x) + (?destination-z - ?z) * (?destination-z - ?z) <= 0.0001
  withdraw
    ?unit moving ?is-moving
  include
    ?unit moving false
on tick ?unit ?dt
  when
    ?unit action cooldown ?cooldown
    ?cooldown > 0.0
  withdraw
    ?unit action cooldown ?cooldown
  include
    ?unit action cooldown ?cooldown - ?dt
on tick ?enemy ?dt
  when
    ?enemy enemy cooldown ?cooldown
    ?cooldown > 0.0
  withdraw
    ?enemy enemy cooldown ?cooldown
  include
    ?enemy enemy cooldown ?cooldown - ?dt
on tick ?actor ?dt
  when
    ?actor ward remaining ?remaining
    ?remaining > 0.0
  withdraw
    ?actor ward remaining ?remaining
  include
    ?actor ward remaining ?remaining - ?dt
on tick ?actor ?dt
  when
    ?actor ward remaining ?remaining
    ?remaining < 0.0
  withdraw
    ?actor ward remaining ?remaining
  include
    ?actor ward remaining 0.0
on tick ?actor ?dt
  when
    encounter encounter state active
    ?actor burn remaining ?remaining
    ?actor ward remaining ?ward
    ?actor vitality ?health
    combat-rules burn damage ?burn
    ?burn * ?dt damage after ward ?ward as ?damage
    ?remaining > 0.0
    ?health > 0.0
  withdraw
    ?actor burn remaining ?remaining
  include
    ?actor burn remaining ?remaining - ?dt
  accumulate
    ?actor vitality 0.0 - ?damage
on tick ?actor ?dt
  when
    ?actor burn remaining ?remaining
    ?remaining < 0.0
  withdraw
    ?actor burn remaining ?remaining
  include
    ?actor burn remaining 0.0
on tick ?enemy ?dt
  when
    encounter encounter state active
    ?enemy actor position Vec3 { x: ?enemy-x, y: ?enemy-y, z: ?enemy-z }
    ?enemy enemy target ?target
    ?enemy enemy damage ?incoming
    ?enemy enemy range ?range
    ?enemy enemy cooldown ?cooldown
    ?enemy enemy period ?period
    ?enemy enemy burn duration ?burn-duration
    ?enemy vitality ?enemy-health
    ?enemy alive true
    ?target actor position Vec3 { x: ?target-x, y: ?target-y, z: ?target-z }
    ?target vitality ?target-health
    ?target alive true
    ?target ward remaining ?ward
    ?target burn remaining ?prior-burn
    ?incoming damage after ward ?ward as ?damage
    ?cooldown <= 0.0
    ?enemy-health > 0.0
    ?target-health > 0.0
    (?target-x - ?enemy-x) * (?target-x - ?enemy-x) + (?target-z - ?enemy-z) * (?target-z - ?enemy-z) <= ?range * ?range
  withdraw
    ?enemy enemy cooldown ?cooldown
    ?target burn remaining ?prior-burn
  include
    ?enemy enemy cooldown ?period
    ?target burn remaining ?burn-duration
  accumulate
    ?target vitality 0.0 - ?damage
on tick ?actor ?dt
  when
    ?actor vitality ?health
    ?actor alive ?was-alive
    ?health <= 0.0
    ?was-alive = true
  withdraw
    ?actor alive ?was-alive
  include
    ?actor alive false
on tick ?encounter ?dt
  when
    ?encounter encounter state ?state
    cinder-1 vitality ?first-health
    cinder-2 vitality ?second-health
    moonwell vitality ?moonwell-health
    ?first-health <= 0.0
    ?second-health <= 0.0
    ?moonwell-health > 0.0
    ?state = active
  withdraw
    ?encounter encounter state ?state
  include
    ?encounter encounter state victory
on tick ?encounter ?dt
  when
    ?encounter encounter state ?state
    moonwell vitality ?moonwell-health
    ?moonwell-health <= 0.0
    ?state = active
  withdraw
    ?encounter encounter state ?state
  include
