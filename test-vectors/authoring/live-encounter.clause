  ?presentation-kind shape Text
  ?actor:
    presentation kind: ?presentation-kind

mode presentation-kind given actor yields presentation-kind: one
actor-position:
  ?actor shape Actor
  ?actor-position shape Vec3
  ?actor:
    actor position: ?actor-position

mode actor-position given actor yields actor-position: one
unit-destination:
  ?unit shape Unit
  ?unit-destination shape Vec3
  ?unit:
    unit destination: ?unit-destination

mode unit-destination given unit yields unit-destination: one
formation-offset:
  ?unit shape Unit
  ?formation-offset shape Vec3
  ?unit:
    formation offset: ?formation-offset

mode formation-offset given unit yields formation-offset: one
