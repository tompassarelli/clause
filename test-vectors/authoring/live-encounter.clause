Vec3:
  x: F64
  y: F64
  z: F64

clamped-between:
  (shape: F64):
    ?value ?lower ?upper ?result
  ?value clamped between ?lower and ?upper as ?result

mode clamped-between given value lower upper yields result: maybe
damage-after-ward:
  (shape: F64):
    ?incoming ?remaining ?result
  ?incoming damage after ward ?remaining as ?result

mode damage-after-ward given incoming remaining yields result: maybe
order-target:
  ?controller shape Controller
  ?order-target shape Vec3
  ?controller:
    order target: ?order-target

mode order-target given controller yields order-target: one
chosen-target:
  ?controller shape Controller
  ?chosen-target shape Actor
  ?controller:
    chosen target: ?chosen-target

mode chosen-target given controller yields chosen-target: one
unit-class:
  ?unit shape Unit
  ?unit-class shape UnitClass
  ?unit:
    unit class: ?unit-class

mode unit-class given unit yields unit-class: one
class-name:
  ?class shape UnitClass
  ?class-name shape Text
  ?class:
    class name: ?class-name

mode class-name given class yields class-name: one
class-role:
  ?class shape UnitClass
  ?class-role shape Text
  ?class:
    class role: ?class-role

mode class-role given class yields class-role: one
