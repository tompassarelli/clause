  ?unit shape Unit
  ?movement-speed shape F64
  ?unit:
    movement speed: ?movement-speed

mode movement-speed given unit yields movement-speed: one
selected:
  ?unit shape Unit
  ?selected shape Bool
  ?unit:
    selected: ?selected

mode selected given unit yields selected: one
moving:
  ?unit shape Unit
  ?moving shape Bool
  ?unit:
    moving: ?moving

mode moving given unit yields moving: one
