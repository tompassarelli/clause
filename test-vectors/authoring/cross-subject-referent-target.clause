Bool
Controller
Target

chosen-target:
  ?controller shape Controller
  ?chosen-target shape Target
  ?controller:
    chosen target: ?chosen-target

mode chosen-target given controller yields chosen-target: one
hostile:
  ?target shape Target
  ?hostile shape Bool
  ?target:
    hostile: ?hostile

mode hostile given target yields hostile: one

player
  member of: Controller
first
  member of: Target
second
  member of: Target
player chosen target first
first hostile false
second hostile true

bind referent-input Target as Target to choose-target

on choose-target ?controller ?picked
  when
    ?controller chosen target ?prior
    ?picked hostile ?is-hostile
  withdraw
    ?controller chosen target ?prior
  include
    ?controller chosen target ?picked
