F64
Bool
Meter

reading:
  ?example:
    meter: Meter
    reading: F64
    ?meter:
      reading: ?reading

mode reading given meter yields reading: one
positive:
  ?example:
    meter: Meter
    positive: Bool
    ?meter:
      positive: ?positive

mode positive given meter yields positive: one

meter
  member of: Meter
meter reading 25.0
meter positive false

on measure ?meter
  when
    ?meter reading ?value
    ?meter positive ?prior
  withdraw
    ?meter reading ?value
    ?meter positive ?prior
  include
    ?meter reading 0.0
    ?meter positive (?value > 0.0)
