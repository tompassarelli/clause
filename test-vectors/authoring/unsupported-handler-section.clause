Root
Item

active:
  ?example:
    root: Root
    active: Item
    ?root:
      active: ?active

mode active given root yields active: one

root active none

on inspect ?root
  when
    ?root active ?active
  withdraw
    ?root active ?active
  include
    ?root active ?active

on unsupported-emission-section ?root
  when
    ?root active ?active
  emit
    ?root active ?active
