Root
Item

relation active
  reads {root: Root} active {value: Item}
  subject root
  mode given root yields value: one

root active none

on inspect ?root
  when
    ?root active ?active
  withdraw
    ?root active ?active
  include
    ?root active ?active

on unsupported-emission-section ?root
  when
    ?root active ?active
  emit
    ?root active ?active
