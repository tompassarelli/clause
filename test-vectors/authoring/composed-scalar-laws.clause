F64
Meter

magnitude:
  ?example:
    input: F64
    output: F64
    | ?input | = ?output

mode magnitude given input yields output: maybe

law negative-magnitude
  if
    ?x < 0.0
  then
    | ?x | = (0.0 - ?x)

law nonnegative-magnitude
  if
    ?x >= 0.0
  then
    | ?x | = ?x

derive negative-magnitude
derive nonnegative-magnitude

reading:
  ?example:
    meter: Meter
    reading: F64
    ?meter:
      reading: ?reading

mode reading given meter yields reading: one

meter-1
  member of: Meter
meter-1 reading -4.0

on rectify ?meter
  when
    ?meter reading ?x
    | ?x | = ?magnitude
    | (?magnitude - 10.0) | = ?next
  withdraw
    ?meter reading ?x
  include
    ?meter reading ?next
