F64
Loot
LootState
hidden
acquired

carried-distance:
  ?loot shape Loot
  ?carried-distance shape F64
  ?loot:
    carried distance: ?carried-distance

mode carried-distance given loot yields carried-distance: one

loot-state:
  ?loot shape Loot
  ?loot-state shape LootState
  ?loot:
    loot state: ?loot-state

mode loot-state given loot yields loot-state: one

ashen-key
  member of: Loot
cephorium-cache
  member of: Loot
hidden
  member of: LootState
acquired
  member of: LootState

ashen-key carried distance 1.0
cephorium-cache carried distance 2.0
ashen-key loot state acquired
cephorium-cache loot state hidden

bind keyboard LootItem down to acquire-loot

on acquire-loot ?loot
  when
    ?loot loot state ?state
  withdraw
    ?loot loot state ?state
  include
    ?loot loot state acquired

on carry-loot ?loot
  when
    ?loot carried distance ?distance
    ?loot loot state ?state
    ?state = acquired
  withdraw
    ?loot carried distance ?distance
  include
    ?loot carried distance ?distance + 1.0
