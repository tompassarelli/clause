F64
Meter

reading:
  ?meter shape Meter
  ?reading shape F64
  ?meter:
    reading: ?reading

mode reading given meter yields reading: one

meter
  member of: Meter
meter reading 25.0

on measure ?meter
  when
    ?meter reading ?value
  withdraw
    ?meter reading ?value
  include
    ?meter reading sqrt(?value)

on inspect ?meter
  when
    ?meter reading ?value
  withdraw
    ?meter reading ?value
  include
    ?meter reading ?value
