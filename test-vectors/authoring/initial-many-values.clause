Root
Item
F64

relation known
  reads {root: Root} known {value: Item}
  subject root
  mode given root yields value: many

relation count
  reads {root: Root} count {value: F64}
  subject root
  mode given root yields value: one

root
  shape: Root
first
  shape: Item
second
  shape: Item
root known first
root known second
root count 0.0

on inspect ?root
  when
    ?root count ?prior
    sum 1.0 given ?root where { ?root known ?item } as ?count
  withdraw
    ?root count ?prior
  include
    ?root count ?count
