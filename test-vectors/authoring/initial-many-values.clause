Root
Item
F64

known:
  ?root shape Root
  ?known shape Item
  ?root:
    known: ?known

mode known given root yields known: many

count:
  ?root shape Root
  ?count shape F64
  ?root:
    count: ?count

mode count given root yields count: one

root
  member of: Root
first
  member of: Item
second
  member of: Item
root known first
root known second
root count 0.0

on inspect ?root
  when
    ?root count ?prior
    sum 1.0 given ?root where { ?root known ?item } as ?count
  withdraw
    ?root count ?prior
  include
    ?root count ?count
