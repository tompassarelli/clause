Text
Bool
Item

status:
  ?item shape Item
  ?status shape Text
  ?item:
    status: ?status

mode status given item yields status: one

selected:
  ?item shape Item
  ?selected shape Bool
  ?item:
    selected: ?selected

mode selected given item yields selected: one

first
  member of: Item
second
  member of: Item

first status "waiting {世界} \"yes\""
first selected false
second status "finished"
second selected false

on select ?item
  when
    ?item status "waiting {世界} \"yes\""
    ?item selected ?prior
  withdraw
    ?item selected ?prior
  include
    ?item selected true

on spawn ?item
  when
    ?item status "finished"
  create
    ?new
      member of: Item
  include
    ?new status "waiting {世界} \"yes\""
    ?new selected false
