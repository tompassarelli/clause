Root
Item
Text
F64

known:
  ?root shape Root
  ?known shape Item
  ?root:
    known: ?known

mode known given root yields known: many
label:
  ?item shape Item
  ?label shape Text
  ?item:
    label: ?label

mode label given item yields label: one
count:
  ?root shape Root
  ?count shape F64
  ?root:
    count: ?count

mode count given root yields count: one

root
  member of: Root
first
  member of: Item
second
  member of: Item
root known first
root known second
first label "First"
second label "Second"
root count 0.0

on tick ?root
  when
    ?root count ?prior
  withdraw
    ?root count ?prior
  include
    ?root count ?prior + 1.0
