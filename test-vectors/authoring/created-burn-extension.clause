BurnEffect

burn-target:
  ?example:
    effect: BurnEffect
    burn-target: Actor
    ?effect:
      burn target: ?burn-target

mode burn-target given effect yields burn-target: one
effect-remaining:
  ?example:
    effect: BurnEffect
    effect-remaining: F64
    ?effect:
      effect remaining: ?effect-remaining

mode effect-remaining given effect yields effect-remaining: one
effect-damage:
  ?example:
    effect: BurnEffect
    effect-damage: F64
    ?effect:
      effect damage: ?effect-damage

mode effect-damage given effect yields effect-damage: one

bind scalar-input IgniteDuration to ignite-target

on ignite-target ?controller ?duration
  when
    ?controller chosen target ?target
  create
    ?effect
      member of: BurnEffect
  include
    ?effect burn target ?target
    ?effect effect remaining ?duration
    ?effect effect damage 7.0

on tick ?effect ?dt
  when
    ?effect burn target ?target
    ?effect effect remaining ?remaining
    ?effect effect damage ?damage
    ?remaining > 0.0
    ?dt clamped between 0.0 and ?remaining as ?elapsed
  withdraw
    ?effect effect remaining ?remaining
  include
    ?effect effect remaining ?remaining - ?elapsed
  accumulate
    ?target vitality 0.0 - ?damage * ?elapsed

on tick ?effect ?dt
  when
    ?effect burn target ?target
    ?effect effect remaining ?remaining
    ?effect effect damage ?damage
    ?remaining <= 0.0
  withdraw
    ?effect burn target ?target
    ?effect effect remaining ?remaining
    ?effect effect damage ?damage
