F64
Bool
Player

Vec3:
  x: F64
  y: F64
  z: F64

velocity:
  ?player shape Player
  ?velocity shape Vec3
  ?player:
    velocity: ?velocity

mode velocity given player yields velocity: one

empowered:
  ?player shape Player
  ?empowered shape Bool
  ?player:
    empowered: ?empowered

mode empowered given player yields empowered: one

player-1
  member of: Player
player-1
  velocity:
    x: 0.0
    y: 0.0
    z: 0.0
player-1 empowered true

bind keyboard KeyQ down to planar-burst

on planar-burst ?player
  when
    ?player
      velocity:
        x: ?velocity-x
        y: ?velocity-y
        z: ?velocity-z
    ?player empowered ?was-empowered
    ?was-empowered = true
  withdraw
    ?player
      velocity:
        x: ?velocity-x
        y: ?velocity-y
        z: ?velocity-z
  include
    ?player
      velocity:
        x: ?velocity-x + 3.0
        y: ?velocity-y
        z: ?velocity-z - 2.0
