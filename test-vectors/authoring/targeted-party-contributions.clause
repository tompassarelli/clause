F64
Bool
Controller
Unit
Target
Encounter
EncounterState

Vec3:
  x: F64
  y: F64
  z: F64

selected:
  ?unit shape Unit
  ?selected shape Bool
  ?unit:
    selected: ?selected

mode selected given unit yields selected: one

combat-position:
  ?target shape Target
  ?combat-position shape Vec3
  ?target:
    combat position: ?combat-position

mode combat-position given target yields combat-position: one

vitality:
  ?target shape Target
  ?vitality shape F64
  ?target:
    vitality: ?vitality

mode vitality given target yields vitality: one

hostile:
  ?target shape Target
  ?hostile shape Bool
  ?target:
    hostile: ?hostile

mode hostile given target yields hostile: one

chosen-target:
  ?controller shape Controller
  ?chosen-target shape Target
  ?controller:
    chosen target: ?chosen-target

mode chosen-target given controller yields chosen-target: one

attack-damage:
  ?unit shape Unit
  ?attack-damage shape F64
  ?unit:
    attack damage: ?attack-damage

mode attack-damage given unit yields attack-damage: one

attack-range:
  ?unit shape Unit
  ?attack-range shape F64
  ?unit:
    attack range: ?attack-range

mode attack-range given unit yields attack-range: one

action-cooldown:
  ?unit shape Unit
  ?action-cooldown shape F64
  ?unit:
    action cooldown: ?action-cooldown

mode action-cooldown given unit yields action-cooldown: one

encounter-state:
  ?encounter shape Encounter
  ?encounter-state shape EncounterState
  ?encounter:
    encounter state: ?encounter-state

mode encounter-state given encounter yields encounter-state: one

player
  member of: Controller
first
  member of: Unit
  member of: Target
second
  member of: Unit
  member of: Target
cinder
  member of: Target
encounter
  member of: Encounter

active
  member of: EncounterState

player chosen target first
encounter encounter state active

first selected true
first
  combat position:
    x: -1.0
    y: 0.0
    z: 0.0
first vitality 100.0
first hostile false
first attack damage 10.0
first attack range 5.0
first action cooldown 0.0

second selected true
second
  combat position:
    x: 1.0
    y: 0.0
    z: 0.0
second vitality 100.0
second hostile false
second attack damage 10.0
second attack range 5.0
second action cooldown 0.0

cinder
  combat position:
    x: 0.0
    y: 0.0
    z: 2.0
cinder vitality 100.0
cinder hostile true

bind referent-input Target as Target to choose-target
bind keyboard Attack down to attack

on choose-target ?controller ?picked
  when
    ?controller chosen target ?prior
    ?picked hostile ?hostile
  withdraw
    ?controller chosen target ?prior
  include
    ?controller chosen target ?picked

on attack ?unit
  when
    encounter encounter state active
    ?unit selected true
    ?unit
      combat position:
        x: ?unit-x
        y: ?unit-y
        z: ?unit-z
    ?unit attack damage ?damage
    ?unit attack range ?range
    ?unit action cooldown ?cooldown
    player chosen target ?target
    ?target
      combat position:
        x: ?target-x
        y: ?target-y
        z: ?target-z
    ?target vitality ?health
    ?target hostile true
    ?cooldown <= 0.0
    (?target-x - ?unit-x) * (?target-x - ?unit-x) + (?target-z - ?unit-z) * (?target-z - ?unit-z) <= ?range * ?range
  withdraw
    ?unit action cooldown ?cooldown
  include
    ?unit action cooldown 1.0
  accumulate
    ?target vitality 0.0 - ?damage
