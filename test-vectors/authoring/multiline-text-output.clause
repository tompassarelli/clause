Document
Text

output:
  ?document shape Document
  ?output shape Text
  ?document:
    output: ?output

mode output given document yields output: one

document-main output """
  initial
  """

on render ?document
  when
    ?document output ?previous
  withdraw
    ?document output ?previous
  include
    ?document output """
      {
        title = "North";
        outputs = { nixpkgs, ... }: "Clause emits readable text";
