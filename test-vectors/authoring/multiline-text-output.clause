Document
Text

relation output
  reads {document: Document} output {value: Text}
  subject document
  mode given document yields value: one

document-main output """
  initial
  """

on render ?document
  when
    ?document output ?previous
  withdraw
    ?document output ?previous
  include
    ?document output """
      {
        title = "North";
        outputs = { nixpkgs, ... }: "Clause emits readable text";
      }
      """
