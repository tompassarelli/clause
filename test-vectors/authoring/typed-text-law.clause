Text
Root
Item

echo:
  (shape: Text):
    ?input ?output
  echo ?input as ?output

mode echo given input yields output: maybe

law echo-text
  if
    ?input = ?input
  then
    echo ?input as ?input
derive echo-text

label:
  ?item shape Item
  ?label shape Text
  ?item:
    label: ?label

mode label given item yields label: one
known:
  ?root shape Root
  ?known shape Item
  ?root:
    known: ?known

mode known given root yields known: many
output:
  ?root shape Root
  ?output shape Text
  ?root:
    output: ?output

mode output given root yields output: one

root
  member of: Root
root output ""

on record ?root ?input
  when
    echo ?input as ?value
    ?root output ?prior
  create
    ?item
      member of: Item
  withdraw
    ?root output ?prior
  include
    ?root output ?value
    ?root known ?item
    ?item label ?value
