Text
Root
Item

relation echo
  reads echo {input: Text} as {output: Text}
  mode given input yields output: maybe

law echo-text
  if
    ?input = ?input
  then
    echo ?input as ?input
derive echo-text

relation label
  reads {item: Item} label {value: Text}
  subject item
  mode given item yields value: one
relation known
  reads {root: Root} known {value: Item}
  subject root
  mode given root yields value: many
relation output
  reads {root: Root} output {value: Text}
  subject root
  mode given root yields value: one

root
  member of: Root
root output ""

on record ?root ?input
  when
    echo ?input as ?value
    ?root output ?prior
  create
    ?item
      member of: Item
  withdraw
    ?root output ?prior
  include
    ?root output ?value
    ?root known ?item
    ?item label ?value
