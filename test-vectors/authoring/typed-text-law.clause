Text
Root
Item

echo:
  ?example:
    input: Text
    output: Text
    echo ?input as ?output

mode echo given input yields output: maybe

law echo-text
  if
    ?input = ?input
  then
    echo ?input as ?input
derive echo-text

label:
  ?example:
    item: Item
    label: Text
    ?item:
      label: ?label

mode label given item yields label: one
known:
  ?example:
    root: Root
    known: Item
    ?root:
      known: ?known

mode known given root yields known: many
output:
  ?example:
    root: Root
    output: Text
    ?root:
      output: ?output

mode output given root yields output: one

root
  member of: Root
root output ""

on record ?root ?input
  when
    echo ?input as ?value
    ?root output ?prior
  create
    ?item
      member of: Item
  withdraw
    ?root output ?prior
  include
    ?root output ?value
    ?root known ?item
    ?item label ?value
