F64
Meter

reading:
  ?example:
    meter: Meter
    reading: F64
    ?meter:
      reading: ?reading

mode reading given meter yields reading: one

meter
  member of: Meter
meter reading 0.0

on measure ?meter
  when
    ?meter reading ?value
  withdraw
    ?meter reading ?value
  include
    ?meter reading if(?value > 0.0, 10.0 / ?value, 0.0)

on inspect ?meter
  when
    ?meter reading ?value
  withdraw
    ?meter reading ?value
  include
    ?meter reading ?value
