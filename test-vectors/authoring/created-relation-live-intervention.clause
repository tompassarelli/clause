Actor
BurnEffect

vitality:
  ?actor shape Actor
  ?vitality shape F64
  ?actor:
    vitality: ?vitality

mode vitality given actor yields vitality: one
selected:
  ?actor shape Actor
  ?selected shape Bool
  ?actor:
    selected: ?selected

mode selected given actor yields selected: one
burn-target:
  ?effect shape BurnEffect
  ?burn-target shape Actor
  ?effect:
    burn target: ?burn-target

mode burn-target given effect yields burn-target: one
effect-remaining:
  ?effect shape BurnEffect
  ?effect-remaining shape F64
  ?effect:
    effect remaining: ?effect-remaining

mode effect-remaining given effect yields effect-remaining: one

unit-a
  member of: Actor
unit-b
  member of: Actor

unit-a vitality 100.0
unit-a selected true
unit-b vitality 100.0
unit-b selected true

bind keyboard Attack down to attack
bind scalar-input IgniteDuration to ignite

on attack ?actor
  when
    ?actor selected true
    ?actor vitality ?health
  accumulate
    ?actor vitality 0.0 - 10.0

on ignite ?actor ?duration
  when
    ?actor selected true
  create
    ?effect
      member of: BurnEffect
  include
    ?effect burn target ?actor
    ?effect effect remaining ?duration
