F64
Bool
Item

Point:
  ?example:
    x: F64
    y: F64

limited:
  ?example:
    amount: F64
    minimum: F64
    maximum: F64
    result: F64
    ?amount:
      limited between ?minimum and ?maximum as: ?result

mode limited given amount minimum maximum yields result: maybe

