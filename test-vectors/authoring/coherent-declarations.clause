position
  domain: Item
  range: Point
  cardinality: one
destination
  domain: Item
  range: Point
  cardinality: one
charge
  domain: Item
  range: F64
  cardinality: one

first
  position:
    x: 2.0
    y: 3.0
  destination:
    x: 8.0
    y: 9.0
  charge: 9.0
second
  position:
    x: 4.0
    y: 5.0
  destination:
    x: 0.0
    y: 0.0
  charge: -4.0

on settle ?item
  when
    ?item:
      position:
        x: ?x
        y: ?y
      destination: ?destination
      charge: ?charge
    (shape: F64):
      ?charge ?limited
    (?charge + 3.0) limited between 0.0 and 10.0 as ?limited
  withdraw
    ?item:
      destination: ?destination
      charge: ?charge
  include
    ?item:
      destination:
        x: ?x
        y: ?y
      charge: ?limited
