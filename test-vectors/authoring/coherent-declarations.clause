derive above

position
  domain: Item
  range: Point
  cardinality: one
destination
  domain: Item
  range: Point
  cardinality: one
charge
  domain: Item
  range: F64
  cardinality: one

first position Point { x: 2.0, y: 3.0 }
first destination Point { x: 8.0, y: 9.0 }
first charge 9.0
second position Point { x: 4.0, y: 5.0 }
second destination Point { x: 0.0, y: 0.0 }
second charge -4.0

on settle ?item
  when
    ?item:
      position: ?position
      destination: ?destination
      charge: ?charge
    (?charge + 3.0) limited between 0.0 and 10.0 as ?limited
  withdraw
    ?item:
      destination: ?destination
      charge: ?charge
  include
    ?item:
      destination: ?position
      charge: ?limited
