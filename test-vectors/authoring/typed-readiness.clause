F64
Bool
Text
Device

readiness:
  ?enabled shape Bool
  ?charge shape F64
  ?message shape Text
  ?enabled enabled with charge ?charge reports ?message

mode readiness given enabled charge yields message: maybe
enabled:
  ?device shape Device
  ?enabled shape Bool
  ?device:
    enabled: ?enabled

mode enabled given device yields enabled: one
charge:
  ?device shape Device
  ?charge shape F64
  ?device:
    charge: ?charge

mode charge given device yields charge: one
message:
  ?device shape Device
  ?message shape Text
  ?device:
    message: ?message

mode message given device yields message: one

law disabled
  if
    ?enabled = false
  then
    ?enabled enabled with charge ?charge reports "Disabled"
law empty
  if
    ?enabled = true
    ?charge <= 0.0
  then
    ?enabled enabled with charge ?charge reports "Empty"
law ready
  if
    ?enabled = true
    ?charge > 0.0
  then
    ?enabled enabled with charge ?charge reports "Ready"
derive disabled
derive empty
derive ready

device
  member of: Device
device enabled true
device charge 1.0
device message "Unchecked"

on inspect ?device
  when
    ?device enabled ?enabled
    ?device charge ?charge
    ?device message ?prior
    ?enabled enabled with charge ?charge reports ?message
  withdraw
    ?device message ?prior
  include
    ?device message ?message

on use ?device
  when
    ?device enabled ?enabled
    ?device charge ?charge
    ?enabled enabled with charge ?charge reports ?message
    ?message = "Ready"
  withdraw
    ?device charge ?charge
  include
    ?device charge ?charge - 1.0
