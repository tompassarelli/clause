F64
Loot

Vec3:
  ?example:
    x: F64
    y: F64
    z: F64

loot-position:
  ?example:
    loot: Loot
    loot-position: Vec3
    ?loot:
      loot position: ?loot-position

mode loot-position given loot yields loot-position: one

loot-origin-position:
  ?example:
    loot: Loot
    loot-origin-position: Vec3
    ?loot:
      loot origin position: ?loot-origin-position

mode loot-origin-position given loot yields loot-origin-position: one

ashen-key
  member of: Loot
cephorium-cache
  member of: Loot

ashen-key loot position Vec3 { x: 1.0, y: 0.0, z: 2.0 }
ashen-key loot origin position Vec3 { x: 3.0, y: 0.0, z: 4.0 }
cephorium-cache loot position Vec3 { x: 5.0, y: 0.0, z: 6.0 }
cephorium-cache loot origin position Vec3 { x: 7.0, y: 0.0, z: 8.0 }

bind keyboard KeyR down to reset-loot-position

on reset-loot-position ?loot
  when
    ?loot loot position ?position
    ?loot loot origin position ?origin
  withdraw
    ?loot loot position ?position
  include
    ?loot loot position ?origin
